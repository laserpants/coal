module Main {

import Data.Set.Set
import Data.Set.empty
import Data.Set.insert
import Data.Set.delete
import Data.Set.is_member
import Data.Ord.Eq
import Data.Ord.Lt
import Data.Ord.Gt

data List(*)
  = Main.Nil
  | Main.Cons(*, List(*))

data Pair(*, *) = Main.Pair(*, *)

data Shape
  = Main.ShapeI
  | Main.ShapeO
  | Main.ShapeT
  | Main.ShapeS
  | Main.ShapeZ
  | Main.ShapeJ
  | Main.ShapeL

data Rotation
  = Main.R0
  | Main.R90
  | Main.R180
  | Main.R270

Main.spin(r : Rotation) =
  case<Rotation>(r : Rotation) {
    | ( Main.R0   : Rotation ) => Main.R90  : Rotation
    | ( Main.R90  : Rotation ) => Main.R180 : Rotation
    | ( Main.R180 : Rotation ) => Main.R270 : Rotation
    | ( Main.R270 : Rotation ) => Main.R0   : Rotation
  }

Main.shape_from_int(n : int32) =
  if ([== int32](n : int32, 0)) then Main.ShapeI : Shape
  else if ([== int32](n : int32, 1)) then Main.ShapeO : Shape
  else if ([== int32](n : int32, 2)) then Main.ShapeT : Shape
  else if ([== int32](n : int32, 3)) then Main.ShapeS : Shape
  else if ([== int32](n : int32, 4)) then Main.ShapeZ : Shape
  else if ([== int32](n : int32, 5)) then Main.ShapeJ : Shape
  else Main.ShapeL : Shape

Main.rotation_from_int(n : int32) =
  if ([== int32](n : int32, 0)) then Main.R0   : Rotation
  else if ([== int32](n : int32, 1)) then Main.R90  : Rotation
  else if ([== int32](n : int32, 2)) then Main.R180 : Rotation
  else Main.R270 : Rotation

data Event
  = Main.KeyLeft
  | Main.KeyRight
  | Main.KeyDown
  | Main.KeyUp
  | Main.KeySpace
  | Main.KeyEsc
  | Main.Tick
  | Main.NoOp

Main.intial_block =
  { shape = Main.ShapeI : Shape
  | rotation = Main.R0 : Rotation
  | pos_x = 0 
  | pos_y = 0 
  | {}
  }

Main.random_block(_ : *) =
  let
    shape_n    : int32 = @<int32>(random_shape    : unit/int32, ())
    ;
    rotation_n : int32 = @<int32>(random_rotation : unit/int32, ())
  in
  let
    shape    : Shape    = @<Shape>   (Main.shape_from_int    : int32/Shape,    shape_n    : int32)
    ;
    rotation : Rotation = @<Rotation>(Main.rotation_from_int : int32/Rotation, rotation_n : int32)
  in
    { shape    = shape    : Shape
    | rotation = rotation : Rotation
    | pos_x    = 0
    | pos_y    = 0
    | {}
    }

data State 
  = Main.State
    ( { board : Set(Pair(int32, int32))
      | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }
      | {} }
    )

Main.initial_game_state =
  @<State>
    ( Main.State : */State
    , { board = Main.board_empty : Set(Pair(int32, int32))
      | current_block = Main.intial_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }
      | {} 
      }
    )

Main.fold_list
  ( f : */*/*         // a/b/b
  , acc : *           // b
  , xs : List(*)      // [a]
                      // b
  ) =
    case<*>(xs : List(*)) {
      | ( Main.Cons : */List(*)/List(*)
        , hd : *                 // a
        , tl : List(*)           // [a]
        ) => 
        @<*>                     // b
          ( Main.fold_list : (*/*/*)/*/List(*)/*
          , f : */*/*
          , @<*>                 // b
              ( f : */*/*        // a/b/b
              , hd : *           // a
              , acc : *          // b
              )
          , tl : List(*)
          )
      | ( Main.Nil : List(*)
        ) => 
        acc : *
    }

Main.any(f : */bool, xs : List(*)) =
  @<bool>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(x : *, acc : bool) =>
        [||]
          ( acc : bool
          , @<bool>
              ( f : */bool
              , x : *
              )
          )
    , false 
    , xs : List(*)
    )

// ---------------------------------------------------------------------------
// Pair comparison (lexicographic: y first, then x)
// ---------------------------------------------------------------------------

Main.pair_compare(a : Pair(int32, int32), b : Pair(int32, int32)) =
  case<Ord>(a : Pair(int32, int32)) {
    | ( Main.Pair : int32/int32/Pair(int32, int32)
      , ax : int32
      , ay : int32
      ) =>
        case<Ord>(b : Pair(int32, int32)) {
          | ( Main.Pair : int32/int32/Pair(int32, int32)
            , bx : int32
            , by : int32
            ) =>
              if ([== int32](ay : int32, by : int32))
                then
                  if ([== int32](ax : int32, bx : int32)) then Data.Ord.Eq : Ord
                  else if ([< int32](ax : int32, bx : int32)) then Data.Ord.Lt : Ord
                  else Data.Ord.Gt : Ord
                else
                  if ([< int32](ay : int32, by : int32)) then Data.Ord.Lt : Ord
                  else Data.Ord.Gt : Ord
        }
  }

// ---------------------------------------------------------------------------
// Board API  (board = Set(Pair(int32, int32)))
// ---------------------------------------------------------------------------

Main.board_empty =
  @<Set(Pair(int32, int32))>
    ( Data.Set.empty : unit/Set(Pair(int32, int32))
    , ()
    )

Main.board_member(x : int32, y : int32, board : Set(Pair(int32, int32))) =
  @<bool>
    ( Data.Set.is_member : (Pair(int32, int32)/Pair(int32, int32)/Ord)/Pair(int32, int32)/Set(Pair(int32, int32))/bool
    , Main.pair_compare : Pair(int32, int32)/Pair(int32, int32)/Ord
    , @<Pair(int32, int32)>
        ( Main.Pair : int32/int32/Pair(int32, int32)
        , x : int32
        , y : int32
        )
    , board : Set(Pair(int32, int32))
    )

Main.board_insert(cell : Pair(int32, int32), board : Set(Pair(int32, int32))) =
  @<Set(Pair(int32, int32))>
    ( Data.Set.insert : (Pair(int32, int32)/Pair(int32, int32)/Ord)/Pair(int32, int32)/Set(Pair(int32, int32))/Set(Pair(int32, int32))
    , Main.pair_compare : Pair(int32, int32)/Pair(int32, int32)/Ord
    , cell : Pair(int32, int32)
    , board : Set(Pair(int32, int32))
    )

Main.board_insert_cells
  ( cells : List(Pair(int32, int32))
  , board : Set(Pair(int32, int32))
  ) =
    @<Set(Pair(int32, int32))>
      ( Main.fold_list : (*/*/*)/*/List(*)/*
      , fn(cell : Pair(int32, int32), acc : Set(Pair(int32, int32))) =>
          @<Set(Pair(int32, int32))>
            ( Main.board_insert : Pair(int32, int32)/Set(Pair(int32, int32))/Set(Pair(int32, int32))
            , cell : Pair(int32, int32)
            , acc : Set(Pair(int32, int32))
            )
      , board : Set(Pair(int32, int32))
      , cells : List(Pair(int32, int32))
      )

// List of x-coordinates [0, 1, 2, ..., 9] for iterating board columns.
Main.row_x_coords =
  @<List(int32)>
    ( Main.Cons : int32/List(int32)/List(int32)
    , 0
    , @<List(int32)>
        ( Main.Cons : int32/List(int32)/List(int32)
        , 1
        , @<List(int32)>
            ( Main.Cons : int32/List(int32)/List(int32)
            , 2
            , @<List(int32)>
                ( Main.Cons : int32/List(int32)/List(int32)
                , 3
                , @<List(int32)>
                    ( Main.Cons : int32/List(int32)/List(int32)
                    , 4
                    , @<List(int32)>
                        ( Main.Cons : int32/List(int32)/List(int32)
                        , 5
                        , @<List(int32)>
                            ( Main.Cons : int32/List(int32)/List(int32)
                            , 6
                            , @<List(int32)>
                                ( Main.Cons : int32/List(int32)/List(int32)
                                , 7
                                , @<List(int32)>
                                    ( Main.Cons : int32/List(int32)/List(int32)
                                    , 8
                                    , @<List(int32)>
                                        ( Main.Cons : int32/List(int32)/List(int32)
                                        , 9
                                        , Main.Nil : List(int32)
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )

// Count filled cells in row y by folding over all x-coordinates.
Main.board_count_x(y : int32, board : Set(Pair(int32, int32))) =
  @<int32>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(x_val : int32, acc : int32) =>
        if ( @<bool>
               ( Main.board_member : int32/int32/Set(Pair(int32, int32))/bool
               , x_val : int32
               , y : int32
               , board : Set(Pair(int32, int32))
               )
           )
          then [+ int32](1, acc : int32)
          else acc : int32
    , 0
    , Main.row_x_coords : List(int32)
    )

Main.board_count_in_row(y : int32, board : Set(Pair(int32, int32))) =
  @<int32>
    ( Main.board_count_x : int32/Set(Pair(int32, int32))/int32
    , y : int32
    , board : Set(Pair(int32, int32))
    )

// List of y-coordinates [0, 1, 2, ..., 19] for iterating board rows.
Main.row_y_coords =
  @<List(int32)>
    ( Main.Cons : int32/List(int32)/List(int32)
    , 0
    , @<List(int32)>
        ( Main.Cons : int32/List(int32)/List(int32)
        , 1
        , @<List(int32)>
            ( Main.Cons : int32/List(int32)/List(int32)
            , 2
            , @<List(int32)>
                ( Main.Cons : int32/List(int32)/List(int32)
                , 3
                , @<List(int32)>
                    ( Main.Cons : int32/List(int32)/List(int32)
                    , 4
                    , @<List(int32)>
                        ( Main.Cons : int32/List(int32)/List(int32)
                        , 5
                        , @<List(int32)>
                            ( Main.Cons : int32/List(int32)/List(int32)
                            , 6
                            , @<List(int32)>
                                ( Main.Cons : int32/List(int32)/List(int32)
                                , 7
                                , @<List(int32)>
                                    ( Main.Cons : int32/List(int32)/List(int32)
                                    , 8
                                    , @<List(int32)>
                                        ( Main.Cons : int32/List(int32)/List(int32)
                                        , 9
                                        , @<List(int32)>
                                            ( Main.Cons : int32/List(int32)/List(int32)
                                            , 10
                                            , @<List(int32)>
                                                ( Main.Cons : int32/List(int32)/List(int32)
                                                , 11
                                                , @<List(int32)>
                                                    ( Main.Cons : int32/List(int32)/List(int32)
                                                    , 12
                                                    , @<List(int32)>
                                                        ( Main.Cons : int32/List(int32)/List(int32)
                                                        , 13
                                                        , @<List(int32)>
                                                            ( Main.Cons : int32/List(int32)/List(int32)
                                                            , 14
                                                            , @<List(int32)>
                                                                ( Main.Cons : int32/List(int32)/List(int32)
                                                                , 15
                                                                , @<List(int32)>
                                                                    ( Main.Cons : int32/List(int32)/List(int32)
                                                                    , 16
                                                                    , @<List(int32)>
                                                                        ( Main.Cons : int32/List(int32)/List(int32)
                                                                        , 17
                                                                        , @<List(int32)>
                                                                            ( Main.Cons : int32/List(int32)/List(int32)
                                                                            , 18
                                                                            , @<List(int32)>
                                                                                ( Main.Cons : int32/List(int32)/List(int32)
                                                                                , 19
                                                                                , Main.Nil : List(int32)
                                                                                )
                                                                            )
                                                                        )
                                                                    )
                                                                )
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )

// Delete all cells (x,y) for x in 0..9 by folding over row_x_coords.
Main.board_remove_row(y : int32, board : Set(Pair(int32, int32))) =
  @<Set(Pair(int32, int32))>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(x_val : int32, acc : Set(Pair(int32, int32))) =>
        @<Set(Pair(int32, int32))>
          ( Data.Set.delete : (Pair(int32, int32)/Pair(int32, int32)/Ord)/Pair(int32, int32)/Set(Pair(int32, int32))/Set(Pair(int32, int32))
          , Main.pair_compare : Pair(int32, int32)/Pair(int32, int32)/Ord
          , @<Pair(int32, int32)>
              ( Main.Pair : int32/int32/Pair(int32, int32)
              , x_val : int32
              , y : int32
              )
          , acc : Set(Pair(int32, int32))
          )
    , board : Set(Pair(int32, int32))
    , Main.row_x_coords : List(int32)
    )

// Shift cells in row y down by 1, folding over all x-coordinates.
Main.board_shift_row_x(y : int32, board : Set(Pair(int32, int32))) =
  @<Set(Pair(int32, int32))>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(x_val : int32, acc : Set(Pair(int32, int32))) =>
        if ( @<bool>
               ( Main.board_member : int32/int32/Set(Pair(int32, int32))/bool
               , x_val : int32
               , y : int32
               , acc : Set(Pair(int32, int32))
               )
           )
          then
            let
              board_del : Set(Pair(int32, int32)) =
                @<Set(Pair(int32, int32))>
                  ( Data.Set.delete : (Pair(int32, int32)/Pair(int32, int32)/Ord)/Pair(int32, int32)/Set(Pair(int32, int32))/Set(Pair(int32, int32))
                  , Main.pair_compare : Pair(int32, int32)/Pair(int32, int32)/Ord
                  , @<Pair(int32, int32)>
                      ( Main.Pair : int32/int32/Pair(int32, int32)
                      , x_val : int32
                      , y : int32
                      )
                  , acc : Set(Pair(int32, int32))
                  )
            in
              @<Set(Pair(int32, int32))>
                ( Data.Set.insert : (Pair(int32, int32)/Pair(int32, int32)/Ord)/Pair(int32, int32)/Set(Pair(int32, int32))/Set(Pair(int32, int32))
                , Main.pair_compare : Pair(int32, int32)/Pair(int32, int32)/Ord
                , @<Pair(int32, int32)>
                    ( Main.Pair : int32/int32/Pair(int32, int32)
                    , x_val : int32
                    , [+ int32](y : int32, 1)
                    )
                , board_del : Set(Pair(int32, int32))
                )
          else
            acc : Set(Pair(int32, int32))
    , board : Set(Pair(int32, int32))
    , Main.row_x_coords : List(int32)
    )

// Shift rows start_y down to 0 by folding over row_y_coords (skip rows > start_y).
Main.board_shift_rows_above_from(start_y : int32, board : Set(Pair(int32, int32))) =
  @<Set(Pair(int32, int32))>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(y_val : int32, acc : Set(Pair(int32, int32))) =>
        if ([<= int32](y_val : int32, start_y : int32))
          then
            @<Set(Pair(int32, int32))>
              ( Main.board_shift_row_x : int32/Set(Pair(int32, int32))/Set(Pair(int32, int32))
              , y_val : int32
              , acc : Set(Pair(int32, int32))
              )
          else
            acc : Set(Pair(int32, int32))
    , board : Set(Pair(int32, int32))
    , Main.row_y_coords : List(int32)
    )

Main.board_shift_rows_above(cleared_y : int32, board : Set(Pair(int32, int32))) =
  @<Set(Pair(int32, int32))>
    ( Main.board_shift_rows_above_from : int32/Set(Pair(int32, int32))/Set(Pair(int32, int32))
    , [- int32](cleared_y : int32, 1)
    , board : Set(Pair(int32, int32))
    )

// Find the topmost (highest y) full row, or -1 if none.
Main.find_full_row(board : Set(Pair(int32, int32))) =
  @<int32>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(y_val : int32, acc : int32) =>
        if ([< int32](acc : int32, 0))
          then
            if ([== int32](
                  @<int32>
                    ( Main.board_count_in_row : int32/Set(Pair(int32, int32))/int32
                    , y_val : int32
                    , board : Set(Pair(int32, int32))
                    )
                  , 10))
              then y_val : int32
              else acc : int32
          else
            acc : int32
    , -1
    , @<List(int32)>
        ( Main.reverse_list : List(*)/List(*)
        , Main.row_y_coords : List(int32)
        )
    )

// Clear one full row if any, shifting rows above down.
Main.clear_one_full_row(board : Set(Pair(int32, int32))) =
  let
    full_y : int32 =
      @<int32>
        ( Main.find_full_row : Set(Pair(int32, int32))/int32
        , board : Set(Pair(int32, int32))
        )
  in
    if ([>= int32](full_y : int32, 0))
      then
        let
          board1 : Set(Pair(int32, int32)) =
            @<Set(Pair(int32, int32))>
              ( Main.board_remove_row : int32/Set(Pair(int32, int32))/Set(Pair(int32, int32))
              , full_y : int32
              , board : Set(Pair(int32, int32))
              )
        in
          @<Set(Pair(int32, int32))>
            ( Main.board_shift_rows_above : int32/Set(Pair(int32, int32))/Set(Pair(int32, int32))
            , full_y : int32
            , board1 : Set(Pair(int32, int32))
            )
      else
        board : Set(Pair(int32, int32))

// Clear all full rows by repeatedly clearing one full row (bounded by board height).
Main.board_clear_full_rows(board : Set(Pair(int32, int32))) =
  @<Set(Pair(int32, int32))>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(_ : int32, acc : Set(Pair(int32, int32))) =>
        @<Set(Pair(int32, int32))>
          ( Main.clear_one_full_row : Set(Pair(int32, int32))/Set(Pair(int32, int32))
          , acc : Set(Pair(int32, int32))
          )
    , board : Set(Pair(int32, int32))
    , Main.row_y_coords : List(int32)
    )

// Collect filled cells in a single row y as a List, folding over x-coordinates.
Main.board_row_to_list(y : int32, board : Set(Pair(int32, int32))) =
  @<List(Pair(int32, int32))>
    ( Main.reverse_list : List(*)/List(*)
    , @<List(Pair(int32, int32))>
        ( Main.fold_list : (*/*/*)/*/List(*)/*
        , fn(x_val : int32, acc : List(Pair(int32, int32))) =>
            if ( @<bool>
                   ( Main.board_member : int32/int32/Set(Pair(int32, int32))/bool
                   , x_val : int32
                   , y : int32
                   , board : Set(Pair(int32, int32))
                   )
               )
              then
                @<List(Pair(int32, int32))>
                  ( Main.Cons : Pair(int32, int32)/List(Pair(int32, int32))/List(Pair(int32, int32))
                  , @<Pair(int32, int32)>
                      ( Main.Pair : int32/int32/Pair(int32, int32)
                      , x_val : int32
                      , y : int32
                      )
                  , acc : List(Pair(int32, int32))
                  )
              else
                acc : List(Pair(int32, int32))
        , Main.Nil : List(Pair(int32, int32))
        , Main.row_x_coords : List(int32)
        )
    )

// Convert the Set board to a List for the C renderer by folding over rows
// and concatenating each row's filled cells.
Main.board_to_list(board : Set(Pair(int32, int32))) =
  @<List(Pair(int32, int32))>
    ( Main.reverse_list : List(*)/List(*)
    , @<List(Pair(int32, int32))>
        ( Main.fold_list : (*/*/*)/*/List(*)/*
        , fn(y_val : int32, acc : List(Pair(int32, int32))) =>
            @<List(Pair(int32, int32))>
              ( Main.fold_list : (*/*/*)/*/List(*)/*
              , fn(cell : Pair(int32, int32), inner_acc : List(Pair(int32, int32))) =>
                  @<List(Pair(int32, int32))>
                    ( Main.Cons : Pair(int32, int32)/List(Pair(int32, int32))/List(Pair(int32, int32))
                    , cell : Pair(int32, int32)
                    , inner_acc : List(Pair(int32, int32))
                    )
              , acc : List(Pair(int32, int32))
              , @<List(Pair(int32, int32))>
                  ( Main.board_row_to_list : int32/Set(Pair(int32, int32))/List(Pair(int32, int32))
                  , y_val : int32
                  , board : Set(Pair(int32, int32))
                  )
              )
        , Main.Nil : List(Pair(int32, int32))
        , Main.row_y_coords : List(int32)
        )
    )

// ---------------------------------------------------------------------------

Main.board_cell_is_set(x : int32, y : int32, state : State) =
  case<bool>(state : State) {
    | ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State 
      , info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }
      ) =>
        @<bool>
          ( Main.board_member : int32/int32/Set(Pair(int32, int32))/bool
          , x : int32
          , y : int32
          , get?_board<Set(Pair(int32, int32))>(info : { board : Set(Pair(int32, int32)) | * })
          )
  }

// ---------------------------------------------------------------------------
// Collision detection
// ---------------------------------------------------------------------------

Main.cell_collides(cell : Pair(int32, int32), state : State) =
  case<bool>(cell : Pair(int32, int32)) {
    | ( Main.Pair : int32/int32/Pair(int32, int32)
      , x : int32
      , y : int32
      ) =>
        [||]
          ( [||]
              ( [< int32](x : int32, 0)
              , [>= int32](x : int32, 10)
              )
          , [||]
              ( [>= int32](y : int32, 20)
              , @<bool>
                  ( Main.board_cell_is_set : int32/int32/State/bool
                  , x : int32
                  , y : int32
                  , state : State
                  )
              )
          )
  }

Main.cells_collide(cells : List(Pair(int32, int32)), state : State) =
  @<bool>
    ( Main.any : (*/bool)/List(*)/bool
    , fn(cell : Pair(int32, int32)) =>
        @<bool>
          ( Main.cell_collides : Pair(int32, int32)/State/bool
          , cell : Pair(int32, int32)
          , state : State
          )
    , cells : List(Pair(int32, int32))
    )

// ---------------------------------------------------------------------------

Main.to_cells
  ( cell_1 : Pair(int32, int32)
  , cell_2 : Pair(int32, int32)
  , cell_3 : Pair(int32, int32)
  , cell_4 : Pair(int32, int32)
  ) =
    @<List(Pair(int32, int32))>
      ( Main.Cons : Pair(int32, int32)/List(Pair(int32, int32))/List(Pair(int32, int32))
      , cell_1 : Pair(int32, int32)
      , @<List(Pair(int32, int32))>
          ( Main.Cons : Pair(int32, int32)/List(Pair(int32, int32))/List(Pair(int32, int32))
          , cell_2 : Pair(int32, int32)
          , @<List(Pair(int32, int32))>
              ( Main.Cons : Pair(int32, int32)/List(Pair(int32, int32))/List(Pair(int32, int32))
              , cell_3 : Pair(int32, int32)
              , @<List(Pair(int32, int32))>
                  ( Main.Cons : Pair(int32, int32)/List(Pair(int32, int32))/List(Pair(int32, int32))
                  , cell_4 : Pair(int32, int32)
                  , Main.Nil : List(Pair(int32, int32))
                  )
              )
          )
      )

Main.translate_cell(d_x : int32, d_y : int32, cell : Pair(int32, int32)) =
  case<Pair(int32, int32)>(cell : Pair(int32, int32)) {
    | ( Main.Pair : int32/int32/Pair(int32, int32)
      , x : int32
      , y : int32
      ) => 
        @<Pair(int32, int32)>
          ( Main.Pair : int32/int32/Pair(int32, int32)
          , [+ int32](x : int32, d_x : int32)
          , [+ int32](y : int32, d_y : int32)
          )
  }

// Reverse a list using fold_list (left fold prepending elements).
Main.reverse_list(xs : List(*)) =
  @<List(*)>
    ( Main.fold_list : (*/*/*)/*/List(*)/*
    , fn(x : *, acc : List(*)) =>
        @<List(*)>
          ( Main.Cons : */List(*)/List(*)
          , x : *
          , acc : List(*)
          )
    , Main.Nil : List(*)
    , xs : List(*)
    )

Main.translate_cells(d_x : int32, d_y : int32, cells : List(Pair(int32, int32))) =
  // Left fold prepends translated cells (reversing); reverse afterward to
  // preserve original order.
  @<List(Pair(int32, int32))>
    ( Main.reverse_list : List(*)/List(*)
    , @<List(Pair(int32, int32))>
        ( Main.fold_list : (*/*/*)/*/List(*)/*
        , fn(cell : Pair(int32, int32), acc : List(Pair(int32, int32))) =>
            @<List(Pair(int32, int32))>
              ( Main.Cons : Pair(int32, int32)/List(Pair(int32, int32))/List(Pair(int32, int32))
              , @<Pair(int32, int32)>
                  ( Main.translate_cell : int32/int32/Pair(int32, int32)/Pair(int32, int32)
                  , d_x : int32
                  , d_y : int32
                  , cell : Pair(int32, int32)
                  )
              , acc : List(Pair(int32, int32))
              )
        , Main.Nil : List(Pair(int32, int32))
        , cells : List(Pair(int32, int32))
        )
    )

