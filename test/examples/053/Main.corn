Main.current_block_cells(state : State) =
  case<List(Pair(int32, int32))>(state : State) {
    | ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State 
      , info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }
      ) =>
        let 
          block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } =
            get?_current_block<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>(info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} })
        in
        let 
          shape : Shape = get?_shape<Shape>(block : { shape : Shape | * })
          ;
          rotation : Rotation = get?_rotation<Rotation>(block : { rotation : Rotation | * })
          ;
          pos_x : int32 = get?_pos_x<int32>(block : { pos_x : int32 | * })
          ;
          pos_y : int32 = get?_pos_y<int32>(block : { pos_y : int32 | * })
        in
        let
          cells : List(Pair(int32, int32)) =
            @<List(Pair(int32, int32))>
              ( Main.shape_cells : Shape/Rotation/List(Pair(int32, int32))
              , shape : Shape
              , rotation : Rotation
              )
          in
            @<List(Pair(int32, int32))>
              ( Main.translate_cells : int32/int32/List(Pair(int32, int32))/List(Pair(int32, int32))
              , pos_x : int32
              , pos_y : int32
              , cells : List(Pair(int32, int32))
              )
  }

Main.board_of_state(state : State) =
  case<Set(Pair(int32, int32))>(state : State) {
    | ( Main.State : */State
      , info : { board : Set(Pair(int32, int32)) | * }
      ) =>
        get?_board<Set(Pair(int32, int32))>(info : { board : Set(Pair(int32, int32)) | * })
  }

Main.shape_to_string(shape : Shape) =
  case<string>(shape : Shape) {
    | ( Main.ShapeI : Shape ) => "ShapeI"
    | ( Main.ShapeO : Shape ) => "ShapeO"
    | ( Main.ShapeT : Shape ) => "ShapeT"
    | ( Main.ShapeS : Shape ) => "ShapeS"
    | ( Main.ShapeZ : Shape ) => "ShapeZ"
    | ( Main.ShapeJ : Shape ) => "ShapeJ"
    | ( Main.ShapeL : Shape ) => "ShapeL"
  }

Main.rotation_to_string(rotation : Rotation) =
  case<string>(rotation : Rotation) {
    | ( Main.R0    : Rotation ) => "0"
    | ( Main.R90   : Rotation ) => "90"
    | ( Main.R180  : Rotation ) => "180"
    | ( Main.R270  : Rotation ) => "270"
  }

Main.event_to_string(event : Event) =
  case<string>(event : Event) {
    | ( Main.KeyLeft   : Event ) => "KeyLeft"
    | ( Main.KeyRight  : Event ) => "KeyRight"
    | ( Main.KeyDown   : Event ) => "KeyDown"
    | ( Main.KeyUp     : Event ) => "KeyUp"
    | ( Main.KeySpace  : Event ) => "KeySpace"
    | ( Main.KeyEsc    : Event ) => "KeyEsc"
    | ( Main.Tick      : Event ) => "Tick"
    | ( Main.NoOp      : Event ) => "NoOp"
  }

Main.print_current_block(state : State) =
  case<unit>(state : State) {
    | ( Main.State : */State 
      , info : 
          { current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } 
          | * 
          }
      ) =>
        let
          current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } =
            get?_current_block<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>(info : { current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | * })
          in
            let
              shape : Shape = get?_shape<Shape>(current_block : { shape : Shape | * }) 
              ; 
              rotation : Rotation = get?_rotation<Rotation>(current_block : { rotation : Rotation | * }) 
              ;
              pos_x : int32 = get?_pos_x<int32>(current_block : { pos_x : int32 | * }) 
              ;
              pos_y : int32 = get?_pos_y<int32>(current_block : { pos_y : int32 | * }) 
            in
              let
                shape_str : string = 
                  @<string>
                     ( Main.shape_to_string : Shape/string
                     , shape : Shape
                     ) 
                ; 
                rotation_str : string =
                  @<string>
                     ( Main.rotation_to_string : Rotation/string
                     , rotation : Rotation
                     )
                in
                  let
                    _ : * =
                      @<*>
                        ( coal_println_string : string/*
                        , shape_str : string
                        )
                    ;
                    _ : * =
                      @<*>
                        ( coal_println_string : string/*
                        , rotation_str : string
                        )
                    ;
                    _ : * =
                      @<*>
                        ( coal_println_int32 : int32/*
                        , pos_x : int32
                        )
                    ;
                    _ : * =
                      @<*>
                        ( coal_println_int32 : int32/*
                        , pos_y : int32
                        )
                    in
                      ()
  }

Main.parse_event(ev_code : int32) =
  if ([== int32](0, ev_code : int32)) then Main.Tick : Event
    else if ([== int32](68, ev_code : int32)) then Main.KeyLeft : Event
    else if ([== int32](67, ev_code : int32)) then Main.KeyRight : Event
    else if ([== int32](66, ev_code : int32)) then Main.KeyDown : Event
    else if ([== int32](65, ev_code : int32)) then Main.KeyUp : Event
    else if ([== int32](32, ev_code : int32)) then Main.KeySpace : Event
    else if ([== int32](27, ev_code : int32)) then Main.KeyEsc : Event
    else Main.NoOp : Event

Main.update_current_block(f : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }/{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }, state : State) =
  case<State>(state : State) {
    | ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State 
      , info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }
      ) =>
        let 
          new_current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } =
            @<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>
              ( f : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }/{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }
              , get?_current_block<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>(info : { current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | * })
              )
        in
          let
            new_info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} } =
              { board = get?_board<Set(Pair(int32, int32))>(info : { board : Set(Pair(int32, int32)) | * })
              | current_block = new_current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }
              | {}
              }
            in
              @<State>
                ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State
                , new_info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }
                )
  }

Main.move_current_block(d_x : int32, d_y : int32, state : State) =
  @<State>
    ( Main.update_current_block : ({ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }/{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} })/State/State
    , fn(current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }) =>
        { shape = get?_shape<Shape>(current_block : { shape : Shape | * }) 
        | rotation = get?_rotation<Rotation>(current_block : { rotation : Rotation | * }) 
        | pos_x = [+ int32](get?_pos_x<int32>(current_block : { pos_x : int32 | * }), d_x : int32)
        | pos_y = [+ int32](get?_pos_y<int32>(current_block : { pos_y : int32 | * }), d_y : int32)
        | {} 
        } 
    , state : State
    )

Main.rotate_current_block(state : State) =
  @<State>
    ( Main.update_current_block : ({ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }/{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} })/State/State
    , fn(current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }) =>
        { shape = get?_shape<Shape>(current_block : { shape : Shape | * }) 
        | rotation = 
            @<Rotation>
              ( Main.spin : Rotation/Rotation
              , get?_rotation<Rotation>(current_block : { rotation : Rotation | * })
              )
        | pos_x = get?_pos_x<int32>(current_block : { pos_x : int32 | * })
        | pos_y = get?_pos_y<int32>(current_block : { pos_y : int32 | * })
        | {} 
        } 
    , state : State
    )

// ---------------------------------------------------------------------------
// Piece locking
// ---------------------------------------------------------------------------

Main.lock_current_block(state : State) =
  case<State>(state : State) {
    | ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State
      , info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }
      ) =>
        let
          new_board : Set(Pair(int32, int32)) =
            @<Set(Pair(int32, int32))>
              ( Main.board_insert_cells : List(Pair(int32, int32))/Set(Pair(int32, int32))/Set(Pair(int32, int32))
              , @<List(Pair(int32, int32))>
                  ( Main.current_block_cells : State/List(Pair(int32, int32))
                  , state : State
                  )
              , get?_board<Set(Pair(int32, int32))>(info : { board : Set(Pair(int32, int32)) | * })
              )
        in
          @<State>
            ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State
            , { board = new_board : Set(Pair(int32, int32))
              | current_block = get?_current_block<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>(info : { current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | * })
              | {}
              }
            )
  }

// ---------------------------------------------------------------------------
// Collision guards
// ---------------------------------------------------------------------------

Main.can_move_left(state : State) =
  [!]
    ( @<bool>
        ( Main.cells_collide : List(Pair(int32, int32))/State/bool
        , @<List(Pair(int32, int32))>
            ( Main.translate_cells : int32/int32/List(Pair(int32, int32))/List(Pair(int32, int32))
            , -1
            , 0
            , @<List(Pair(int32, int32))>
                ( Main.current_block_cells : State/List(Pair(int32, int32))
                , state : State
                )
            )
        , state : State
        )
    )

Main.can_move_right(state : State) =
  [!]
    ( @<bool>
        ( Main.cells_collide : List(Pair(int32, int32))/State/bool
        , @<List(Pair(int32, int32))>
            ( Main.translate_cells : int32/int32/List(Pair(int32, int32))/List(Pair(int32, int32))
            , 1
            , 0
            , @<List(Pair(int32, int32))>
                ( Main.current_block_cells : State/List(Pair(int32, int32))
                , state : State
                )
            )
        , state : State
        )
    )

Main.can_move_down(state : State) =
  [!]
    ( @<bool>
        ( Main.cells_collide : List(Pair(int32, int32))/State/bool
        , @<List(Pair(int32, int32))>
            ( Main.translate_cells : int32/int32/List(Pair(int32, int32))/List(Pair(int32, int32))
            , 0
            , 1
            , @<List(Pair(int32, int32))>
                ( Main.current_block_cells : State/List(Pair(int32, int32))
                , state : State
                )
            )
        , state : State
        )
    )

Main.can_rotate(state : State) =
  case<bool>(state : State) {
    | ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State
      , info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }
      ) =>
        let
          block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } =
            get?_current_block<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>(info : { current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | * })
        in
        let
          shape : Shape  = get?_shape<Shape>(block : { shape : Shape | * })
          ;
          pos_x : int32  = get?_pos_x<int32>(block : { pos_x : int32 | * })
          ;
          pos_y : int32  = get?_pos_y<int32>(block : { pos_y : int32 | * })
          ;
          next_rot : Rotation =
            @<Rotation>
              ( Main.spin : Rotation/Rotation
              , get?_rotation<Rotation>(block : { rotation : Rotation | * })
              )
        in
        let
          rotated_cells : List(Pair(int32, int32)) =
            @<List(Pair(int32, int32))>
              ( Main.translate_cells : int32/int32/List(Pair(int32, int32))/List(Pair(int32, int32))
              , pos_x : int32
              , pos_y : int32
              , @<List(Pair(int32, int32))>
                  ( Main.shape_cells : Shape/Rotation/List(Pair(int32, int32))
                  , shape : Shape
                  , next_rot : Rotation
                  )
              )
        in
          [!]
            ( @<bool>
                ( Main.cells_collide : List(Pair(int32, int32))/State/bool
                , rotated_cells : List(Pair(int32, int32))
                , state : State
                )
            )
  }

Main.move_left(state : State) =
  let
    can_move : bool =
      @<bool>
        ( Main.can_move_left : State/bool
        , state : State
        )
  in
    if (can_move : bool)
      then
        @<State>
          ( Main.move_current_block : int32/int32/State/State
          , -1
          , 0
          , state : State
          )
      else 
        state : State

Main.move_right(state : State) =
  let
    can_move : bool =
      @<bool>
        ( Main.can_move_right : State/bool
        , state : State
        )
  in
    if (can_move : bool)
      then
        @<State>
          ( Main.move_current_block : int32/int32/State/State
          , 1
          , 0
          , state : State
          )
      else 
        state : State

Main.move_down(state : State) =
  let
    can_move : bool =
      @<bool>
        ( Main.can_move_down : State/bool
        , state : State
        )
  in
    if (can_move : bool)
      then
        @<State>
          ( Main.move_current_block : int32/int32/State/State
          , 0
          , 1
          , state : State
          )
      else 
        state : State

Main.rotate(state : State) =
  let
    can_rotate : bool =
      @<bool>
        ( Main.can_rotate : State/bool
        , state : State
        )
  in
    if (can_rotate : bool)
      then
        @<State>
          ( Main.rotate_current_block : State/State
          , state : State
          )
      else 
        state : State

// ---------------------------------------------------------------------------
// Spawn, landing, tick
// ---------------------------------------------------------------------------

Main.spawn_next_block(state : State) =
  @<State>
    ( Main.update_current_block : ({ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }/{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} })/State/State
    , fn(_ : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }) =>
        @<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>
          ( Main.random_block : */{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }
          , ()
          )
    , state : State
    )

Main.on_piece_landed(state : State) =
  let
    locked : State =
      @<State>
        ( Main.lock_current_block : State/State
        , state : State
        )
  in
  case<State>(locked : State) {
    | ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State
      , info : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }
      ) =>
        let
          cleared : State =
            @<State>
              ( Main.State : { board : Set(Pair(int32, int32)) | current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | {} }/State
              , { board =
                    @<Set(Pair(int32, int32))>
                      ( Main.board_clear_full_rows : Set(Pair(int32, int32))/Set(Pair(int32, int32))
                      , get?_board<Set(Pair(int32, int32))>(info : { board : Set(Pair(int32, int32)) | * })
                      )
                | current_block =
                    get?_current_block<{ shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} }>(info : { current_block : { shape : Shape | rotation : Rotation | pos_x : int32 | pos_y : int32 | {} } | * })
                | {}
                }
              )
        in
        let
          spawned : State =
            @<State>
              ( Main.spawn_next_block : State/State
              , cleared : State
              )
        in
          if ( @<bool>
                 ( Main.cells_collide : List(Pair(int32, int32))/State/bool
                 , @<List(Pair(int32, int32))>
                     ( Main.current_block_cells : State/List(Pair(int32, int32))
                     , spawned : State
                     )
                 , spawned : State
                 )
             )
            then cleared : State   // game over: freeze rather than corrupt state
            else spawned : State
  }

Main.tick(state : State) =
  if ( @<bool>
         ( Main.can_move_down : State/bool
         , state : State
         )
     )
    then
      @<State>
        ( Main.move_current_block : int32/int32/State/State
        , 0
        , 1
        , state : State
        )
    else
      @<State>
        ( Main.on_piece_landed : State/State
        , state : State
        )

// Hard drop: move the block down as far as possible (bounded by board height),
// then lock it. Each fold step moves down if possible; once it can't, subsequent
// steps are no-ops. Finally, lock the landed piece.
Main.hard_drop(state : State) =
  let
    dropped : State =
      @<State>
        ( Main.fold_list : (*/*/*)/*/List(*)/*
        , fn(_ : int32, acc : State) =>
            if ( @<bool>
                   ( Main.can_move_down : State/bool
                   , acc : State
                   )
               )
              then
                @<State>
                  ( Main.move_current_block : int32/int32/State/State
                  , 0
                  , 1
                  , acc : State
                  )
              else
                acc : State
        , state : State
        , Main.row_y_coords : List(int32)
        )
  in
    @<State>
      ( Main.on_piece_landed : State/State
      , dropped : State
      )

// ---------------------------------------------------------------------------

Main.handle_event
  ( event : Event
  , state : State
  ) =
    case<State>(event : Event) {
      | ( Main.KeyLeft : Event ) => 
        @<State>
          ( Main.move_left : State/State
          , state : State
          )
      | ( Main.KeyRight : Event ) => 
        @<State>
          ( Main.move_right : State/State
          , state : State
          )
      | ( Main.KeyDown : Event ) => 
        @<State>
          ( Main.tick : State/State
          , state : State
          )
      | ( Main.KeyUp : Event ) => 
        @<State>
          ( Main.rotate : State/State
          , state : State
          )
      | ( Main.KeySpace : Event ) => 
        @<State>
          ( Main.hard_drop : State/State
          , state : State
          )
      | ( Main.KeyEsc : Event ) => 
        state : State
      | ( Main.Tick : Event ) => 
        @<State>
          ( Main.tick : State/State
          , state : State
          )
      | ( Main.NoOp : Event ) => 
        state : State
    }

Main.handle
  ( ev_code : int32
  , state : State
  ) =
    let 
      event : Event =
        @<Event>
          ( Main.parse_event : int32/Event
          , ev_code : int32
          )
    in
      let
        new_state : State =
          @<State>
            ( Main.handle_event : Event/State/State
            , event : Event
            , state : State
            )
        ;
        event_str : string =
          @<string>
            ( Main.event_to_string : Event/string
            , event : Event
            )
        ;
        _ : * =
          @<*>
            ( coal_render_board : List(Pair(int32, int32))/List(Pair(int32, int32))/*
            , @<List(Pair(int32, int32))>
                ( Main.board_to_list : Set(Pair(int32, int32))/List(Pair(int32, int32))
                , @<Set(Pair(int32, int32))>
                    ( Main.board_of_state : State/Set(Pair(int32, int32))
                    , new_state : State
                    )
                )
            , @<List(Pair(int32, int32))>
                ( Main.current_block_cells : State/List(Pair(int32, int32))
                , new_state : State
                )
            )
        in
          let
            _ : * =
              @<*>
                ( coal_println_string : string/*
                , event_str : string
                )
            in
              new_state : State

Main.loop(state : State) =
  let
    has_next : bool =
      @<bool>
        ( event_loop_has_next : unit/bool
        , ()
        )
    in
      if (has_next : bool)
        then
          let ev_code : int32 = 
            @<int32>
              ( event_loop_next : unit/int32
              , ()
              )
          in  
            let
              next_state : State =
                @<State>
                  ( Main.handle : int32/State/State
                  , ev_code : int32 
                  , state : State 
                  )
              in
                @<State>
                  ( Main.loop : State/State
                  , next_state : State
                  )
        else
          state : State

Main.main(_ : *) =
  let 
    _ : * =
      @<*>
        ( event_loop_init : int32/*
        , 1000
        )
  in  
    @<State>
      ( Main.loop : State/State
      , Main.initial_game_state : State
      )

}