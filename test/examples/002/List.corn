module List {

import Utils.Function.compose

List.concat(a : list(*), b : list(*)) =
  case<list(*)>(a : list(*)) {
    | ($Nil : list(*)) =>
        b : list(*)
    | ($Cons : */list(*)/list(*), x : *, xs : list(*)) =>
        @<list(*)>
          ( $Cons : */list(*)/list(*)
          , x : *
          , @<list(*)>
              ( List.concat : list(*)/list(*)/list(*)
              , xs : list(*)
              , b : list(*)
              )
          )
  }

}
