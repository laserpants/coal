module Main {

Main.f1(a : int32, b : int32, c : int32) =
  [+ int32]
    ( a : int32
    , [+ int32]
        ( b : int32
        , c : int32
        )
    )

Main.expr1(f : int32/int32) =
  @<int32>
    ( f : int32/int32
    , 1
    )

Main.expr2(f : int32/int32/int32) =
  let
    z : int32/int32 =
      @<int32/int32>
        ( f : int32/int32/int32
        , 1
        )
    in
      @<int32>
        ( Main.expr1 : (int32/int32)/int32
        , z : int32/int32
        )

Main.main(_ : *) =
  let
    g : int32/int32/int32 =
      @<int32/int32/int32>
        ( Main.f1 : int32/int32/int32/int32
        , 4
        )
      in
        let r : int32 =
          @<int32>
            ( Main.expr2 : (int32/int32/int32)/int32
            , g : int32/int32/int32
            )
          in
            let
              __call_tmp : * =
                @<*>
                  ( coal_print_int32 : int32/*
                  , r : int32
                  )
              in
                @<int32>
                  ( fn(a : *) => r : int32
                  , __call_tmp : *
                  )

}
