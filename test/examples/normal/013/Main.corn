module Main {

  data $Cons<0, */List(*)/List(*)>
  data $Nil<1, List(*)>

  data $Record<0, */record(*)>

  Main.list_map(f : */*, ls : list(*)) =
    case<list(*)>(ls : list(*)) {
      | ($Cons : */list(*)/list(*), x : *, xs : list(*)) =>
          let
            hd : * = @<*>(f : */*, x : *)
          ; tl : list(*) =
              @<list(*)>
                ( Main.list_map : (*/*)/list(*)/list(*)
                , f : */*
                , xs : list(*)
                )
          in
            @<list(*)>
              ( $Cons : */list(*)/list(*)
              , hd : *
              , tl : list(*)
              )
      | ($Nil : list(*)) =>
          $Nil : list(*)
    }

  Main.operator_plus(dict : record({ operator_plus : */*/* | * }), x : *, y : *) =
    case<*>(dict : record({ operator_plus : */*/* | * })) {
      | ( $Record : { operator_plus : */*/* | * }/record({ operator_plus : */*/* | * })
        , r : { operator_plus : */*/* | * }
        ) =>
          @<*>
            ( get?_operator_plus<*/*/*>(r : { operator_plus : */*/* | * })
            , x : *
            , y : *
            )
    }

  Main.from_int32(dict : record({ from_int32 : int32/* | * }), n : int32) =
    case<*>(dict : record({ from_int32 : int32/* | * })) {
      | ( $Record : { from_int32 : int32/* | * }/record({ from_int32 : int32/* | * })
        , r : { from_int32 : int32/* | * }
        ) =>
          @<*>
            ( get?_from_int32<int32/*>(r : { from_int32 : int32/* | * })
            , n : int32
            )
    }

  Main.anon_fun1(dict : record({ from_int32 : int32/* | operator_plus : */*/* | * }), x : *) =
    let
      t1 : * =
        @<*>
          ( Main.from_int32 : record({ from_int32 : int32/* | * })/int32/*
          , dict : record({ from_int32 : int32/* | * })
          , 1
          )
    in
      @<*>
        ( Main.operator_plus : record({ operator_plus : */*/* | * })/*/*/*
        , dict : record({ operator_plus : */*/* | * })
        , x : *
        , t1 : *
        )

  Main.increment_each(dict : record({ from_int32 : int32/* | operator_plus : */*/* | * }), xs : list(*)) =
    let
      f1 : */* =
        @<*/*>
          ( Main.anon_fun1 : record({ from_int32 : int32/* | operator_plus : */*/* | * })/*/*
          , dict : record({ from_int32 : int32/* | operator_plus : */*/* | * })
          )
    in
    @<list(*)>
      ( Main.list_map : (*/*)/list(*)/list(*)
      , f1 : */*
      , xs : list(*)
      )

  Main.anon_fun2(a : *) =
    0 

  Main.anon_fun3(x : int32) =
    x : int32

  Main.anon_fun4(x : int32, y : int32) =
    [+ int32]
      ( x : int32
      , y : int32
      )

  Main.main(_ : *) =
    let
      l3 : list(int32) =
        @<list(int32)>
          ( $Cons : int32/list(int32)/list(int32)
          , 3
          , $Nil : list(int32)
          )
    ; l2 : list(int32) =
        @<list(int32)>
          ( $Cons : int32/list(int32)/list(int32)
          , 1
          , l3 : list(int32)
          )
    ; l1 : list(int32) =
        @<list(int32)>
          ( $Cons : int32/list(int32)/list(int32)
          , 4
          , l2 : list(int32)
          )
    ; xs : list(int32) =
        @<list(int32)>
          ( $Cons : int32/list(int32)/list(int32)
          , 2
          , l1 : list(int32)
          )
    ; rec_ys : { from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * } =
        { from_int32 = Main.anon_fun3 : int32/int32
        | operator_plus = Main.anon_fun4 : int32/int32/int32
        | {}
        }
    ; dict_ys : record({ from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * }) =
        @<record({ from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * })>
          ( $Record : { from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * }/record({ from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * })
          , rec_ys : { from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * }
          )
    ; ys : list(int32) =
        @<list(int32)>
          ( Main.increment_each : record({ from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * })/list(int32)/list(int32)
          , dict_ys : record({ from_int32 : int32/int32 | operator_plus : int32/int32/int32 | * })
          , xs : list(int32)
          )
    in
      case<int32>(ys : list(int32)) {
        | ($Cons : int32/list(int32)/list(int32), r : int32, _ : list(int32)) =>
            let
              __call_tmp : * =
                @<*>
                  ( coal_print_int32 : int32/*
                  , r : int32
                  )
              in
                @<int32>
                  ( Main.anon_fun2 : */int32
                  , __call_tmp : *
                  )
        | ($Nil : list(int32)) =>
            0
      }

}
