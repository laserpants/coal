module Main {

  Main.factorial(n : int32) =
    if ([== int32](n : int32, 0))
      then
        1
      else
        [* int32]
          ( n : int32
          , @<int32>
              ( Main.factorial : int32/int32
              , [- int32](n : int32, 1)
              )
          )

  Main.cont1(a : *) = 
    0

  Main.main(_ : *) =
    let
      r : int32 =
        @<int32>
          ( Main.factorial : int32/int32
          , 6
          )
      in
        let
          __call_tmp : * =
            @<*>
              ( coal_print_int32 : int32/*
              , r : int32
              )
          in
            @<int32>
              ( Main.cont1 : */int32
              , __call_tmp : *
              )

}