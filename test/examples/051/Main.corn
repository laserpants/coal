module Main {

Main.mul_int32(a : int32, b : int32) =
  [* int32](a : int32, b : int32)

Main.mul(rec : { mul : */*/* | * }) =
  get?_mul<*/*/*>(rec : { mul : */*/* | * })

Main.main($v.6273 : unit) =
  let
    r : int32 =
      @<int32>
        ( @<int32/int32/int32>
            ( Main.mul : { mul : int32/int32/int32 | * }/int32/int32/int32
            , @<record({ mul : int32/int32/int32 | * })>
                ( $Record : { mul : int32/int32/int32 | * }/record({ mul : int32/int32/int32 | * }) 
                , { mul = Main.mul_int32 : int32/int32/int32
                  | {}
                  } 
                )
            )
        , 5
        , 3
        )
    in
      @<IO(unit)>
        ( coal_println_int32 : int32/IO(unit)
        , r : int32
        )


