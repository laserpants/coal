module Ordered {

import Core$.operator__reverse_composition
import Core$.operator__not

data Ordered.Ordering
  = Ordered.EqualTo
  | Ordered.GreaterThan 
  | Ordered.LessThan

Ordered.compare($a : Ordered.Ordered(*)) =
  case<*/*/Ordered.Ordering>($a : Ordered.Ordered(*)) {
    | ( $Record : { compare : */*/Ordered.Ordering | * }/Ordered.Ordered(*)
      , $r : { compare : */*/Ordered.Ordering | * }
      ) =>
        get?_compare<*/*/Ordered.Ordering>($r : { compare : */*/Ordered.Ordering | * })
  }

Ordered.compare__$instance.f377c7c1cf28bc72(x : int32, y : int32) =
  if ([< int32](x : int32, y : int32))
    then
      Ordered.LessThan : Ordered.Ordering
    else
      if ([> int32](x : int32, y : int32))
        then
          Ordered.GreaterThan : Ordered.Ordering
        else
          Ordered.EqualTo : Ordered.Ordering

Ordered.less_than_or_equal_to($dict.ffef54c635ab7d00 : Ordered.Ordered(*), m : *, n : *) =
  case<bool>
    ( @<Ordered.Ordering>
      ( Ordered.compare : Ordered.Ordered(*)/*/*/Ordered.Ordering
      , $dict.ffef54c635ab7d00 : Ordered.Ordered(*)
      , m : *
      , n : *
      )
    ) {
      | (Ordered.EqualTo : Ordered.Ordering) => true
      | (Ordered.GreaterThan : Ordered.Ordering) => false
      | (Ordered.LessThan : Ordered.Ordering) => true
  }

Ordered.greater_than($dict.ffef54c635ab7d01 : Ordered.Ordered(*), n : *) =
  @<*/bool>
    ( Core$.operator__reverse_composition : (bool/bool)/(*/bool)/*/bool
    , Core$.operator__not : bool/bool
    , @<*/bool>
        ( Ordered.less_than_or_equal_to : Ordered(*)/*/*/bool
        , $dict.ffef54c635ab7d01 : Ordered(*)
        , n : *
        )
    )

}
