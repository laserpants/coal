module Main {

  import IO(println_string)
  import String(int32_to_string)

  type alias Source<a> =
    { poll : unit -> a
    , guard : int32
    }

  // FFI counter primitives: counting how many times a construction happens.
  fun mk() : int32 =
    #{counter_mk : unit -> int32}(())(fn(x) => x)

  fun get() : int32 =
    #{counter_get : unit -> int32}(())(fn(x) => x)

  fun reset() : int32 =
    #{counter_reset : unit -> int32}(())(fn(x) => x)

  // Building an event source performs an FFI side effect (registering a
  // guard): each evaluation of this function must bump the counter once.
  fun take(count : int32) : Source<int32> =
    let g = mk() in
    { poll = fn(_) => g, guard = g }

  fun poll(s : Source<int32>) : int32 =
    s.poll(())

  // Parameter control: bind via parameter, use three times. Function
  // parameters are strict runtime values, evaluated once and shared.
  fun drive(s : Source<int32>) : int32 =
    let p1 = poll(s) in
    let p2 = poll(s) in
    let p3 = poll(s) in
    get()

  // --- Polymorphic right-hand side (strict-once regression guard) ---------
  //
  // NOTE: the return type is deliberately NOT annotated. The literal `5` is
  // inferred as `a with Numeric<a>`, so `poly_mk : unit -> a with Numeric<a>`
  // and the trait constraint survives into the translation phase. A `let`
  // that generalizes over that constraint is rewritten by InsertDictionaries
  // into a dictionary lambda which is re-applied at every use site, so the
  // FFI effect below would run once per use of `x` instead of once.
  //
  // The annotated cases above cannot detect this: with a concrete return type
  // no trait constraint remains and the dictionary-lambda path never fires.
  fun poly_mk(_ : unit) =
    let c = mk() in
    5

  // `x` is used twice; the counter must show exactly one evaluation.
  fun poly_driven() : int32 =
    let x = poly_mk(()) in
    x + x

  fun main() =
    let _ = reset() in
    let src = take(2) in
    let before = get() in
    let p1 = poll(src) in
    let p2 = poll(src) in
    let p3 = poll(src) in
    let after = get() in
    let param_driven = drive(take(2)) in
    let _ = reset() in
    let poly_value = poly_driven() in
    let poly_calls = get() in
    do {
      println_string("before=" <> int32_to_string(before));
      println_string("after 3 polls of src=" <> int32_to_string(after));
      println_string("polls=" <> int32_to_string(p1) <> int32_to_string(p2) <> int32_to_string(p3));
      println_string("param_driven=" <> int32_to_string(param_driven));
      println_string("src.guard=" <> int32_to_string(src.guard));
      println_string("poly_value=" <> int32_to_string(poly_value));
      println_string("poly_calls=" <> int32_to_string(poly_calls));
    }

}
