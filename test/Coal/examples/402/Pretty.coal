module Pretty {

  import Coal.Combinators(identity, always)
  import Coal.Functor(map)
  import String(intercalate, char_to_string, int32_to_string, int64_to_string, float_to_string, double_to_string)
  import Number(bignum_to_string)
  import Nat(unpack)

  trait Pretty<p> {
    pretty : p -> string
  }

  instance Pretty<string> {
    let pretty = identity
  }

  instance Pretty<int32> {
    let pretty = int32_to_string
  }

  instance Pretty<int64> {
    let pretty = int64_to_string
  }

  instance Pretty<float> {
    let pretty = float_to_string
  }

  instance Pretty<double> {
    let pretty = double_to_string
  }

  instance Pretty<nat> {
    fun pretty(n : nat) =
      int32_to_string(unpack(n))
  }

  instance Pretty<bignum> {
    let pretty = bignum_to_string
  }

  instance Pretty<bool> {
    fun pretty
      | false => "false"
      | true  => "true"
  }

  instance Pretty<unit> {
    let pretty = always("()")
  }

  instance Pretty<char> {
    let pretty = char_to_string
  }

  instance Pretty<List<a>> with (Pretty<a>) {
    fun pretty(xs) = "[" <> intercalate(",", map(pretty, xs)) <> "]"
  }

  instance Pretty<Option<a>> with (Pretty<a>) {
    fun pretty(opt) =
      match(opt) {
        | Some(p) => 
            "Some(" <> pretty(p) <> ")"
        | None => 
            "None"
      }
  }

  instance Pretty<Result<r, e>> with (Pretty<r>, Pretty<e>) {
    fun pretty(res) =
      match(res) {
        | Ok(r) => 
            "Ok(" <> pretty(r) <> ")"
        | Err(e) => 
            "Err(" <> pretty(e) <> ")"
      }
  }

  instance Pretty<(a, b)> with (Pretty<a>, Pretty<b>) {
    fun pretty((e1, e2)) =
      "(" <> pretty(e1) <> "," <> pretty(e2) <> ")"
  }

  instance Pretty<(a, b, c)> with (Pretty<a>, Pretty<b>, Pretty<c>) {
    fun pretty((e1, e2, e3)) =
      "(" <> pretty(e1) <> "," <> pretty(e2) <> "," <> pretty(e3) <> ")"
  }

  instance Pretty<(a, b, c, d)> with (Pretty<a>, Pretty<b>, Pretty<c>, Pretty<d>) {
    fun pretty((e1, e2, e3, e4)) =
      "(" <> pretty(e1) <> "," <> pretty(e2) <> "," <> pretty(e3) <> "," <> pretty(e4) <> ")"
  }

  instance Pretty<(a, b, c, d, e)> with (Pretty<a>, Pretty<b>, Pretty<c>, Pretty<d>, Pretty<e>) {
    fun pretty((e1, e2, e3, e4, e5)) =
      "(" <> pretty(e1) <> "," <> pretty(e2) <> "," <> pretty(e3) <> "," <> pretty(e4) <> "," <> pretty(e5) <> ")"
  }


}