module Main {

  import Core$(trace_int32, pack_nat, unpack_nat, from_int32, `from_int32__$instance_Numeric(Intrinsic(Int32))`);

  fn factorial(n : int32) : int32 =
    fold(pack_nat(n)) {
      | Zero =>
          1
      | Succ(@f) as m =>
          unpack_nat(m) * f
    };

  fn main() =
    trace_int32(factorial(4));

}
