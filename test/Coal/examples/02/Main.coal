module Main {

  import Core$(trace_int32, from_int32, unpack_nat, pack_nat);

  trait Numeric(n) {
    from_int32 : int32 -> n
  }

  instance Numeric(int32) {
    fn from_int32(n) = n;
  }

  fn factorial(n : int32) : int32 =
    fold(pack_nat(n)) {
      | Zero =>
          1
      | Succ(@f) as m =>
          unpack_nat(m) * f
    };

  fn main() =
    trace_int32(factorial(4));

}
