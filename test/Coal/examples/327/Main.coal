module Main {

  import namespace IO

  trait Associative<a> {
    combine : a -> a -> a
  }

  instance Associative<int32> {
    fun combine(x, y) = x + y
  }

  // fun example1(x : a, y : a) : a with (Associative<a>) =

  fun example1(x : a, y : a) : a with Associative<a> =
    combine(x, y)

//  ^^^
//  should be:
//
//  fun example1(x : a, y : a) : a with Associative<a> =
//    combine(x, y)

  fun example2(x : a, y : a) =
    combine(x, y)

//  ^^^
//  also:
//
//  fun example(x : a, y : a) with Associative<a> =
//    combine(x, y)

  fun example3(x, y) =
    combine(x, y)

//  ^^^
//  this is OK, since the parameter a is implicit

  fun example4(x : int32, y : int32) : int32 =
    combine(x, y)

//  ^^^
//  No external/explicit traits 

  fun example5(x : int32, y : int32) =
    combine(x, y)

//  ^^^
//  No external/explicit traits 

  let example6 : a -> a -> a =
    fn(x, y) =>
      combine(x, y)

//  ^^^
//  should be:
//
//  a -> a -> a with Associative<a>

  fun main() =
//    IO.println_int32(inverse(5))
    IO.println_int32(5)

}
