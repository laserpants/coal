module Main {

  cotype Stream<a> = { Head : a, Tail : Stream<a> }

  unfold enum_from(n : int32) : Stream<int32> { 
    , Head = n
    , @Tail = n + 1
  }

  fun drop(n : int32, s) =
    fold(pack_nat(n), s) {
      | Zero =>
          fn(t) => t
      | Succ(@next) =>
          fn(t) => next(t.Tail)
    }

  let nats = enum_from(0)

//  cotype OStream<a> = { Head : a, Tail : Option<OStream<a>> }
//
//  unfold enum_from(n : int32) : OStream<int32> { 
//    , Head = n
//    , @Tail = @Some(n + 1)
//  }

  fun main() = 
    trace_int32(drop(100, nats).Head)

}
