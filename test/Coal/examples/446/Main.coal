module Main {

  import namespace IO

  let
   max_i64 : int64 = 9223372036854775807

  let
   min_i64 : int64 = -9223372036854775808

  let
   max_i32 : int32 = 2147483647

  let
   min_i32 : int32 = -2147483648

  // Regression guards for signed-literal parsing: the sign must become part
  // of the literal (integers), while `- expr` keeps its prefix-negation
  // meaning for non-literal and spaced operands.
  let
   neg_double : double = -1.5

  let
   neg_float : float = -2.5f

  let
   spaced_neg : int32 = - 5


  fun main() = do {
    IO.println_int64(max_i64);
    IO.println_int64(min_i64);
    IO.println_int32(max_i32);
    IO.println_int32(min_i32);
    IO.println_double(neg_double);
    IO.println_float(neg_float);
    IO.println_int32(spaced_neg);
  }

}
