module Main {

  import IO(println_string, println_int32)
  import Char(digit_to_int32)
  import String(from_list, to_list, cons, concat, length)
  import Coal.Functor(trait Functor)
  import Nat(pack)

  type alias Parser<a> = string -> Option<(a, string)>

  // Primitive that fails
  fun fail() : Parser<a> =
    fn(_) => None

  // Succeed without consuming
  fun parser_pure(x : a) : Parser<a> =
    fn(input) => Some((x, input))

  // Apply a parser and map its result
  fun parser_map(p : Parser<a>, f : a -> b) : Parser<b> =
    fn(input) =>
      match(p(input)) {
        | Some((a, rest)) => Some((f(a), rest))
        | None => None
      }

  // Monadic bind
  fun parser_bind(p : Parser<a>, f : a -> Parser<b>) : Parser<b> =
    fn(input) =>
      match(p(input)) {
        | Some((a, rest)) => f(a, rest)
        | None => None
      }

  // Choice
  fun parser_or(p1 : Parser<a>, p2 : Parser<a>) : Parser<a> =
    fn(input) =>
      match(p1(input)) {
        | Some(_) as r => r
        | None => p2(input)
      }

  fun parser_then(p : Parser<a>, q : Parser<b>) : Parser<b> =
    parser_bind(p, fn(_) => q)

  fun parser_before(p : Parser<a>, q : Parser<b>) : Parser<a> =
    parser_bind(p, fn(x) => parser_map(q, fn(_) => x))

  fun satisfy(predicate : char -> bool) : Parser<char> =
    fn(input) =>
      match(to_list(input)) {
        | ch :: rest =>
            if predicate(ch) 
              then Some((ch, from_list(rest)))
              else None
        | [] => None
      }

  fun many(p : Parser<a>) : Parser<List<a>> =
    fn(input) =>
      (fold(length(input), ([], input)) {
        | Zero =>
            fn(r, _) => Some(r)
        | Succ(@cont) =>
            fn((xs, str)) => 
              match(p(str)) {
                | None => fn(_) => Some((xs, str))
                | Some((x, rest)) => cont((x :: xs, rest))
              }
      })(input)

  // Exact char
  fun parser_char(c : char) : Parser<char> =
    satisfy(fn(x) => x == c)

  fun parser_string(s : string) : Parser<string> =
    fold(to_list(s)) {
      | [] =>
          parser_pure("")
      | c :: @rest =>
          parser_bind(parser_char(c), fn(_) => 
            parser_bind(rest, fn(cs) => 
              parser_pure(cons(c, cs))
            )
          )
    }

  fun parse_unsigned(str : string) : Option<int32> =
    let 
      chars = 
        to_list(str)
      in
        fold(chars, Some(0)) {
          | ch :: @go =>
              fn(t) =>
                match(digit_to_int32(ch)) {
                  | Some(n) =>
                      go(map(fn(s) => n + 10 * s, t))
                  | None =>
                      None
                }
          | [] =>
              fn(t) => t
        }

