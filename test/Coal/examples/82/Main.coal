module Main {

  type JsonValue
    = JsonNull
    | JsonBool(bool)
    | JsonNumber(double)
    | JsonString(string)
    | JsonArray(List<JsonValue>)
    | JsonObject(List<(string, JsonValue)>)

  fun encode(json : JsonValue) : string =
    match(json) {
      | JsonNull => "null"
      | JsonBool(false) => "false"
      | JsonBool(true) => "true"

      | JsonNumber(d) =>
          double_to_string(d)

//      | JsonString(str)
//          "\"" +++ str +++ "\""
//      | JsonArray(List<JsonValue>)
//      | JsonObject(List<(string, JsonValue)>)
      | _ => "TODO"
    };

  fun main() =
    trace_string(encode(JsonBool(true)));

}
