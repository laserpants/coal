module Main {

  import IO(println_int32, println_bool, println_string)

  trait JsonSerializable<a> {
    to_json : a -> string
    from_json : string -> Option<a>
  }

  instance JsonSerializable<int32> {
    let to_json = int32_to_string
    let from_json = fn(_) => Some(1)
  }

  fun main() =
    println_string(to_json(1234 : int32))
}
