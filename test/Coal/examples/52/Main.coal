module Main {

  type List<a> 
    = Nil 
    | Cons(a, List<a>)

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    }

  cotype Stream = { Head : int32, Tail : Stream }

  fun take_head(s) = 
    s.Head

  fun drop(n : int32, s) =
    fold(pack_nat(n), s) {
      | Zero =>
          fn(t) => t
      | Succ(@next) =>
          fn(t) => next(t.Tail)
    }

  let nats =
    let 
      go =
        unfold @f(n) { 
          , Head = n
          , Tail = f(n + 1) 
        }
      in
        go(5)

  fun main() = 
    trace_int32(drop(100, nats).Head)
}
