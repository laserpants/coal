module Main {

  trait Functor(f : * -> *) {
    map : (a -> b) -> f(a) -> f(b)
  }

  instance Functor(List) {
    fun map(f, xs) =
      fold(xs) {
        | [] =>
            []
        | head :: @tail =>
            f(head) :: tail
      };
  }

  trait Applicative(f : * -> *) {
    mapf : f(a -> b) -> f(a) -> f(b);
    pure : a -> f(a)
  }

  trait Monad(m : * -> *) {
    bind : m(a) -> (a -> m(b)) -> m(b)
  }

  fun main() =
    let
      xs = 
        map(fn(x) => x + 1, [1 : int32, 2, 3])
      in
        match(xs) {
          | [] =>
              trace_int32(-1)
          | x :: _ =>
              trace_int32(x)
        };
}
