module Main {

  fun filter(p : a -> bool, list : List<a>) =
    fold(list) {
      | [] => []
      | x :: @xs => if(p(x)) then x :: xs else xs
    }

  fun less_than(x : int32, y : int32) : bool =
    let a = trace_string("|") in x > y

  fun greater_than(x : int32, y : int32) : bool =
    let a = trace_string("|") in x < y

  fun trace_list(list) : unit =
    fold(list) {
      | [] => ()
      | x :: @go => let _ = trace_int32(x) in go
    }

//  fun bazzzz(list) =
//    fold(list) {
//      | @xs => xs
//    }

  // 3, 4, 5, 2, 7

  fun sort(list : List<int32>) =
    fold abc(list) {
      | [] => []
      | x :: xs => 
          let lhs = filter(less_than(x), xs)
            in let rhs = filter(greater_than(x), xs)
              in 
                fold(lhs ++ x :: rhs ++ [1, 2, 3]) {
                  | [] => []
                  | y :: abc(@ys) =>
                      y :: ys
                }
  }

  fun main() =
    let a = sort([ 3 : int32, 4, 5, 2, 7 ])
     in trace_list(a)

}


