module BankingGrammar {

  import Coal.Functor(Functor)
  import Coal.Monad.Free(Free, lift_free)
  import Coal.Combinators(always)
  import FreeResult(FreeResultT)

  type AccountId = AccountId(string)
  type Amount = Amount(int32)
  type Transaction = Transaction(AccountId, AccountId, Amount)

  fun in_AccountId(AccountId(str)) = str
  fun in_Amount(Amount(a)) = a

  instance Ordered<Amount> {
    fun compare(Amount(a), Amount(b)) = compare(a, b)
  }

  instance Comparable<Amount> {
    fun `==`(Amount(a), Amount(b)) = a == b
  }

  type BankingError
    = InsufficientFunds
    | NoSuchAccount

  fun error_to_string 
    | InsufficientFunds => "InsufficientFunds"
    | NoSuchAccount => "NoSuchAccount"

  type BankingF<a>
    = GetBalance(AccountId, Result<BankingError, Amount> -> a)
    | Debit(AccountId, Amount, Result<BankingError, unit> -> a)
    | Credit(AccountId, Amount, Result<BankingError, unit> -> a)
    | RecordTransaction(Transaction, a)

  instance Functor<BankingF> {
    fun map(f) = match{
      | GetBalance(account_id, g) => 
          GetBalance(account_id, f << g)
      | Debit(account_id, amount, g) =>
          Debit(account_id, amount, f << g)
      | Credit(account_id, amount, g) => 
          Credit(account_id, amount, f << g)
      | RecordTransaction(transaction, a) => 
          RecordTransaction(transaction, f(a))
    }
  }

  fun get_balance(account_id) = lift_free(GetBalance(account_id, fn(b) => b))
  fun debit(account_id, amount) = lift_free(Debit(account_id, amount, fn(b) => b))
  fun credit(account_id, amount) = lift_free(Credit(account_id, amount, fn(b) => b))
  fun record_transaction(transaction) = lift_free(RecordTransaction(transaction, ()))

  fun get_balance_result(account_id) =
    FreeResultT(get_balance(account_id))

  fun debit_result(account_id, amount) =
    FreeResultT(debit(account_id, amount))

  fun credit_result(account_id, amount) =
    FreeResultT(credit(account_id, amount))

  fun record_transaction_result(transaction) =
    FreeResultT(map(always(Ok()), record_transaction(transaction)))

  type alias Banking<a> = FreeResultT<BankingF, BankingError, a>

}
