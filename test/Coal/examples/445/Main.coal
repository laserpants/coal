module Main {

  import namespace IO

  // Hexadecimal literals are interchangeable with their decimal spellings:
  // `0xff` and `255` produce the same value and type. The literal payload is
  // chosen by magnitude (int32, then int64, then integer), so `0xbeef` becomes
  // `from_int32(48879)` exactly as decimal `48879` would.
  fun classify(n : int32) : int32 =
    match(n) {
      | 0xff => 255
      | 0x10 => 16
      | _ => 0
    }

  fun main() = do {
    // Lowercase `0x`, uppercase `0X`, and mixed-case digits are all accepted.
    IO.println_int32(0xbeef);
    IO.println_int32(0xBEEF);
    IO.println_int32(0Xbeef);
    IO.println_int32(0x0);
    // Hex literals compose with operators and stay lexically distinct.
    IO.println_int32(0xa + 0x5);
    IO.println_int32(-0x10);
    // Integer literal patterns accept hex just like decimal.
    IO.println_int32(classify(0xff));
    IO.println_int32(classify(0x10));
    // Magnitude selects the payload: int64 for values past int32 ...
    IO.println_int64(0x7fffffffffffffff);
    // ... and integer past int64.
    IO.println_integer(0x10000000000000000);
  }

}
