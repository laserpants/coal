module Main {

  import IO(println_int32, println_bool, println_string, println_char)
  import Stream(type Stream, head)

  type List<a> 
    = Nil 
    | Cons(a, List<a>)

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    }

  fun take_head(s : Stream<int32>) : int32= 
    s |.head

  fun main() = 
    println_int32(1)

}
