module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  type List<a> 
    = Nil 
    | Cons(a, List<a>)

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    }

  cotype Stream = { Head : int32, Tail : Stream }

  fun take_head(s) = 
    s.Head

  fun main() = 
    println_int32(1)

}
