  //

  fun digit_to_int32(ch) : Option<int32> =
    match(ch) {
      | '0' => Some(0)
      | '1' => Some(1)
      | '2' => Some(2)
      | '3' => Some(3)
      | '4' => Some(4)
      | '5' => Some(5)
      | '6' => Some(6)
      | '7' => Some(7)
      | '8' => Some(8)
      | '9' => Some(9)
      | _ => None
    }

  fun parse_unsigned(str : string) : Option<int32> =
    let 
      chars = 
        to_list(str)
      in
        fold(chars, Some(0)) {
          | ch :: @go =>
              fn(t) =>
                match(digit_to_int32(ch)) {
                  | Some(n) =>
                      go(map(fn(s) => n + 10 * s, t))
                  | None =>
                      None
                }
          | [] =>
              fn(t) => t
        }

}
