  type alias MapFields<key, val> =
    { key    : key
    , value  : val
    , height : int32
    , left   : Map<key, val>
    , right  : Map<key, val> 
    }

  type Map<key, val> = Empty | Map(MapFields<key, val>)

  fun lookup(key, map) =
    match(map) {
      | Empty =>
          None

      | Map({ key = hello | _ } as m) =>
          None
    }

