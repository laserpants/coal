module Main {

  trait Functor(f : * -> *) {
    map : (a -> b) -> f(a) -> f(b) 
  }

  instance Functor(List) {
    fun map(f, xs) =
      fold(xs) {
        | [] => []
        | head :: @tail => f(head) :: tail
      };
  }

  instance Functor(Option) {
    fun map(f, opt) =
      match(opt) {
        | None => None
        | Some(x) => Some(f(x))
      };
  }

  trait Applicative(f : * -> *) {
    mapf : f(a -> b) -> f(a) -> f(b);
    pure : a -> f(a)
  }

  trait Monad(m : * -> *) {
    bind : m(a) -> (a -> m(b)) -> m(b)
  }

  fun main() =
    let
      xs = 
        map(fn(x) => x + 1, [1 : int32, 2, 3])
      in
        let
          o =
            map(fn(x) => x + 1, Some(5))
          in
            match(xs) {
              | [] =>
                  trace_int32(-1)
              | x :: _ =>
                  match(o) {
                    | None =>
                        trace_int32(-1)
                    | Some(y) =>
                        trace_int32(y)
                  }
            };
}
