module Main {

  import IO(println_string, println_int32, println_bool)

  cotype Counter = { Current : int32, Next : Counter }

  unfold count_from(n : int32) : Counter {
    , Current = n
    , @Next = n + 1
  }

  unfold counter_map(f : int32 -> int32, c : Counter) : Counter {
    , Current = f(c.Current)
    , @Next = (f, c.Next)
  }

  let counter : Counter = count_from(1)

  let counter_2 = counter_map(fn(x) => x + 1, counter)

  fun main() =
    println_int32(counter_2.Next.Current)

}
