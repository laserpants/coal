module Main {

  import Qsort(sort)

  fun print_1st(xs) =
    match(xs) {
      | x :: _ => IO.println_int32(x)
      | _ => IO.println_int32(-1)
    }

  fun print_2nd(xs) =
    match(xs) {
      | _ :: x :: _ => IO.println_int32(x)
      | _ => IO.println_int32(-1)
    }

  fun main() = 
    let sorted = sort([
      4, 
      34,
      8, 
      99,
      5, 
      102,
      42,
      7, 
      2, 
      1, 
      103,
      3, 
      6
    ]) 
    in 
      do {
        print_1st(sorted) ;
        print_2nd(sorted) ;
        return() ;
      }

}
