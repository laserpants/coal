module Main {

  type Date = Date({ year : int32, month : int32, day : int32 })

  instance Ordered<Date> {
    let compare =
      fn(d1, d2) =>
        EqualTo
  }

  type Tree<a>
    = Node(a, Tree<a>, Tree<a>)
    | Leaf

  fun less_than_or_equal_to(m) =
    fn(n) =>
      match(compare(m, n)) {
        | LessThan or EqualTo =>
            true
        | GreaterThan =>
            false
      }

  fun greater_than(n) =
    not << less_than_or_equal_to(n)

  fun in_range(range, n) =
    greater_than(n, range.min) 
      && (less_than_or_equal_to(n, range.max) || less_than_or_equal_to(range.max, -1))

  fun from_list(list) =
    fold(list, { min = 0, max = -1 }) {
      | (p :: @g) =>
          fn(range) =>
            if (p |. in_range(range))
              then 
                Node
                  ( p
                  , g({ min = range.min, max = p })
                  , g({ min = p, max = range.max })
                  )
              else
                g(range)
      | [] =>
          always(Leaf)
    }

  fun flatten(tree) = 
    fold(tree) {
      | Node(y, @lhs, @rhs) =>
          lhs ++ (y :: rhs)
      | Leaf =>
          []
    }

  let sort = flatten << from_list

  fun main() = 
    let
      dates =
        [] : list<Date>
      in
        trace_int32(match(sort(dates)) {
          | [] =>
              0
          | (date :: _) =>
              match(date) {
                | Date({ year = y, month = m, day = d }) =>
                    y
              }
        })
}
