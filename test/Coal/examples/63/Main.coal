module Main {

  fun fold_list(f : a -> b -> b, xs : List<a>, x : b) =
    fold(xs, x) {
      | [] =>
          fn(a) => f(x, a)
      | n :: @next as ns =>
          fn(a) => next(f(n, a))
    }

  fun main() = 
    let
      z =
        fold_list(fn(a, b) => a * b, [2, 3, 4, 5], 1)
      in
        trace_int32(z)
}
