module Main {

  trait Show<a> {
    show : a -> string
  }

  instance Show<string> {
    fun show(s) = s
  }

  instance Show<List<a>> {
    fun show(list) =
      fold(list) {
        | [] => ""
        | show(@s) :: xs => s
      }
  }

  let some_list = ["a", "b", "c"]

  fun main() = 
    trace_string(show(some_list))

}
