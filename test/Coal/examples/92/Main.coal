module Main {

  trait Show<a> {
    show : a -> string
  }

  instance Show<string> {
    fun show(s) = s
  }

  instance Show<List<a>> with Show<a> {  // as item 
    fun show(list) =
      fold(list) {
        | [] => ""
//        | x :: xs => show(x)   // item.show(x)
        | x :: xs => "BAZ"   // item.show(x)
      }
  }

  let some_list = ["a", "b", "c"]

  fun main() = 
    trace_string(show(some_list))

}
