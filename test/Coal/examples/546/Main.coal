module Main {

  import namespace IO

  import IO(println_string)
  import Coal.Monad.Free(interpret)
  import FreeResult(in_FreeResultT)
  import Sql(Sql, SqlValue, Column, Row, SqlError, sql_error_to_string, build_query)
  import SqlCodec(account_id_to_value, decode_amount)
  import DbError(DbError)
  import Database(
    Database,
    DatabaseF,
    execute,
    query_one,
    begin_transaction,
    commit,
    rollback,
    throw_db_error,
    with_transaction
  )
  import BankingGrammar(
    AccountId,
    Amount,
    Transaction,
    BankingError,
    BankingF,
    Banking,
    error_to_string,
    get_balance,
    debit,
    credit,
    record_transaction,
    throw_error
  )

  /**
   * The banking program: the domain grammar. It describes the business rule
   * for a transfer without mentioning SQL, transactions or IO.
   */
  fun bank_transfer({ from, to, amount }) : Banking<unit> = do {
    balance <- get_balance(from);
    if (balance >= amount) then do {
      debit(from, amount);
      credit(to, amount);
      record_transaction(Transaction(from, to, amount));
    } else do {
      throw_error(InsufficientFunds);
    };
  }

  // --- Banking -> Database translation -------------------------------------

  /**
   * Translate each banking instruction into SQL operations.
   *
   * This handler never constructs a `BankingError`: a failed row decode is a
   * `DecodeFailure` (a database concern), and the domain's own errors are
   * carried separately (see `run_banking`).
   */
  fun db_banking_handler : BankingF<Database<a>> -> Database<a>
    | GetBalance(account_id, g) => do {
        row <- query_one(
          Sql("SELECT balance FROM accounts WHERE account_id = ?"),
          [account_id_to_value(account_id)]
        );
        match(decode_amount(row)) {
          | Ok(amount) => g(Ok(amount))
          | Err(msg)   => throw_db_error(DecodeFailure(msg))
        };
      }
    | Debit(account_id, Amount(amount), g) => do {
        execute(
          Sql("UPDATE accounts SET balance = balance - ? WHERE account_id = ?"),
          [SqlInt(amount), account_id_to_value(account_id)]
        );
        g(Ok());
      }
    | Credit(account_id, Amount(amount), g) => do {
        execute(
          Sql("UPDATE accounts SET balance = balance + ? WHERE account_id = ?"),
          [SqlInt(amount), account_id_to_value(account_id)]
        );
        g(Ok());
      }
    | RecordTransaction(transaction, a) => do {
        a;
      }

  /**
   * Run a banking program, merging its (value-position) banking error into the
   * database error channel. Afterwards the whole application has a single
   * error type, `DbError`.
   */
  fun run_banking(program : Banking<a>) : Database<a> = do {
    r <- interpret(db_banking_handler, in_FreeResultT(program));
    match(r) {
      | Ok(value)        => pure(value)
      | Err(banking_err) => throw_db_error(DomainFailure(banking_err))
    };
  }

  // --- Database -> IO interpreter ------------------------------------------

  /**
   * A stand-in for a real database driver: it prints the statements it is
   * asked to run and returns canned rows. A production interpreter would call
   * into the SQL runtime instead.
   */
  fun io_db_handler : DatabaseF<IO<a>> -> IO<a>
    | Execute(sql, params, g) =>
        match(build_query(sql, params)) {
          | Ok(text) => do {
              println_string(text);
              g(Ok());
            }
          | Err(msg) => g(Err(ParameterError(msg)))
        }
    | QueryOne(sql, params, g) =>
        match(build_query(sql, params)) {
          | Ok(text) => do {
              println_string(text);
              g(Ok(Row([(Column("balance"), SqlInt(20000))])));
            }
          | Err(msg) => g(Err(ParameterError(msg)))
        }
    | BeginTransaction(g) => do {
        println_string("BeginTransaction");
        g(Ok());
      }
    | Commit(g) => do {
        println_string("Commit");
        g(Ok());
      }
    | Rollback(g) => do {
        println_string("Rollback");
        g(Ok());
      }

  fun main() = do {
    res <- bank_transfer({ from = AccountId("a"), to = AccountId("b"), amount = Amount(10000) })
      |. run_banking
      |. with_transaction
      |. in_FreeResultT |. interpret(io_db_handler);

    match(res) {
      | Ok(_)                           => println_string("ok")
      | Err(DomainFailure(banking_err)) => println_string(error_to_string(banking_err))
      | Err(SqlFailure(sql_err))        => println_string(sql_error_to_string(sql_err))
      | Err(DecodeFailure(msg))         => println_string(msg)
      | Err(ParameterError(msg))        => println_string(msg)
    };
  }

}
