module Db {

  import Coal.Functor(Functor)
  import Coal.Monad.Free(Free, lift_free)
  import FreeResult(FreeResultT, in_FreeResultT, lift_result, try)
  import Sql(Sql, Params, SqlRow)
  import DbError(DbError)

  /**
   * The SQL instruction set.
   *
   * Each constructor describes one database action and carries a continuation
   * that consumes the action's result. Transaction control is expressed as
   * instructions too, so that the interpreter (not the domain code) decides
   * how to run them; and each of them can fail, so a failing `commit` is
   * representable.
   */
  type DbF<a>
    = Execute(Sql, Params, Result<DbError, unit> -> a)
    | QueryOne(Sql, Params, Result<DbError, Option<SqlRow>> -> a)
    | BeginTransaction(Result<DbError, unit> -> a)
    | Commit(Result<DbError, unit> -> a)
    | Rollback(Result<DbError, unit> -> a)

  instance Functor<DbF> {
    fun map(f) = match{
      | Execute(sql, params, g)  => Execute(sql, params, f << g)
      | QueryOne(sql, params, g) => QueryOne(sql, params, f << g)
      | BeginTransaction(g)      => BeginTransaction(f << g)
      | Commit(g)                => Commit(f << g)
      | Rollback(g)              => Rollback(f << g)
    }
  }

  /** A program in the database monad: one error channel, `DbError`. */
  type alias Db<a> = FreeResultT<DbF, DbError, a>

  fun execute(sql, params)   = FreeResultT(lift_free(Execute(sql, params, fn(b) => b)))
  fun query_one(sql, params) = FreeResultT(lift_free(QueryOne(sql, params, fn(b) => b)))

  let begin_transaction = FreeResultT(lift_free(BeginTransaction(fn(b) => b)))
  let commit            = FreeResultT(lift_free(Commit(fn(b) => b)))
  let rollback          = FreeResultT(lift_free(Rollback(fn(b) => b)))

  /**
   * Abort the surrounding program with `err`.
   *
   * **Type**: `throw_db_error : DbError -> Db<a>`
   */
  fun throw_db_error(err : DbError) : Db<a> =
    lift_result(Err(err))

  /**
   * Run `p` inside a transaction: commit on success, roll back on failure.
   *
   * This is the single place where the error channel is reified into the value
   * position (`try`), so that the transaction bracket can observe the outcome.
   *
   * **Type**: `with_transaction : Db<a> -> Db<a>`
   */
  fun with_transaction(p : Db<a>) : Db<a> = do {
    begin_transaction;
    outcome <- try(p);
    match(outcome) {
      | Ok(value) => do {
          commit;
          pure(value);
        }
      | Err(err) => do {
          rollback;
          throw_db_error(err);
        }
    };
  }

}
