module FreeResult {

  import Coal.Monad.Free(Free)
  import Coal.Functor(Functor)

  type FreeResultT<f, e, a> = FreeResultT(Free<f, Result<e, a>>)

  fun in_FreeResultT(FreeResultT(r)) = r

  let lift_result = FreeResultT << Pure

  instance Functor<FreeResultT<f, e>> {
    // map : (a -> b) -> FreeResultT<f, e, a> -> FreeResultT<f, e, b>
    fun map(f, FreeResultT(r)) = FreeResultT(map(map(f), r))
  }

  instance Applicative<FreeResultT<f, e>> {
    // pure : a -> FreeResultT<f, e, a>
    fun pure(r) = FreeResultT(Pure(Ok(r)))
    // ap : FreeResultT<f, e, a -> b> -> FreeResultT<f, e, a> -> FreeResultT<f, e, b>
    fun ap(FreeResultT(ff), FreeResultT(fa)) =
      FreeResultT(
        bind(ff, match{
          | Err(err) =>
              pure(Err(err))
          | Ok(f) =>
              bind(fa, match{
                | Err(err) =>
                    pure(Err(err))
                | Ok(a) =>
                    pure(Ok(f(a)))
              }
            )
          }
        )
      )
    }

  instance Monad<FreeResultT<f, e>> {
    // bind : FreeResultT<f, e, a> -> (a -> FreeResultT<f, e, b>) -> FreeResultT<f, e, b>
    fun bind(FreeResultT(program), f) =
      FreeResultT(
        bind(program, match{
          | Ok(value) => in_FreeResultT(f(value))
          | Err(err)  => pure(Err(err))
        })
      )
  }

  /**
   * Reify the error channel into the value position.
   *
   * A computation that would have failed with `Err(err)` instead yields
   * `Err(err)` as an ordinary value, so the caller can inspect it (e.g. to
   * decide whether to roll back) rather than have it short-circuit the
   * surrounding `do` block. Mapping `Ok` over the underlying free program
   * reaches every `Pure` node, since errors are always represented there.
   *
   * **Type**: `try : FreeResultT<f, e, a> -> FreeResultT<f, e, Result<e, a>> with (Functor<f>)`
   */
  fun try(p : FreeResultT<f, e, a>) : FreeResultT<f, e, Result<e, a>> with (Functor<f>) =
    FreeResultT(map(Ok, in_FreeResultT(p)))

}
