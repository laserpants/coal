module Main {

  type Struct
    = A(Struct)
    | B(List<Struct>)

  fun fold_struct(s : Struct) =
    fold on_struct(s) {
      | A(on_struct(@x)) => x
      | B(xs) => 
          fold on_list(xs) {
            | [] => "a"
            | on_struct(@x) :: on_list(@xs) => x +++ xs
          }
    };

  let my_struct = 
    A(B([B([])]));

  fun main() =
    trace_string(fold_struct(my_struct));

}
