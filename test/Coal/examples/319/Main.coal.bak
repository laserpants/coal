module Main {

  import Containers.Set(Set, empty, insert, is_member, size, union)
  import namespace IO

  fun main() =
    let s1 = insert(1, empty) in
    let s2 = insert(2, insert(3, empty)) in
    let u = union(s1, s2) in
    let value1 = is_member(1, u) in
    let value2 = is_member(1, u) in
    let value3 = size(u) == 3 in
    let value4 = value1 && value2 in
    let value5 = value3 && value4 in
    let v7 = value4 
    in 
      IO.println_bool(v7)

}
