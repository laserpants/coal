module Main {

  import namespace IO
  import Codata.Stream(Stream, enum_from, tail, head)

  let foo = enum_from(0)

  let baz = filter(
    fn(x) =>
      match(x % 2) {
        | Some(r) => r == 0
        | None    => false
      },
    foo
  )

  fun main() = 
    IO.println_int32(foo |. tail |. tail |. tail |. tail |. head)

}