module Main {

  import namespace IO

  import IO(return)
  import Coal.Functor(Functor)
  import List(concat_map)
  import Coal.Applicative(Applicative)
  import Coal.Monad(Monad, and_then, and_always, and_return) 
  import Coal.Monad.Free(Free, lift_free, interpret)

  type ProductId = ProductId(int32)

  type alias Product = { id : ProductId }

  type OrderId = OrderId(int32)

  type alias Quantity = nat

  type alias OrderItem = { product : Product, quantity : Quantity }

  type alias Order = { id : OrderId, items: List<OrderItem> }

  type CustomerId = CustomerId(int32)

  type Message = Message(string)

  type OrderWorkflow<a>
    = GetOrder(OrderId, Order -> a)
    | CheckInventory(ProductId, Quantity, bool -> a)
    | NotifyCustomer(CustomerId, Message, a)

  instance Functor<OrderWorkflow> {
    fun map(f) =
      match{
        | GetOrder(order_id, g) => 
            GetOrder(order_id, f << g)
        | CheckInventory(product_id, qty, g) => 
            CheckInventory(product_id, qty, f << g)
        | NotifyCustomer(customer_id, message, a) => 
            NotifyCustomer(customer_id, message, f(a))
      }
  }

  fun get_order(order_id) = lift_free(GetOrder(order_id, fn(o) => o))

  fun check_inventory(product_id, qty) = lift_free(CheckInventory(product_id, qty, fn(b) => b))

  //

  fun check_item_availability(item : OrderItem) : Free<OrderWorkflow, List<OrderItem>> = do {
    available <- check_inventory(item.product.id, item.quantity);
    if (! available) 
      then pure([item])
      else pure([]);
  }

  let my_program : Free<OrderWorkflow, Order> = do {
    order <- get_order(OrderId(5));

//    let xs = concat_map(check_item_availability, order.items)
//    in
//    pure(());
    

//    available <- check_inventory(order.product.id, 4);

    pure(order);
  }

