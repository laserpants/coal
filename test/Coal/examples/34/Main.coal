module Main {

  trait JsonSerializable(a) {
    to_json : a -> string
  }

  instance JsonSerializable(int32) {
    to_json = int32_to_string;
  }

  instance JsonSerializable({ uid : int32 }) {
    to_json = fn(s) => to_json(s.uid);
  }

  fun zzz(s) = to_json(s.uid);

  a_test_user = { uid = 111 : int32 };

  fun main() = 
    let
      a = 
         trace_string(to_json(a_test_user))
       in
         trace_string(zzz(a_test_user));
}
