module Main {

  cotype Stream<a> = { Head : a, Tail : Stream<a> }

  fun get_head(s : Stream<a>) : a = 
    s.Head

  fun get_tail(s : Stream<a>) : Stream<a> =
    s.Tail

  unfold nats_from(n : int32) : Stream<int32>  
    { Head = n
    , Tail = nats_from(n + 1)
    }

  let nats = nats_from(0) : Stream<int32>

  //

  unfold evens_from(n : int32) : Stream<int32>
    { Head = n
    , Tail = odds_from(n + 1)
    }

  unfold odds_from(n : int32) : Stream<int32>
    { Head = n
    , Tail = evens_from(n + 1)
    }

}
