module Main {

  import namespace IO

  trait A<a> {
    a : a -> int32
  }

  trait B<a> with (A<a>) {
    b : a -> int32
  }

  trait C<a> with (B<a>) {
    c : a -> int32
  }

  instance A<int32> {
    fun a(x) = x
  }

  // `instance B<int32>` is missing, so `instance C<int32>` cannot be justified
  // even though its own methods are complete.
  instance C<int32> {
    fun c(x) = x
  }

  fun main() =
    IO.println_string("!")

}
