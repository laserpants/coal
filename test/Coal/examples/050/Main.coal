module Main {

  fun fold_list(f : a -> b -> b, xs : List<a>, x : b) =
    fold(xs, x) {
      | [] =>
          fn(r) => r
      | n :: @go =>
          fn(r) => go(f(n, r))
    }

  fun product(nums : List<int32>) : int32 =
    match(nums) {
      | [] =>
          1
      | x :: xs =>
          fold_list(fn(a, b) => a * b, xs, x)
    }

  fun enum_to(n : int32) : List<int32> =
    fold(pack_nat(n)) {
      | Zero =>
          []
      | Succ(@next) as m =>
          next ++ [unpack_nat(m)]
    }

  fun factorial(n : int32) =
    product(enum_to(n))  // product of numbers 1, 2, ..., n

  fun main() = 
    trace_int32(factorial(6))
}
