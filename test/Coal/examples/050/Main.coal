module Main {

  import IO(println_int64, println_bool, println_string, println_char)
  import Nat(pack, unpack)

  fun fold_list(f : a -> b -> b, xs : List<a>, x : b) =
    fold(xs, x) {
      | [] =>
          fn(r) => r
      | n :: @go =>
          fn(r) => go(f(n, r))
    }

  fun product(nums : List<int64>) : int64 =
    match(nums) {
      | [] =>
          1
      | x :: xs =>
          fold_list(fn(a, b) => a * b, xs, x)
    }

  fun enum_to(n : int64) : List<int64> =
    fold(pack(n)) {
      | Zero =>
          []
      | Succ(@next) as m =>
          next ++ [unpack(m)]
    }

  fun factorial(n : int64) =
    product(enum_to(n))  // product of numbers 1, 2, ..., n

  fun main() = 
    println_int64(factorial(6))
}
