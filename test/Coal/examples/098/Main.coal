module Main {

  import IO(println_string, println_int32, println_bool)
  import Codata.Machine(machine, receive, observe, map_machine)
  import Coal.Combinators(identity)

  type alias Counter = Machine<int32, int32>

  fun counter() : Counter =
    machine(1, fn(s, n) => s + n, identity)

  let counter_2 = map_machine(fn(x) => x * 1103515245 + 12345, counter())

  let increment = receive

  let next = increment(1)

  let current = observe

  let 
    example = 
      counter_2
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.current

  fun main() =
    println_int32(example)

}
