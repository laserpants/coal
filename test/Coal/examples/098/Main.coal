module Main {

  import IO(println_string, println_int32, println_bool)
  import Process(process, receive, observe, map_process)

  type alias Counter = Process<int32, int32>

  fun counter() : Counter =
    process(1, fn(s, n) => s + n)

  let counter_2 = map_process(fn(x) => x * 1103515245 + 12345, counter())

  let increment = receive

  let next = increment(1)

  let current = observe

  let 
    example = 
      counter_2
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.next
        |.current

  fun main() =
    println_int32(example)

}
