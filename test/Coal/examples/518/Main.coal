module Main {

  import namespace IO
  import Coal.Functor(Functor)
  import Coal.Applicative(Applicative)

  trait Unpack<a> {
    open : a -> { name : string, id : int32 }
    close : int32 -> a
  }

  type User = User({ name : string, id : int32 })

  instance Unpack<User> {
    fun open(User(user)) = user
  }

