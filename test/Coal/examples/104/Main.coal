  unfold enum_from(n : int32) : Stream<int32> { 
    , Head = n
    , enum_from(Tail) = @(n + 1)
  }

  fun baz(n : int32) =
    { head = fn(_) => n
    , tail = fn(_) => baz(n)
    } 

  fun main() = 
    //trace_int32((enum_from(0).Tail).Head)
    trace_int32((enum_from(0).Tail).Head)

}
