module Main {

  type JsonValue
    = JsonNull
    | JsonBool(bool)
    | JsonNumber(double)
    | JsonString(string)
    | JsonArray(List<JsonValue>)
    | JsonObject(List<(string, JsonValue)>)

  fold encode_json_value : JsonValue -> string {
    | JsonNull => "null"
    | JsonBool(false) => "false"
    | JsonBool(true) => "true"
    | JsonNumber(d) => "TODO"
    | JsonString(str) => "\"" +++ str +++ "\""
    | JsonArray(encode_json_array(@values)) => "[" +++ values +++ "]"
    | JsonObject(encode_json_object(@key_value_pairs)) => "{" +++ key_value_pairs +++ "}"
  }

  fold encode_json_array : List<JsonValue> -> string {
    | [] => ""
    | encode_json_value(@value) :: encode_json_array(@values) => 
        value +++ "," +++ values
  }

  fold encode_json_object : List<(string, JsonValue)> -> string {
    | [] => ""
    | (key, encode_json_value(@value)) :: encode_json_object(@pairs) => 
        key +++ ":" +++ value +++ "," +++ pairs
  }

  fun encode_json(value : JsonValue) = encode_json_value(value)

  let test_obj : JsonValue = 
    JsonObject(
      [ ("abc", JsonArray([JsonString("a"), JsonString("b"), JsonString("c")]))
      , ("pi", JsonNumber(3.14159))
      ])

  fun main() =
    trace_string(encode_json(test_obj))

}
