module Main {

  import IO(println_string)
  import Containers.Set(type Set)
  import namespace Containers.Set

  // ... see 269

  fun main() =
    println_string("!")

  type Shape 
    = ShapeI
    | ShapeO
    | ShapeT
    | ShapeS
    | ShapeZ
    | ShapeJ
    | ShapeL

  type Rotation
    = Rot0
    | Rot90
    | Rot180
    | Rot270

  type Board = Board(Set<(int32, int32)>)

  type Move
    = MoveLeft
    | MoveRight
    | MoveDown
    | Rotate

  type Event
    = KeyLeft
    | KeyRight
    | KeyDown
    | KeyUp
    | Tick

  fun interpretEvent : Event -> Move 
    | KeyLeft         = MoveLeft
    | KeyRight        = MoveRight
    | KeyUp           = Rotate
    | KeyDown or Tick = MoveDown

}
