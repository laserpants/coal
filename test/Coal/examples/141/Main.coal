module Main {

  cotype Counter = { Current : int32, Next : Counter }

  // bug when removing type annotation
  unfold count_from(n) : Counter {
    , Current = n
    , @Next = n + 1
  }

  unfold counter_map(f : int32 -> int32, c : Counter) : Counter {
    , Current = f(c.Current)
    , @Next = (f, c.Next)
  }

  let counter : Counter = count_from(1)

  //let counter_2 = counter_map(fn(x) => x * 1103515245 + 12345, counter)
  let counter_2 = counter_map(fn(x) => x + 1000, counter)

  fun main() =
    trace_int32(counter_2.Next.Next.Next.Next.Next.Next.Next.Current)

}
