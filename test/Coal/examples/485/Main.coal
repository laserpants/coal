module Main {

  import namespace IO
  import IO(return)
  import Coal.Functor(Functor)
  import Coal.Monad(and_then, and_eval)
  import Coal.Monad.Free(Free)

  type LangF<a>
    = WriteLn(string, a)
    | ReadLn(string -> a)

  instance Functor<LangF> {
    fun map(f) = 
      match{
        | WriteLn(str, x) => WriteLn(str, f(x))
//        | ReadLn(g) => ReadLn(f << g)
        | ReadLn(g) => ReadLn(fn(x) => g(f(x)))
      }
  }

  fun lift_free(e : f<a>) : Free<f, a> with (Functor<f>) =
    Free(map(pure, e))

  let my_program : Free<LangF, int32> =
    lift_free(WriteLn("Enter your name", ()))
      |. and_eval(lift_free(WriteLn("baz", ())))
      |. and_eval(lift_free(ReadLn(fn(s) => s)))
      |. and_then(fn(s) => lift_free(WriteLn("Hello " <> s, ())))
      |. and_eval(pure(0))

  type alias Handler<f, e, a> = f<e<a>> -> e<a>

  fun io_lang_handler(h : LangF<IO<a>>) : IO<a> =
    match(h) {
      | WriteLn(str, a) => do {
          IO.println_string(str);
          a;
        }
      | ReadLn(f) => do {
          s <- IO.readln();
          f(s);
        }
    }

  fun interpret(handler : Handler<f, e, a>, prog : Free<f, a>) : e<a> with (Monad<e>) =
    match(prog) {
      | Pure(val) => pure(val)
      | Free(ins) => handler(map(interpret(handler), ins))
    }

  fun main() =
    interpret(io_lang_handler, my_program)

}
