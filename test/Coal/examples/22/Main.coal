module Main {

  type User = User({ uid : int32, name : string })

  let a_user_named_bob = 
    User
      ({ name = "Alphonso"
       , uid = 1
       });

  fun get_user(user) = 
    match(user) {
      | User(o) =>
          o
    };

  fun main() =
    trace_string(get_user(a_user_named_bob).name);
}
