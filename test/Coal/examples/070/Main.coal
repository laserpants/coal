module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  cotype Stream<a> = { Head : a, Tail : Stream<a> }

  unfold enum_from(n : int32) : Stream<int32> { 
    , Head = n
    , @Tail = n + 1
  }

//  cotype OStream<a> = { Head : a, Tail : Option<OStream<a>> }
//
//  unfold enum_from(n : int32) : OStream<int32> { 
//    , Head = n
//    , @Tail = @Some(n + 1)
//  }

  fun main() = 
    println_int32(((enum_from(0).Tail).Tail).Head)

}
