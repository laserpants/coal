module Main {

  import namespace IO
  import Coal.Monad(trait Monad, and_then)
 
  trait Monoid<m> { // with Semigroup<m> { ??
    id : m
  }
 
  instance Monoid<List<a>> {
    let id = []
  }
  
  /* Reader */

  type Reader<r, a> = Reader(r -> a)

  fun run_reader(reader, env) =
    match(reader) {
      | Reader(f) => f(env)
    }

  fun pure_reader(x) = Reader(fn(_) => x)

  fun bind_reader(reader : Reader<r, a>, next : a -> Reader<r, b>) : Reader<r, b> = 
    match(reader) {
      | Reader(f) =>
          Reader(fn(env) =>
            let a = 
              f(env) 
            in
            match(next(a)) {
              | Reader(g) => g(env)
            }
          )
    }

  fun ask() = 
    Reader(fn(env) => env)

  instance Monad<Reader<r>> {
    let bind = bind_reader
  }

  fun test_reader(val : int32) = // : Reader<int32, int32> =
    ask()
      |. and_then(fn(r) => pure_reader(val + r))

