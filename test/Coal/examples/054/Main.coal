module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  fun main() =
    let
      extend = 
        fn(r) =>
          { name = "world" | r }
        in
          let 
            q = 
              extend({ baz = "hello" })
            in
              println_string(q.baz +++ " " +++ q.name)

}
