module Main {

  import IO(println_int32, println_string)
  import String(is_prefix_of, length, drop)
  import Coal.Combinators(snd)

//  Builtin type:
//
//  type Process<a, v> =
//    Process({ state : a, step : v -> a -> Process<a, v> })

  fun observe(Process({ state | _ }) : Process<a, v>) : a = 
    state

  fun receive(input : v, Process({ state, step }) : Process<a, v>) : Process<a, v> =
    step(input, state)

  fun process(seed : a, f : v -> a -> a) : Process<a, v> =
    process$_process(seed, f)

  fun map_process(f : a -> b, process : Process<a, v>) : Process<b, v> = 
    process$_map_process(f, process)

  fun contramap_input(f : w -> v, process : Process<a, v>) : Process<a, w> = 
    process$_contramap_input(f, process)

  fun zip_processes(p : Process<b, a>, q : Process<c, b>) : Process<(Process<b, a>, Process<c, b>), a> =
    let
      step(v, (source, sink)) =
        ( source 
            |.receive(v)
        , sink 
            |.receive(source |.observe) )
      in
        process((p, q), step)

  fun compose(p : Process<b, a>, q : Process<c, b>) : Process<c, a> =
    map_process(observe << snd, zip_processes(p, q))

  fun cons(state : a, process : Process<a, v>) : Process<a, v> =
    Process(
      { state = state
      , step = fn(_, _) => process
      })

  // Stream

  type alias Stream<a> = Process<a, unit>

  fun repeat(state : a) : Stream<a> =
    process(state, fn(_, _) => state)

  fun enum_from(n : int32) : Stream<int32> =
    process(n, fn(_, m) => m + 1)

  let nats : Stream<int32> = enum_from(0)

  let tail = receive()
  let head = observe

  // Parser

  type alias Parser = Process<(Option<string>, string), string>

  fun parse_string(str : string) : Parser =
    let
      step(input, state) =
        match(state) {
          | (Some(res), remain) 
              when (is_prefix_of(input, remain)) =>
                ( Some(res <> input)
                , drop(length(input), remain)
                )
              when (is_prefix_of(remain, input)) =>
                ( Some(res <> remain)
                , drop(length(remain), input)
                )
              otherwise =>
                state
          | _ =>
            state
        }
    in
    process((Some(""), str), step)

  // Game

  type Shape 
    = ShapeI
    | ShapeO
    | ShapeT
    | ShapeS
    | ShapeZ
    | ShapeJ
    | ShapeL

  type Rotation
    = R0
    | R90
    | R180
    | R270

  type Board = Board(Set<(int32, int32)>)

  type Move
    = MoveLeft
    | MoveRight
    | MoveDown
    | Rotate

  type Event
    = KeyLeft
    | KeyRight
    | KeyDown
    | KeyUp
//    | KeySpace
//    | KeyEsc
    | Tick

  fun interpret_event : Event -> Move 
    | KeyLeft         = MoveLeft
    | KeyRight        = MoveRight
    | KeyUp           = Rotate
    | KeyDown or Tick = MoveDown


  //

  let 
    xx =
      cons(5, cons(4, repeat(1)))

  let
    yy =
      map_process(fn(x) => x + 2, xx)

  let
    example1 =
      nats
        |.tail
        |.tail
        |.tail
        |.tail
        |.head // 4

  let
    example7 =
      (cons(3, cons(5, nats)))
        |.tail
        |.head // 5

  let
    example2 =
      parse_string("hello")
        |.receive("hellobob")
        |.observe // (Just "hello", "bob")

  let
    example5 =
      parse_string("hello")
        |.receive("he")
        |.receive("ll")
        |.observe // (Just "hell", "o")


  fun main() =
//    println_int32(observe(yy |.receive()))
//    println_int32(example7)

    match(example5) {
      | (Some(a), b) => println_string(a <> "," <> b)
      | _ => println_string("--")
    }

}
