/**
 * Regression test: an instance implementation that does not have the type its
 * trait requires at the instance's type must be rejected at compile time.
 *
 * `instance Ftor<f> with (FM<f>) { let fmap = mf }` is ill-typed: `mf` has
 * type `(a -> b) -> Free<f, a> -> Free<f, b>`, which is the type of `Ftor`'s
 * `fmap : (a -> b) -> f<a> -> f<b>` only if the instance head were
 * `Ftor<Free<f>>` rather than `Ftor<f>`.
 *
 * The compiler used to accept this and then emit a dictionary whose `fmap`
 * member had the arity of the trait interface, while the compiled member took
 * the `FM` dictionary as an extra parameter. Applying the dictionary therefore
 * read a non-existent argument, and `lift_free` segfaulted at run time.
 */
module Main {

  import IO(println_string)

  trait Ftor<f> {
    fmap : (a -> b) -> f<a> -> f<b>
  }

  type Free<f, a>
    = Pure(a)
    | Free(f<Free<f, a>>)

  fun pure_free(x : a) : Free<f, a> =
    Pure(x)

  fun lift_free(operation : f<a>) : Free<f, a> with (Ftor<f>) =
    Free(fmap(pure_free, operation))

  trait FM<f> {
    mf : (a -> b) -> Free<f, a> -> Free<f, b>
  }

  instance Ftor<f> with (FM<f>) {
    let fmap = mf
  }

  type Log<a> = Write(string, a)

  instance Ftor<Log> {
    fun fmap(f, instruction) =
      match(instruction) {
        | Write(message, result) => Write(message, f(result))
      }
  }

  fold mf_log : Free<Log, a> -> ((a -> b) -> Free<Log, b>)
    | Pure(x) => fn(g) => Pure(g(x))
    | Free(Write(message, mf_log(@next))) => fn(g) => Free(Write(message, next(g)))

  instance FM<Log> {
    fun mf(g, program) = mf_log(program)(g)
  }

  fun main() =
    let
      p = lift_free(Write("hi", ()))
    in
      match(p) {
        | Pure(_) => println_string("pure")
        | Free(_) => println_string("free")
      }

}
