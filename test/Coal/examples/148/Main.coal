module Main {

  import IO(println_int32)

  trait Equality<a> {
    equal : a -> a -> bool
    banan : a -> bool
  }

  type Answer = Yes | No

  instance Equality<Answer> {
    fun equal(x, y) =
      match((x, y)) {
        | (Yes, Yes) => true
        | (No, No)   => true
        | _          => false
      }

    fun banan(x) =
      true
  }

  fun equal2(x, y) =
    match((x, y)) {
      | (Yes, Yes) => true
      | (No, No)   => true
      | _          => false
    }

  let equalalias = equal

  fun main() =
    if (equalalias(Yes, No)) 
      then println_int32(1)
      else println_int32(224)

}
