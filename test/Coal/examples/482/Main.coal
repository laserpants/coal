/**
 * `map_free` is implemented at the kernel level (`Builtin$.free$_map_free`),
 * because mapping over `Free<f, a>` recurses under the functor layer, which
 * cannot be expressed as structural recursion in the surface language.
 *
 * This test maps over both constructors: a `Pure` program and a `Free`
 * program, so the recursive branch is exercised as well.
 */
module Main {

  import IO(println_int32)
  import Coal.Functor(Functor)
  import Coal.Monad.Free(Free, pure_free, map_free)

  type Box<a> = Box(a)

  instance Functor<Box> {
    fun map(f, Box(x)) = Box(f(x))
  }

  fun increment(x : int32) : int32 = x + 1

  // Collapse a free program to its result.
  fold run_program : Free<Box, int32> -> int32
    | Pure(x) => x
    | Free(Box(run_program(@next))) => next

  fun main() =
    let
      pure_program : Free<Box, int32> = pure_free(41)
    in
      let
        free_program : Free<Box, int32> = Free(Box(pure_program))
      in
        println_int32(run_program(map_free(increment, free_program)))

}
