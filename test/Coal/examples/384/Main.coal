module Main {

  import namespace IO
  import namespace Containers.Set

  import Containers.Set (Set)

  type Shape
    = ShapeI
    | ShapeO
    | ShapeT
    | ShapeS
    | ShapeZ
    | ShapeJ
    | ShapeL

  type Rotation
    = R0
    | R90
    | R180
    | R270

  fun spin
    | R0   => R90  
    | R90  => R180 
    | R180 => R270 
    | R270 => R0   

  fun shape_from_int(n : int32) : Shape =
    match(n % 6) {
      | 0 => ShapeI
      | 1 => ShapeO
      | 2 => ShapeT
      | 3 => ShapeS
      | 4 => ShapeZ
      | 5 => ShapeJ
      | _ => ShapeL
    }

  fun rotation_from_int(n : int32) : Rotation =
    match(n % 4) {
      | 0 => R0
      | 1 => R90
      | 2 => R180
      | _ => R270
    }

  type Event
    = KeyLeft
    | KeyRight
    | KeyDown
    | KeyUp
    | KeySpace
    | KeyEsc
    | Tick
    | NoOp

  type alias Block =
    { shape : Shape
    , rotation : Rotation
    , pos_x : int32
    , pos_y : int32
    }

  let initial_block : Block = 
    { shape = ShapeI
    , rotation = R0
    , pos_x = 0
    , pos_y = 0
    }

  // TODO
  fun random_block() =
    { shape = ShapeI
    , rotation = R0
    , pos_x = 0
    , pos_y = 0
    }

  type alias Board = Set<(int32, int32)>

  let empty_board : Board =
    []

  type alias GameState =
    { board : Board
    , current_block : Block
    }

  let initial_game_state : GameState =
    { board = empty_board
    , current_block = initial_block
    }

  fun shape_cells(shape : Shape, rotation : Rotation) : Set<(int32, int32)> =
    Containers.Set.from_list 
      .| match(shape) {
           | ShapeO =>
               //          
               //   - - - -
               //   - # # -
               //   - # # -
               //   - - - -
               [ (1, 1)
               , (2, 1)
               , (1, 2)
               , (2, 2)
               ]
           | ShapeI =>
               match(rotation) {
                 | R0 =>
                     //   - # - -
                     //   - # - -
                     //   - # - -
                     //   - # - -
                     [ (1, 0)
                     , (1, 1)
                     , (1, 2)
                     , (1, 3)
                     ]
                 | R90 =>
                     //   - - - -
                     //   # # # #
                     //   - - - -
                     //   - - - -
                     [ (0, 1)
                     , (1, 1)
                     , (2, 1)
                     , (3, 1)
                     ]
                 | R180 =>
                     //   - - # -
                     //   - - # -
                     //   - - # -
                     //   - - # -
                     [ (2, 0)
                     , (2, 1)
                     , (2, 2)
                     , (2, 3)
                     ]
                 | R270 =>
                     //   - - - -
                     //   - - - -
                     //   # # # #
                     //   - - - -
                     [ (0, 2)
                     , (1, 2)
                     , (2, 2)
                     , (3, 2)
                     ]
               }
           | ShapeT =>
               match(rotation) {
                 | R0 =>
                     //   - # - -
                     //   # # # -
                     //   - - - -
                     //   - - - -
                     [ (1, 0)
                     , (0, 1)
                     , (1, 1)
                     , (2, 1)
                     ]
                 | R90 =>
                     //   - - # -
                     //   - - # #
                     //   - - # -
                     //   - - - -
                     [ (2, 0)
                     , (2, 1)
                     , (3, 1)
                     , (2, 2)
                     ]
                 | R180 =>
                     //   - - - -
                     //   - - - -
                     //   - # # #
                     //   - - # -
                     [ (1, 2)
                     , (2, 2)
                     , (3, 2)
                     , (2, 3)
                     ]
                 | R270 =>
                     //   - - - -
                     //   - # - -
                     //   # # - -
                     //   - # - -
                     [ (1, 1)
                     , (0, 2)
                     , (1, 2)
                     , (1, 3)
                     ]
               }
           | ShapeS =>
               match(rotation) {
                 | R0 =>
                     //   # - - -
                     //   # # - -
                     //   - # - -
                     //   - - - -
                     [ (0, 0)
                     , (0, 1)
                     , (1, 1)
                     , (1, 2)
                     ]
                 | R90 =>
                     //   - - # #
                     //   - # # -
                     //   - - - -
                     //   - - - -
                     [ (2, 0)
                     , (3, 0)
                     , (1, 1)
                     , (2, 1)
                     ]
                 | R180 =>
                     //   - - - -
                     //   - - # -
                     //   - - # #
                     //   - - - #
                     [ (2, 1)
                     , (2, 2)
                     , (3, 2)
                     , (3, 3)
                     ]
                 | R270 =>
                     //   - - - -
                     //   - - - -
                     //   - # # -
                     //   # # - -
                     [ (1, 2)
                     , (2, 2)
                     , (0, 3)
                     , (1, 3)
                     ]
               }
           | ShapeZ =>
               match(rotation) {
                 | R0 =>
                     //   - # - -
                     //   # # - -
                     //   # - - -
                     //   - - - -
                     [ (1, 0)
                     , (0, 1)
                     , (1, 1)
                     , (0, 2)
                     ]
                 | R90 =>
                     //   - # # -
                     //   - - # #
                     //   - - - -
                     //   - - - -
                     [ (1, 0)
                     , (2, 0)
                     , (2, 1)
                     , (3, 1)
                     ]
                 | R180 =>
                     //   - - - -
                     //   - - - #
                     //   - - # #
                     //   - - # -
                     [ (3, 1)
                     , (2, 2)
                     , (3, 2)
                     , (2, 3)
                     ]
                 | R270 =>
                     //   - - - -
                     //   - - - -
                     //   # # - -
                     //   - # # -
                     [ (0, 2)
                     , (1, 2)
                     , (1, 3)
                     , (2, 3)
                     ]
               }
           | ShapeJ =>
               match(rotation) {
                 | R0 =>
                     //   - # # -
                     //   - # - -
                     //   - # - -
                     //   - - - -
                     [ (1, 0)
                     , (2, 0)
                     , (1, 1)
                     , (1, 2)
                     ]
                 | R90 =>
                     //   - - - -
                     //   - # # #
                     //   - - - #
                     //   - - - -
                     [ (1, 1)
                     , (2, 1)
                     , (3, 1)
                     , (3, 2)
                     ]
                 | R180 =>
                     //   - - - -
                     //   - - # -
                     //   - - # -
                     //   - # # -
                     [ (2, 1)
                     , (2, 2)
                     , (1, 3)
                     , (2, 3)
                     ]
                 | R270 =>
                     //   - - - -
                     //   # - - -
                     //   # # # -
                     //   - - - -
                     [ (0, 1)
                     , (0, 2)
                     , (1, 2)
                     , (2, 2)
                     ]
               }
           | ShapeL =>
               match(rotation) {
                 | R0 =>
                     //   # # - -
                     //   - # - -
                     //   - # - -
                     //   - - - -
                     [ (0, 0)
                     , (1, 0)
                     , (1, 1)
                     , (1, 2)
                     ]
                 | R90 =>
                     //   - - - #
                     //   - # # #
                     //   - - - -
                     //   - - - -
                     [ (3, 0)
                     , (1, 1)
                     , (2, 1)
                     , (3, 1)
                     ]
                 | R180 =>
                     //   - - - -
                     //   - - # -
                     //   - - # -
                     //   - - # #
                     [ (2, 1)
                     , (2, 2)
                     , (2, 3)
                     , (3, 3)
                     ]
                 | R270 =>
                     //   - - - -
                     //   - - - -
                     //   # # # -
                     //   # - - -
                     [ (0, 2)
                     , (1, 2)
                     , (2, 2)
                     , (0, 3)
                     ]
               }
      }


  // ---------------------------------------------------------------------------
  // Board API  
  // ---------------------------------------------------------------------------

  fun board_member(x : int32, y : int32, board : Board) : bool =
    false

  // ---------------------------------------------------------------------------
  // Collision detection
  // ---------------------------------------------------------------------------

  fun main() = 
    IO.println_string("abc")

}