module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  trait Functor<f : * -> *> {
    map : (a -> b) -> f<a> -> f<b>
  }

  instance Functor<List> {
    fun map(f, xs) =
      fold(xs) {
        | [] => []
        | head :: @tail => f(head) :: tail
      }
  }

  instance Functor<Option> {
    fun map(f, opt) =
      match(opt) {
        | None => None
        | Some(x) => Some(f(x))
      }
  }

  trait Applicative<f : * -> *> {
    fmap : f<a -> b> -> f<a> -> f<b>
    pure : a -> f<a>
  }

  trait Monad<m : * -> *> {
    bind : m<a> -> (a -> m<b>) -> m<b>
  }

  fun main() =
    let
      xs = 
        map(fn(x) => x + 1, [1 : int32, 2, 3])
      in
        let
          o =
            map(fn(x) => x + 1, Some(5 : int32))
          in
            match(xs) {
              | [] =>
                  println_int32(-1)
              | x :: _ =>
                  match(o) {
                    | None =>
                        println_int32(-1)
                    | Some(y) =>
                        println_int32(y)
                  }
            }
}
