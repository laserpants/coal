module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  type JsonValue
    = JsonNull
    | JsonBool(bool)
    | JsonNumber(double)
    | JsonString(string)
    | JsonArray(List<JsonValue>)
    | JsonObject(List<(string, JsonValue)>)

  fun main() =
    println_int32(123)

}
