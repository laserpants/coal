module Main {

  import Number(max)
  import namespace IO

  type Map = Empty | Map({ foo : int32 })

  fun example(map) =
    match(map) {
      | Map({ foo = n }) => 
          n
      | Empty => 
          0
    }

//    match(Map{ foo = 1, baz = 2, some = 3 }) {
//      | Map({ foo = n | z }) => 
//          n
//      | Map({ baz = b | y }) => 
//          n
//      | Empty => 
//          0
//    }

  fun main() = 
    IO.println_int32(example(Map({ foo = 5 })))

}
