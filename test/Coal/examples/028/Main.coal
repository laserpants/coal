module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  fun main() =
    let 
      chrs = 
        [] : List<char>
      in
        println_int32 
        (
            fold(chrs, 5 : int32) {
              | ch :: chs =>
                  fn(t) => 3
              | [] =>
                  fn(t) => 2
            }
        )

}
