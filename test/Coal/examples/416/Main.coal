  fun gork2 : List<V> -> string
    | [] => ""
    | y :: ys => let zzz = baz2(y) in ""

  fold baz2 : V -> string
    | A => "A"
    | B(xs) => let zzz = gork2(xs) in ""
*/

  fun main() =
    IO.println_string("!!")

}
