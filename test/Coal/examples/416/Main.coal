module Main {

  import namespace IO

  type V
    = A
    | B(List<V>)

  fold gork : List<V> -> string
    | [] => ""
    | ( baz(@v) as y ) :: gork(@vs) => let zzz = baz(y) in v <> vs

  fold baz : V -> string
    | A => "A"
    | B(gork(@vs) as xs) => let zzz = gork(xs) in vs

