module Main {

  type List<a> 
    = Nil 
    | Cons(a, List<a>)

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    }

  cotype Stream = { Head : int32, Tail : Stream }

  unfold(0) {
    , Head(n) = n
    , Tail(@s) = Some(s(n + 1))
    }

  cotype Cotree = { Node : int32, Left : Cotree, Right : Cotree }

  unfold(0) { 
    , Node(n) = n
    , Left(@s) = s(n + 1)
    , Right(@s) = s(n + 1)
  }

  cotype MStream = { Head : int32, Tail : Option<MStream> }

  unfold(0) { 
    , Head(n) = n
    , Tail(@s) = Some(s(n + 1))
  }

//  unfold nats(n) {
//    Head = n
//  , Tail = @Tail(n + 1)
//  }

  fun main() = 
    trace_int32(nats.Head)

}
