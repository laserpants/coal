module Main {

  type List<a> 
    = Nil 
    | Cons(a, List<a>)

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    }

  cotype MStream = { Head : int32, Tail : Option<MStream> }

  unfold my_stream(n : int32) : MStream { 
    , Head = n
    , Tail = Some(my_stream(n + 1))
  }

//  unfold nats(n) {
//    Head = n
//  , Tail = @Tail(n + 1)
//  }

  fun main() = 
    trace_int32(nats.Head)

}
