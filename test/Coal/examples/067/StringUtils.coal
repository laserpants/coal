module StringUtils {

  import IO(println_int32, println_bool, println_string, println_char)
  import List(reduce)

  fun intercalate(sep : string, strs : List<string>) : string =
    match(strs) {
      | [] => ""
      | head :: tail => head +++ reduce(fn(t, s) => s +++ sep +++ t, "", tail)
    }

}
