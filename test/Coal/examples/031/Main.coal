module Main {

  import IO(println_int32, println_bool, println_string, println_char)
  import String(int32_to_string)

  trait JsonSerializable<a> {
    to_json : a -> string
  }

  instance JsonSerializable<int32> {
    let to_json = int32_to_string
  }

  instance JsonSerializable<{ uid : int32 }> {
    let to_json = fn(s) => to_json(s.uid)
  }

  fun f(s) = to_json(s.uid)

  let a_test_user = { uid = 111 : int32 }

  fun main() = 
    let
      a = 
         println_string(to_json(a_test_user))
       in
         println_string(f(a_test_user))
}
