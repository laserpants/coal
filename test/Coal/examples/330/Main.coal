module Main {

  import namespace IO

  trait Associative<a> {
    combine : a -> a -> a
  }

  instance Associative<int32> {
    fun combine(x, y) = x + y
  }
 
   fun example3(x, y) =
     combine(x, y)
 
 //  ^^^
 //  this is OK, since the parameter a is implicit
 
  fun main() =
//    IO.println_int32(inverse(5))
    IO.println_int32(5)

}
