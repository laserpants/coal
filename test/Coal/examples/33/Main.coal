module Main {

  fun digit_to_int32(ch) : Option(int32) =
    match(ch) {
      | '0' => Some(0)
      | '1' => Some(1)
      | '2' => Some(2)
      | '3' => Some(3)
      | '4' => Some(4)
      | '5' => Some(5)
      | '6' => Some(6)
      | '7' => Some(7)
      | '8' => Some(8)
      | '9' => Some(9)
      | _ => None
    };

  fun map_option(f, opt) = 
    match(opt) {
      | None => 
          None
      | Some(val) =>
          Some(f(val))
    };

  fun is_empty(list) =
    match(list) {
      | [] => true
      | _ => false
    };

  /*
  fun digits_to_unsigned(chars) : Option(int32) 
    when is_empty(chars) = None
    otherwise =
      fold(chars, Some(0)) {
        // ...
      }
  */

  fun digits_to_unsigned(chars) : Option(int32) =
    if (is_empty(chars)) 
      then
        None
      else
        fold(chars, Some(0)) {
          | ch :: @go =>
              fn(t) =>
                match(digit_to_int32(ch)) {
                  | Some(n) =>
                      go(map_option(fn(s) => n + 10 * s, t))
                  | None =>
                      None
                }
          | [] =>
              fn(t) => t
        };

  fun parse_int32(str : string) : Option(int32) =
    let 
      chars = 
        string_to_list(string_remove_whitespace(str))
      in
        match(chars) {
          | '-' :: pos => 
              match(digits_to_unsigned(pos)) {
                | None =>
                    None
                | Some(p) =>
                    Some(0 - p)
              }
          | _ =>
              digits_to_unsigned(chars)
        };

  trait JsonSerializable(a) {
    to_json : a -> string;
    from_json : string -> Option(a)
  }

  instance JsonSerializable(int32) {
    let to_json = int32_to_string;
    let from_json = fn(_) => Some(1);
  }

  instance JsonSerializable({ name : string, uid : int32 }) {
    let to_json =
      fn(s) => to_json(s.uid); // "{ name = \"" +++ s.name +++ "\", uid = " +++ to_json(s.uid) +++ " }";
    let from_json =
      fn(d) => Some({ name = "TODO", uid = 1 });
  }

  let a_test_user = { name = "Luciano Pavarotti", uid = 111 : int32 };

  fun main() =
    trace_string(to_json(a_test_user));

    // trace_string(to_json(555 : int32));

