module Main {

  import IO(println_int32, println_bool, println_string, println_char)
  import String(to_list)

  fun main() =
    let
      chrs =
        to_list("xyz")
      in
        match(chrs) {
          | c :: _ =>
              println_char(c)
          | [] =>
              println_string("nope")
        }
}
