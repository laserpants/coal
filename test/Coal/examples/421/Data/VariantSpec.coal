module Data.VariantSpec(variant_spec) {

  import MicroTest(Test, suite, check)
  import Data.Variant(
    Variant,
    is_null,
    is_unit,
    is_bool,
    is_int32,
    is_int64,
    is_nat,
    is_bignum,
    is_float,
    is_double,
    is_char,
    is_string,
    is_array,
    is_object,
    is_map,
    is_bytes,
    is_datetime,
    as_bool,
    as_int32,
    as_int64,
    as_nat,
    as_bignum,
    as_float,
    as_double,
    as_char,
    as_string,
    as_array,
    as_object,
    as_map,
    as_bytes,
    as_datetime,
    uint8_to_int32
  )
  import Data.UInt8(of_int32)
  import DateTime
    ( Date(Date)
    , Time(Time)
    , DateTime(DateTime)
    , MonthOfYear(March, September)
    )
  import Pretty(Pretty)
  import namespace Containers.Map
  import namespace List
  import namespace Option

  // Datetime fixtures for the VDateTime tests
  let dt_base : DateTime =
    DateTime
      ({ date = Date({ year = 2026, month = September, day = 1 })
       , time = Time({ hour = 12, minute = 34, second = 56, nanosecond = 789 })
       })

  let dt_later_hour : DateTime =
    DateTime
      ({ date = Date({ year = 2026, month = September, day = 1 })
       , time = Time({ hour = 13, minute = 34, second = 56, nanosecond = 789 })
       })

  let dt_later_nanos : DateTime =
    DateTime
      ({ date = Date({ year = 2026, month = September, day = 1 })
       , time = Time({ hour = 12, minute = 34, second = 56, nanosecond = 790 })
       })

  let dt_earlier_year : DateTime =
    DateTime
      ({ date = Date({ year = 2025, month = September, day = 1 })
       , time = Time({ hour = 12, minute = 34, second = 56, nanosecond = 789 })
       })

  let dt_earlier_month : DateTime =
    DateTime
      ({ date = Date({ year = 2026, month = March, day = 1 })
       , time = Time({ hour = 12, minute = 34, second = 56, nanosecond = 789 })
       })

  fun variant_spec() : Test =
    suite([
      // Constructor predicates
      check(is_null(VNull)),
      check(!is_null(VUnit)),

      check(is_unit(VUnit)),
      check(!is_unit(VNull)),

      check(is_bool(VBool(true))),
      check(!is_bool(VInt32(1))),

      check(is_int32(VInt32(42))),
      check(!is_int32(VInt64(42))),

      check(is_int64(VInt64(42))),
      check(!is_int64(VInt32(42))),

      check(is_nat(VNat(42))),
      check(!is_nat(VInt32(42))),

      check(is_bignum(VBignum(123456789012345678901234567890))),
      check(!is_bignum(VInt32(42))),

      check(is_float(VFloat(1.5f))),
      check(!is_float(VDouble(1.5))),

      check(is_double(VDouble(3.14))),
      check(!is_double(VFloat(1.5f))),

      check(is_char(VChar('a'))),
      check(!is_char(VString("a"))),

      check(is_string(VString("hello"))),
      check(!is_string(VChar('a'))),

      check(is_array(VArray([]))),
      check(!is_array(VNull)),

      check(is_object(VObject(Containers.Map.empty))),
      check(!is_object(VArray([]))),

      // Type accessors
      check(as_bool(VBool(true)) == Some(true)),
      check(as_bool(VBool(false)) == Some(false)),
      check(as_bool(VNull) == None),

      check(as_int32(VInt32(42)) == Some(42)),
      check(as_int32(VInt64(42)) == None),

      check(as_int64(VInt64(42)) == Some(42)),
      check(as_int64(VInt32(42)) == None),

      check(as_nat(VNat(42)) == Some((42 : nat))),
      check(as_nat(VInt32(42)) == None),

      check(
        as_bignum(VBignum(123456789012345678901234567890))
          == Some(123456789012345678901234567890)
      ),
      check(as_bignum(VInt32(42)) == None),

      check(as_float(VFloat(1.5f)) == Some(1.5f)),
      check(as_float(VDouble(1.5)) == None),

      check(as_double(VDouble(3.14)) == Some(3.14)),
      check(as_double(VFloat(1.5f)) == None),

      check(as_char(VChar('a')) == Some('a')),
      check(as_char(VString("a")) == None),

      check(as_string(VString("hello")) == Some("hello")),
      check(as_string(VChar('a')) == None),

      check(as_array(VArray([VInt32(1), VString("x")])) == Some([VInt32(1), VString("x")])),
      check(as_array(VNull) == None),

      check(
        as_object(VObject(Containers.Map.singleton("a", VInt32(1))))
          == Some(Containers.Map.singleton("a", VInt32(1)))
      ),
      check(as_object(VArray([])) == None),

      check(is_map(VMap(Containers.Map.empty))),
      check(!is_map(VObject(Containers.Map.empty))),
      check(!is_map(VBytes([]))),

      check(is_bytes(VBytes([]))),
      check(is_bytes(VBytes([of_int32(1), of_int32(2)]))),
      check(!is_bytes(VArray([]))),
      check(!is_bytes(VMap(Containers.Map.empty))),

      check(
        as_map(VMap(Containers.Map.singleton(VString("a"), VInt32(1))))
          == Some(Containers.Map.singleton(VString("a"), VInt32(1)))
      ),
      check(Option.is_none(as_map(VObject(Containers.Map.empty)))),
      check(Option.is_none(as_map(VBytes([])))),

      check(
        List.map(uint8_to_int32, Option.with_default([], as_bytes(VBytes([of_int32(1), of_int32(2)]))))
          == [1, 2]
      ),
      check(Option.is_none(as_bytes(VArray([])))),
      check(Option.is_none(as_bytes(VMap(Containers.Map.empty)))),

      check(is_datetime(VDateTime(dt_base))),
      check(!is_datetime(VString("not a datetime"))),
      check(!is_datetime(VBytes([]))),
      check(!is_datetime(VNull)),

      check(Option.is_some(as_datetime(VDateTime(dt_base)))),
      check(Option.is_none(as_datetime(VNull))),
      check(Option.is_none(as_datetime(VString("not a datetime")))),

      // Comparable instance: equal scalar values
      check(VNull == VNull),
      check(VUnit == VUnit),
      check(VBool(true) == VBool(true)),
      check(VBool(false) == VBool(false)),
      check(VBool(true) != VBool(false)),
      check(VInt32(42) == VInt32(42)),
      check(VInt32(42) != VInt32(43)),
      check(VInt64(42) == VInt64(42)),
      check(VInt64(42) != VInt64(43)),
      check(VNat(42) == VNat(42)),
      check(VBignum(123456789012345678901234567890) == VBignum(123456789012345678901234567890)),
      check(VFloat(1.5f) == VFloat(1.5f)),
      check(VDouble(3.14) == VDouble(3.14)),
      check(VDouble(3.14) != VDouble(3.15)),
      check(VChar('a') == VChar('a')),
      check(VChar('a') != VChar('b')),
      check(VString("hello") == VString("hello")),
      check(VString("hello") != VString("world")),

      // Values of different constructors are never equal
      check(VNull != VUnit),
      check(VInt32(42) != VInt64(42)),
      check(VInt32(42) != VNat(42)),
      check(VFloat(1.5f) != VDouble(1.5)),
      check(VChar('a') != VString("a")),
      check(VArray([]) != VObject(Containers.Map.empty)),

      // Comparable instance: array equality
      check(VArray([]) == VArray([])),
      check(VArray([VInt32(1)]) == VArray([VInt32(1)])),
      check(VArray([VInt32(1), VInt32(2)]) == VArray([VInt32(1), VInt32(2)])),
      check(VArray([VNull, VBool(true)]) == VArray([VNull, VBool(true)])),
      check(VArray([VArray([VInt32(1)])]) == VArray([VArray([VInt32(1)])])),
      check(VArray([VInt32(1)]) != VArray([VInt32(2)])),
      check(VArray([VInt32(1), VInt32(2)]) != VArray([VInt32(2), VInt32(1)])),

      // Arrays with different lengths are not equal
      check(VArray([]) != VArray([VInt32(1)])),
      check(VArray([VInt32(1)]) != VArray([VInt32(1), VInt32(2)])),
      check(VArray([VInt32(1), VInt32(2)]) != VArray([VInt32(1)])),

      // Comparable instance: object equality is order-independent
      check(VObject(Containers.Map.empty) == VObject(Containers.Map.empty)),
      check(
        VObject(Containers.Map.singleton("a", VInt32(1)))
          == VObject(Containers.Map.singleton("a", VInt32(1)))
      ),
      check(
        VObject(Containers.Map.from_list([("a", VInt32(1)), ("b", VInt32(2))]))
          == VObject(Containers.Map.from_list([("b", VInt32(2)), ("a", VInt32(1))]))
      ),
      check(
        VObject(Containers.Map.from_list([("a", VInt32(1)), ("b", VInt32(2)), ("c", VInt32(3))]))
          == VObject(Containers.Map.from_list([("c", VInt32(3)), ("b", VInt32(2)), ("a", VInt32(1))]))
      ),
      check(
        VObject(Containers.Map.singleton("a", VArray([VInt32(1), VInt32(2)])))
          == VObject(Containers.Map.singleton("a", VArray([VInt32(1), VInt32(2)])))
      ),
      check(
        VObject(Containers.Map.singleton("a", VInt32(1)))
          != VObject(Containers.Map.singleton("a", VInt32(2)))
      ),
      check(
        VObject(Containers.Map.singleton("a", VInt32(1)))
          != VObject(Containers.Map.singleton("b", VInt32(1)))
      ),

      // Objects with different numbers of entries are not equal
      check(
        VObject(Containers.Map.empty)
          != VObject(Containers.Map.singleton("a", VInt32(1)))
      ),
      check(
        VObject(Containers.Map.singleton("a", VInt32(1)))
          != VObject(Containers.Map.empty)
      ),
      check(
        VObject(Containers.Map.singleton("a", VInt32(1)))
          != VObject(Containers.Map.from_list([("a", VInt32(1)), ("b", VInt32(2))]))
      ),

      // Comparable instance: map equality is order-independent
      check(VMap(Containers.Map.empty) == VMap(Containers.Map.empty)),
      check(
        VMap(Containers.Map.singleton(VInt32(1), VString("x")))
          == VMap(Containers.Map.singleton(VInt32(1), VString("x")))
      ),
      check(
        VMap(Containers.Map.from_list([(VInt32(1), VString("x")), (VString("a"), VBool(true))]))
          == VMap(Containers.Map.from_list([(VString("a"), VBool(true)), (VInt32(1), VString("x"))]))
      ),
      check(
        VMap(Containers.Map.singleton(VArray([VInt32(1)]), VMap(Containers.Map.empty)))
          == VMap(Containers.Map.singleton(VArray([VInt32(1)]), VMap(Containers.Map.empty)))
      ),
      check(
        VMap(Containers.Map.singleton(VString("k"), VArray([VNull, VBool(true)])))
          == VMap(Containers.Map.singleton(VString("k"), VArray([VNull, VBool(true)])))
      ),
      check(
        VMap(Containers.Map.singleton(VInt32(1), VString("x")))
          != VMap(Containers.Map.singleton(VInt32(2), VString("x")))
      ),
      check(
        VMap(Containers.Map.singleton(VInt32(1), VString("x")))
          != VMap(Containers.Map.singleton(VInt32(1), VString("y")))
      ),
      check(
        VMap(Containers.Map.empty)
          != VMap(Containers.Map.singleton(VInt32(1), VString("x")))
      ),
      check(
        VMap(Containers.Map.singleton(VInt32(1), VString("x")))
          != VMap(Containers.Map.from_list([(VInt32(1), VString("x")), (VString("a"), VBool(true))]))
      ),

      // Maps and objects are distinct constructors
      check(VMap(Containers.Map.empty) != VObject(Containers.Map.empty)),
      check(VObject(Containers.Map.empty) != VMap(Containers.Map.empty)),

      // Comparable instance: byte string equality
      check(VBytes([]) == VBytes([])),
      check(VBytes([of_int32(1)]) == VBytes([of_int32(1)])),
      check(VBytes([of_int32(1), of_int32(2)]) == VBytes([of_int32(1), of_int32(2)])),
      check(VBytes([of_int32(1), of_int32(2)]) != VBytes([of_int32(1), of_int32(3)])),
      check(VBytes([of_int32(1), of_int32(2)]) != VBytes([of_int32(2), of_int32(1)])),
      check(VBytes([]) != VBytes([of_int32(1)])),
      check(VBytes([of_int32(1)]) != VBytes([of_int32(1), of_int32(2)])),
      check(VBytes([of_int32(1)]) != VArray([VInt32(1)])),
      check(VBytes([of_int32(0)]) != VNull),

      // Comparable instance: datetime equality
      check(VDateTime(dt_base) == VDateTime(dt_base)),
      check(VDateTime(dt_later_hour) == VDateTime(dt_later_hour)),
      check(VDateTime(dt_base) != VDateTime(dt_later_hour)),
      check(VDateTime(dt_base) != VDateTime(dt_later_nanos)),
      check(VDateTime(dt_base) != VDateTime(dt_earlier_year)),
      check(VDateTime(dt_base) != VDateTime(dt_earlier_month)),
      check(VDateTime(dt_base) != VNull),
      check(VDateTime(dt_base) != VString("2026-09-01T12:34:56.000000789")),

      // Pretty instance
      check(pretty(VNull) == "VNull"),
      check(pretty(VUnit) == "VUnit"),
      check(pretty(VBool(true)) == "VBool(true)"),
      check(pretty(VBool(false)) == "VBool(false)"),
      check(pretty(VInt32(42)) == "VInt32(42)"),
      check(pretty(VInt32(-17)) == "VInt32(-17)"),
      check(pretty(VInt64(42)) == "VInt64(42)"),
      check(pretty(VNat(42)) == "VNat(42)"),
      check(pretty(VBignum(123456789012345678901234567890)) == "VBignum(123456789012345678901234567890)"),
      check(pretty(VFloat(1.5f)) == "VFloat(1.5)"),
      check(pretty(VDouble(3.14)) == "VDouble(3.14)"),
      check(pretty(VChar('a')) == "VChar(a)"),
      check(pretty(VString("hello")) == "VString(hello)"),
      check(pretty(VArray([])) == "VArray([])"),
      check(pretty(VArray([VNull, VBool(true), VString("x")])) == "VArray([VNull,VBool(true),VString(x)])"),
      check(pretty(VArray([VArray([VInt32(1)]), VArray([VInt32(2)])])) == "VArray([VArray([VInt32(1)]),VArray([VInt32(2)])])"),
      check(pretty(VObject(Containers.Map.empty)) == "VObject(Map())"),
      check(pretty(VObject(Containers.Map.singleton("a", VInt32(1)))) == "VObject(Map((a,VInt32(1))))"),

      check(pretty(VMap(Containers.Map.empty)) == "VMap(Map())"),
      check(pretty(VMap(Containers.Map.singleton(VInt32(1), VString("x")))) == "VMap(Map((VInt32(1),VString(x))))"),
      check(pretty(VMap(Containers.Map.singleton(VArray([VNull]), VMap(Containers.Map.empty)))) == "VMap(Map((VArray([VNull]),VMap(Map()))))"),

      check(pretty(VBytes([])) == "VBytes([])"),
      check(pretty(VBytes([of_int32(1), of_int32(2)])) == "VBytes([1,2])"),
      check(pretty(VBytes([of_int32(0), of_int32(128), of_int32(255)])) == "VBytes([0,128,255])"),

      check(pretty(VDateTime(dt_base)) == "VDateTime(2026-09-01T12:34:56.000000789)"),
      check(pretty(VDateTime(dt_earlier_month)) == "VDateTime(2026-03-01T12:34:56.000000789)"),

      // Ordered instance: constructor rank
      check(VNull < VUnit),
      check(VUnit < VBool(true)),
      check(VBool(true) < VInt32(0)),
      check(VInt32(0) < VInt64(0)),
      check(VInt64(0) < VNat(0)),
      check(VNat(0) < VBignum(0)),
      check(VBignum(0) < VFloat(0.0f)),
      check(VFloat(0.0f) < VDouble(0.0)),
      check(VDouble(0.0) < VChar('a')),
      check(VChar('a') < VString("")),
      check(VString("") < VArray([])),
      check(VArray([]) < VObject(Containers.Map.empty)),
      check(VObject(Containers.Map.empty) < VMap(Containers.Map.empty)),
      check(VMap(Containers.Map.empty) < VBytes([])),
      check(!(VBytes([]) < VMap(Containers.Map.empty))),
      check(VBytes([]) < VDateTime(dt_base)),
      check(!(VDateTime(dt_base) < VBytes([]))),

      // Ordered instance: payload comparison within a constructor
      check(VBool(false) < VBool(true)),
      check(VInt32(1) < VInt32(2)),
      check(!(VInt32(2) < VInt32(1))),
      check(VString("a") < VString("b")),
      check(VArray([VInt32(1)]) < VArray([VInt32(2)])),
      check(VObject(Containers.Map.singleton("a", VInt32(1))) < VObject(Containers.Map.singleton("b", VInt32(1)))),
      check(VMap(Containers.Map.singleton(VInt32(1), VNull)) < VMap(Containers.Map.singleton(VInt32(2), VNull))),
      check(VBytes([of_int32(1)]) < VBytes([of_int32(2)])),
      check(VBytes([of_int32(1)]) < VBytes([of_int32(1), of_int32(2)])),
      check(!(VBytes([of_int32(2)]) < VBytes([of_int32(1)]))),

      // Ordered instance: datetime payload comparison
      check(VDateTime(dt_base) < VDateTime(dt_later_hour)),
      check(VDateTime(dt_base) < VDateTime(dt_later_nanos)),
      check(VDateTime(dt_earlier_year) < VDateTime(dt_base)),
      check(VDateTime(dt_earlier_month) < VDateTime(dt_base)),
      check(!(VDateTime(dt_later_hour) < VDateTime(dt_base))),
      check(!(VDateTime(dt_base) < VDateTime(dt_base)))
    ])

}