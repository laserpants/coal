/**
 * Fixed-width unsigned 8-bit integers.
 *
 * This module provides an opaque `UInt8` type whose values always lie in
 * the range 0..255, together with wrapping arithmetic (`add`, `sub`, `mul`)
 * and bitwise operations (`bit_and`, `bit_or`, `bit_xor`, `bit_not`,
 * `bit_shift_left`, `bit_shift_right`).
 *
 * All arithmetic is modular: results are taken modulo 2^8 = 256, so
 * overflow wraps around at the boundary of the type, as with unsigned
 * arithmetic in C. Shifts by 8 or more bit positions yield 0.
 */
module Data.UInt8(
  UInt8, 
  of_int32, 
  to_num, 
  add,
  sub,
  mul,
  bit_and,
  bit_or,
  bit_xor,
  bit_not,
  bit_shift_left,
  bit_shift_right
) {

  import namespace Nat

  type UInt8I = UInt8I(int32)

  /**
   * An unsigned 8-bit integer.
   *
   * Opaque wrapper around an int32; the range is enforced by construction,
   * as `of_int32` is the only constructor and it narrows to the low byte.
   * Use `to_num` to extract the value as any numeric type.
   */
  type alias UInt8 = UInt8I

  /**
   * Mask an int32 down to its low byte. Under two's complement this maps
   * any int32 (including negative values) into the range 0..255.
   */
  fun wrap(n : int32) : int32 =
    #{uint8_and : int32 -> int32 -> int32}(n : int32, 255 : int32)(fn(m) => m)

  /**
   * Narrowing conversion from int32: keeps only the low byte of n,
   * wrapping modulo 256, as with a cast to uint8_t in C. Total for any
   * int32.
   */
  fun of_int32(n : int32) : UInt8 = 
    UInt8I(wrap(n))

  /**
   * Convert a UInt8 to any numeric type (of the Numeric trait).
   */
  fun to_num(UInt8I(n) : UInt8I) : a with (Numeric<a>) = 
    from_int32(n)

  let _UINT8_MIN : UInt8 = of_int32(0)

  let _UINT8_MAX : UInt8 = of_int32(255)

  /**
   * Wrapping (modular) addition: computes a + b modulo 256.
   */
  fun add(a : UInt8, b : UInt8) : UInt8 =
    let 
      UInt8I(an) = a;
      UInt8I(bn) = b
    in
      UInt8I(wrap(an + bn))

  /**
   * Wrapping (modular) subtraction: computes a - b modulo 256.
   */
  fun sub(a : UInt8, b : UInt8) : UInt8 =
    let 
      UInt8I(an) = a;
      UInt8I(bn) = b
    in
      UInt8I(wrap(an - bn))

  /**
   * Wrapping (modular) multiplication: computes a * b modulo 256.
   */
  fun mul(a : UInt8, b : UInt8) : UInt8 =
    let 
      UInt8I(an) = a;
      UInt8I(bn) = b
    in
      UInt8I(wrap(an * bn))

  /**
   * Bitwise AND: computes a & b.
   */
  fun bit_and(a : UInt8, b : UInt8) : UInt8 =
    let r =
      let 
        UInt8I(an) = a;
        UInt8I(bn) = b
      in
      #{uint8_and : int32 -> int32 -> int32}(an : int32, bn : int32)(fn(n) => n)
    in
    UInt8I(r)

  /**
   * Bitwise OR: computes a | b.
   */
  fun bit_or(a : UInt8, b : UInt8) : UInt8 =
    let r =
      let 
        UInt8I(an) = a;
        UInt8I(bn) = b
      in
      #{uint8_or : int32 -> int32 -> int32}(an : int32, bn : int32)(fn(n) => n)
    in
    UInt8I(r)

  /**
   * Bitwise XOR: computes a ^ b.
   */
  fun bit_xor(a : UInt8, b : UInt8) : UInt8 =
    let r =
      let 
        UInt8I(an) = a;
        UInt8I(bn) = b
      in
      #{uint8_xor : int32 -> int32 -> int32}(an : int32, bn : int32)(fn(n) => n)
    in
    UInt8I(r)

  /**
   * Bitwise complement: flips all eight bits of a; equivalent to 255 - a.
   */
  fun bit_not(a : UInt8) : UInt8 =
    let r =
      let 
        UInt8I(an) = a
      in
      #{uint8_not : int32 -> int32}(an : int32)(fn(n) => wrap(n))
    in
    UInt8I(r)

  /**
   * Bitwise left shift: shifts a left by n bit positions, discarding bits
   * shifted beyond position 7. Shifts by 8 or more yield 0, e.g.
   * bit_shift_left(200, 1) == 144 and bit_shift_left(1, 8) == 0.
   */
  fun bit_shift_left(a : UInt8, n : nat) : UInt8 =
    let r =
      let 
        UInt8I(an) = a;
        steps = Nat.unpack(n)
      in
      #{uint8_shift_left : int32 -> int32 -> int32}(an : int32, steps : int32)(fn(n) => wrap(n))
    in
    UInt8I(r)

  /**
   * Bitwise right shift: shifts a right by n bit positions (logical shift;
   * the sign bit is not replicated since values are non-negative). Shifts
   * by 8 or more yield 0, e.g. bit_shift_right(200, 2) == 50 and
   * bit_shift_right(255, 8) == 0.
   */
  fun bit_shift_right(a : UInt8, n : nat) : UInt8 =
    let r =
      let 
        UInt8I(an) = a;
        steps = Nat.unpack(n)
      in
      #{uint8_shift_right : int32 -> int32 -> int32}(an : int32, steps : int32)(fn(n) => n)
    in
    UInt8I(r)

}
