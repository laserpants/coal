module DateTime {

  import IO(return)
  import Option(with_default)
  import Pretty(Pretty)
  import String(int32_to_string, int64_to_string)

  // ---------------------------------------------------------------------------
  // Core types
  // ---------------------------------------------------------------------------

  /**
   * An absolute point on the timeline.
   *
   * Represented as the number of nanoseconds since the Unix epoch
   * (1970-01-01T00:00:00Z). With a 64-bit representation the
   * representable range is approximately 1677-09-21 to 2262-04-11.
   */
  type Instant = Instant(int64)

  /**
   * An amount of time, represented as a number of nanoseconds.
   *
   * Durations may be negative and are measured on the timeline: adding
   * `days(1)` to an `Instant` always adds exactly 86,400,000,000,000
   * nanoseconds, independent of any calendar effects such as DST.
   */
  type Duration = Duration(int64)

  /**
   * A civil (calendar) date in the proleptic Gregorian calendar.
   *
   * `Date` values can only be constructed through the validating
   * `date` constructor, so every existing `Date` is valid.
   */
  type Date = Date({ year : int32, month : MonthOfYear, day : int32 })

  /**
   * A time of day with nanosecond precision. Leap seconds are not
   * modelled (`second` is at most 59).
   *
   * `Time` values can only be constructed through the validating
   * `time` constructor, so every existing `Time` is valid.
   */
  type Time
    = Time({ hour : int32, minute : int32, second : int32, nanosecond : int32 })

  /**
   * A civil date and time. This is a *naive* value: it does not carry
   * a timezone or offset, so it does not identify a specific moment on
   * the timeline until combined with an offset (see `to_instant_utc`).
   */
  type DateTime
    = DateTime({ date : Date, time : Time })

  /**
   * Errors that can occur when constructing a `Date`.
   */
  type DateError
    = InvalidDay(int32)

  /**
   * Errors that can occur when constructing a `Time`.
   */
  type TimeError
    = InvalidHour(int32)
    | InvalidMinute(int32)
    | InvalidSecond(int32)
    | InvalidNanosecond(int32)

  type DayOfWeek
    = Monday
    | Tuesday
    | Wednesday
    | Thursday
    | Friday
    | Saturday
    | Sunday

  type MonthOfYear
    = January
    | February
    | March
    | April
    | May
    | June
    | July
    | August
    | September
    | October
    | November
    | December

  // ---------------------------------------------------------------------------
  // Constants
  // ---------------------------------------------------------------------------

  let _NANOS_PER_SECOND : int64 = 1000000000

  let _NANOS_PER_MINUTE : int64 = 60000000000

  let _NANOS_PER_HOUR : int64 = 3600000000000

  let _NANOS_PER_DAY : int64 = 86400000000000

  /**
   * The Unix epoch: 1970-01-01T00:00:00Z.
   *
   * **Type**: `unix_epoch : Instant`
   */
  let unix_epoch : Instant = Instant(0)

  // ---------------------------------------------------------------------------
  // Clocks
  // ---------------------------------------------------------------------------

  /**
   * The current instant, read from the realtime clock.
   *
   * **Type**: `now : unit -> IO<Instant>`
   */
  fun now() : IO<Instant> =
    #{coal_clock_realtime : unit -> int64}(())(fn(n) => return(Instant(n)))

  /**
   * Seconds since the Unix epoch, read from the realtime clock. No
   * sub-second precision.
   *
   * **Type**: `unix_time : unit -> IO<int64>`
   */
  fun unix_time() : IO<int64> =
    #{unix_time : unit -> int64}(())(fn(n) => return(n))

  /**
   * Nanoseconds on the monotonic clock, for measuring elapsed time.
   * The absolute value is meaningless; only differences between two
   * readings are defined.
   *
   * **Type**: `monotonic_nanos : unit -> IO<int64>`
   */
  fun monotonic_nanos() : IO<int64> =
    #{coal_clock_monotonic : unit -> int64}(())(fn(n) => return(n))


  // ---------------------------------------------------------------------------
  // Integer helpers
  //
  // The library mixes int32 (public fields) and int64 (internal
  // arithmetic); these wrap the C helpers so no arithmetic is ever
  // performed on mixed widths.
  // ---------------------------------------------------------------------------

  fun int32_to_int64(n : int32) : int64 =
    #{coal_int32_to_int64 : int32 -> int64}(n)(fn(m) => m)

  fun int64_to_int32(n : int64) : int32 =
    #{coal_int64_to_int32 : int64 -> int32}(n)(fn(m) => m)

  /**
   * Truncating integer division for int64 (C semantics: rounds
   * towards zero). The compiler does not provide a `Divisible`
   * instance for `int64`, so division goes through the runtime.
   */
  fun int64_div(a : int64, b : int64) : int64 =
    #{coal_int64_div : int64 -> int64 -> int64}(a, b)(fn(q) => q)

  /**
   * Floor division: rounds towards negative infinity. The built-in
   * `/` truncates towards zero, which is wrong for calendar arithmetic
   * on pre-epoch instants.
   */
  fun floor_div(a : int64, b : int64) : int64 =
    let
      q = int64_div(a, b);
      r = a % b
    in
    if (r == 0 || (r < 0) == (b < 0))
      then q
      else q - 1

  /**
   * Floor modulo: the result has the sign of `b` (always non-negative
   * when `b > 0`).
   */
  fun floor_mod(a : int64, b : int64) : int64 =
    a - floor_div(a, b) * b

  // ---------------------------------------------------------------------------
  // Months
  // ---------------------------------------------------------------------------

  /**
   * 1-based calendar month number for a `MonthOfYear`.
   *
   * **Type**: `month_to_int : MonthOfYear -> int32`
   */
  fun month_to_int(m : MonthOfYear) : int32 =
    match(m) {
      | January   => 1
      | February  => 2
      | March     => 3
      | April     => 4
      | May       => 5
      | June      => 6
      | July      => 7
      | August    => 8
      | September => 9
      | October   => 10
      | November  => 11
      | December  => 12
    }

  /**
   * The `MonthOfYear` for a 1-based calendar month number, or `None`
   * if the number is outside 1..12.
   *
   * **Type**: `month_from_int : int32 -> Option<MonthOfYear>`
   */
  fun month_from_int(n : int32) : Option<MonthOfYear> =
    match(n) {
      | 1  => Some(January)
      | 2  => Some(February)
      | 3  => Some(March)
      | 4  => Some(April)
      | 5  => Some(May)
      | 6  => Some(June)
      | 7  => Some(July)
      | 8  => Some(August)
      | 9  => Some(September)
      | 10 => Some(October)
      | 11 => Some(November)
      | 12 => Some(December)
      | _  => None
    }

  // ---------------------------------------------------------------------------
  // Calendar algorithms
  //
  // The conversion between civil dates and day counts is based on
  // Howard Hinnant's `days_from_civil` / `civil_from_days` algorithms
  // (public domain). Everything else in the library is derived from
  // these two functions.
  // ---------------------------------------------------------------------------

  /**
   * Test whether a year is a leap year in the proleptic Gregorian
   * calendar.
   *
   * **Type**: `is_leap_year : int32 -> bool`
   */
  fun is_leap_year(year : int32) : bool =
    if (year % 400 == 0)
      then true
      else if (year % 100 == 0)
        then false
        else year % 4 == 0

  /**
   * Number of days in a month, taking leap years into account.
   *
   * **Type**: `days_in_month : int32 -> MonthOfYear -> int32`
   */
  fun days_in_month(year : int32, month : MonthOfYear) : int32 =
    match(month) {
      | January   => 31
      | February  => if (is_leap_year(year)) then 29 else 28
      | March     => 31
      | April     => 30
      | May       => 31
      | June      => 30
      | July      => 31
      | August    => 31
      | September => 30
      | October   => 31
      | November  => 30
      | December  => 31
    }

  /**
   * Number of days since the Unix epoch (1970-01-01 is day 0) for the
   * given proleptic Gregorian year/month/day, where `month` is the
   * 1-based month number.
   *
   * **Type**: `days_from_civil : int64 -> int64 -> int64 -> int64`
   */
  fun days_from_civil(year : int64, month : int64, day : int64) : int64 =
    let
      y : int64 =
        if (month <= 2) then year - 1 else year;
      era : int64 =
        if (y >= 0) then int64_div(y, 400) else int64_div(y - 399, 400);
      yoe : int64 = y - era * 400;
      mp : int64 =
        if (month > 2) then month - 3 else month + 9;
      doy : int64 = int64_div(153 * mp + 2, 5) + day - 1;
      doe : int64 = yoe * 365 + int64_div(yoe, 4) - int64_div(yoe, 100) + doy
    in
    era * 146097 + doe - 719468

  /**
   * The `Date` for a number of days since the Unix epoch, interpreted
   * as the midnight date in UTC. The inverse of `days_from_date`.
   *
   * **Type**: `date_from_days : int64 -> Date`
   */
  fun date_from_days(days : int64) : Date =
    let
      z : int64 = days + 719468;
      era : int64 =
        if (z >= 0) then int64_div(z, 146097) else int64_div(z - 146096, 146097);
      doe : int64 = z - era * 146097;
      yoe : int64 =
        int64_div(doe - int64_div(doe, 1460) + int64_div(doe, 36524) - int64_div(doe, 146096), 365);
      yr : int64 = yoe + era * 400;
      doy : int64 = doe - (365 * yoe + int64_div(yoe, 4) - int64_div(yoe, 100));
      mp : int64 = int64_div(5 * doy + 2, 153);
      d : int64 = doy - int64_div(153 * mp + 2, 5) + 1;
      m : int64 = if (mp < 10) then mp + 3 else mp - 9;
      y : int64 = if (m <= 2) then yr + 1 else yr
    in
    Date
      ({ year = int64_to_int32(y)
       , month = with_default(January, month_from_int(int64_to_int32(m)))
       , day = int64_to_int32(d)
       })

  /**
   * Number of days since the Unix epoch (1970-01-01 is day 0) for the
   * given date. The inverse of `date_from_days`.
   *
   * **Type**: `days_from_date : Date -> int64`
   */
  fun days_from_date(Date(r) : Date) : int64 =
    days_from_civil
      ( int32_to_int64(r.year)
      , int32_to_int64(month_to_int(r.month))
      , int32_to_int64(r.day)
      )

  /**
   * Day of the week for a date. Derived from the fact that
   * 1970-01-01 (day 0) was a Thursday.
   *
   * **Type**: `day_of_week : Date -> DayOfWeek`
   */
  fun day_of_week(d : Date) : DayOfWeek =
    let
      w = int64_to_int32(floor_mod(days_from_date(d) + 4, 7))
    in
    // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
    match(w) {
      | 1 => Monday
      | 2 => Tuesday
      | 3 => Wednesday
      | 4 => Thursday
      | 5 => Friday
      | 6 => Saturday
      | _ => Sunday
    }

  // ---------------------------------------------------------------------------
  // Smart constructors
  // ---------------------------------------------------------------------------

  /**
   * Construct a `Date`, or `Err(InvalidDay(n))` if `day` does not
   * exist in the given month and year.
   *
   * **Type**: `date : int32 -> MonthOfYear -> int32 -> Result<Date, DateError>`
   */
  fun date(year : int32, month : MonthOfYear, day : int32) : Result<Date, DateError> =
    if (day >= 1 && day <= days_in_month(year, month))
      then Ok(Date({ year = year, month = month, day = day }))
      else Err(InvalidDay(day))

  /**
   * Construct a `Time`, or an `Err` describing the first out-of-range
   * component. Leap seconds are not modelled: `second` must be at
   * most 59.
   *
   * **Type**: `time : int32 -> int32 -> int32 -> int32 -> Result<Time, TimeError>`
   */
  fun time
    ( hour : int32
    , minute : int32
    , second : int32
    , nanosecond : int32
    ) : Result<Time, TimeError> =
    if (hour < 0 || hour > 23) then Err(InvalidHour(hour))
    else if (minute < 0 || minute > 59) then Err(InvalidMinute(minute))
    else if (second < 0 || second > 59) then Err(InvalidSecond(second))
    else if (nanosecond < 0 || nanosecond > 999999999)
      then Err(InvalidNanosecond(nanosecond))
      else Ok
        (Time
          ({ hour = hour
           , minute = minute
           , second = second
           , nanosecond = nanosecond
           }))

  /**
   * Combine a `Date` and a `Time` into a naive `DateTime`. Total,
   * because both arguments are already validated.
   *
   * **Type**: `date_time : Date -> Time -> DateTime`
   */
  fun date_time(date : Date, time : Time) : DateTime =
    DateTime({ date = date, time = time })

  // ---------------------------------------------------------------------------
  // Getters
  // ---------------------------------------------------------------------------

  fun year(Date(r) : Date) : int32 =
    r.year 

  fun month(Date(r) : Date) : MonthOfYear =
    r.month 

  fun day(Date(r) : Date) : int32 =
    r.day 

  fun hour(Time(r) : Time) : int32 =
    r.hour 

  fun minute(Time(r) : Time) : int32 =
    r.minute 

  fun second(Time(r) : Time) : int32 =
    r.second 

  fun nanosecond(Time(r) : Time) : int32 =
    r.nanosecond 

  fun date_of(DateTime(r) : DateTime) : Date =
    r.date 

  fun time_of(DateTime(r) : DateTime) : Time =
    r.time 


  // ---------------------------------------------------------------------------
  // Duration construction
  // ---------------------------------------------------------------------------

  fun nanoseconds(n : int64) : Duration =
    Duration(n)

  fun microseconds(n : int64) : Duration =
    Duration(n * 1000)

  fun milliseconds(n : int64) : Duration =
    Duration(n * 1000000)

  fun seconds(n : int64) : Duration =
    Duration(n * _NANOS_PER_SECOND)

  fun minutes(n : int64) : Duration =
    Duration(n * _NANOS_PER_MINUTE)

  fun hours(n : int64) : Duration =
    Duration(n * _NANOS_PER_HOUR)

  /**
   * A duration of `n` *timeline* days: exactly `n * 86400000000000`
   * nanoseconds. This is *not* the same as "n calendar days", which
   * can differ around DST transitions (calendar-day arithmetic needs a
   * `Period`-style type; see the roadmap notes).
   */
  fun days(n : int64) : Duration =
    Duration(n * _NANOS_PER_DAY)

  // ---------------------------------------------------------------------------
  // Duration arithmetic
  // ---------------------------------------------------------------------------

  fun duration_add(Duration(x) : Duration, Duration(y) : Duration) : Duration =
    Duration(x + y)

  fun duration_subtract(Duration(x) : Duration, Duration(y) : Duration) : Duration =
    Duration(x - y)

  fun duration_negate(Duration(n) : Duration) : Duration =
    Duration(0 - n)

  fun duration_scale(Duration(n) : Duration, k : int64) : Duration =
    Duration(n * k)

  fun duration_abs(Duration(n) : Duration) : Duration =
    if (n < 0) then Duration(0 - n) else Duration(n)

  fun duration_is_zero(Duration(n) : Duration) : bool =
    n == 0

  // Component extractors. These truncate towards zero: the fractional
  // part is discarded (e.g. `duration_seconds(milliseconds(1500))`
  // is 1).

  fun duration_nanoseconds(Duration(n) : Duration) : int64 =
    n 

  fun duration_microseconds(Duration(n) : Duration) : int64 =
    int64_div(n, 1000) 

  fun duration_milliseconds(Duration(n) : Duration) : int64 =
    int64_div(n, 1000000) 

  fun duration_seconds(Duration(n) : Duration) : int64 =
    int64_div(n, _NANOS_PER_SECOND) 

  fun duration_minutes(Duration(n) : Duration) : int64 =
    int64_div(n, _NANOS_PER_MINUTE) 

  fun duration_hours(Duration(n) : Duration) : int64 =
    int64_div(n, _NANOS_PER_HOUR) 

  fun duration_days(Duration(n) : Duration) : int64 =
    int64_div(n, _NANOS_PER_DAY) 

  // ---------------------------------------------------------------------------
  // Instant arithmetic
  // ---------------------------------------------------------------------------

  /**
   * Add a duration to an instant (moves forward for positive
   * durations, backward for negative ones). Wraps around on 64-bit
   * overflow, which can only occur outside the documented
   * 1677..2262 range of `Instant`.
   */
  fun add(instant : Instant, d : Duration) : Instant =
    match((instant, d)) {
      | (Instant(t), Duration(n)) => Instant(t + n)
    }

  /**
   * Subtract a duration from an instant.
   */
  fun subtract(instant : Instant, d : Duration) : Instant =
    match((instant, d)) {
      | (Instant(t), Duration(n)) => Instant(t - n)
    }

  /**
   * The duration from `start` to `end`: `between(a, b)` is negative
   * when `b` is earlier than `a`.
   */
  fun between(start : Instant, end : Instant) : Duration =
    match((start, end)) {
      | (Instant(a), Instant(b)) => Duration(b - a)
    }

  // ---------------------------------------------------------------------------
  // Instant <-> naive DateTime, in UTC
  //
  // Fixed-offset conversions (and full timezone support) build on
  // these two functions: for an offset of `o` seconds east of UTC,
  // shift the instant by `o` before/after converting.
  // ---------------------------------------------------------------------------

  /**
   * Interpret a naive `DateTime` as a reading of the UTC clock and
   * return the corresponding instant.
   */
  fun to_instant_utc(dt : DateTime) : Instant =
    let
      d = date_of(dt);
      t = time_of(dt);
      day_nanos : int64 = days_from_date(d) * _NANOS_PER_DAY;
      time_nanos : int64 =
        int32_to_int64(hour(t)) * _NANOS_PER_HOUR
          + int32_to_int64(minute(t)) * _NANOS_PER_MINUTE
          + int32_to_int64(second(t)) * _NANOS_PER_SECOND
          + int32_to_int64(nanosecond(t))
    in
    Instant(day_nanos + time_nanos)

  /**
   * Render an instant as a naive UTC date and time. Correct for
   * pre-epoch instants as well: component extraction uses floor
   * division, not truncation.
   */
  fun from_instant_utc(i : Instant) : DateTime =
    let
      n = match(i) { | Instant(v) => v };
      day : int64 = floor_div(n, _NANOS_PER_DAY);
      rem : int64 = floor_mod(n, _NANOS_PER_DAY);
      rem_h : int64 = rem % _NANOS_PER_HOUR;
      rem_m : int64 = rem_h % _NANOS_PER_MINUTE;
      h : int32 = int64_to_int32(int64_div(rem, _NANOS_PER_HOUR));
      m : int32 = int64_to_int32(int64_div(rem_h, _NANOS_PER_MINUTE));
      s : int32 = int64_to_int32(int64_div(rem_m, _NANOS_PER_SECOND));
      ns : int32 = int64_to_int32(rem_m % _NANOS_PER_SECOND)
    in
    DateTime
      ({ date = date_from_days(day)
       , time = Time({ hour = h, minute = m, second = s, nanosecond = ns })
       })

  // ---------------------------------------------------------------------------
  // Fixed-offset conversions
  //
  // A naive `DateTime` combined with an `Offset` identifies a specific moment.
  // These are pure and testable; full IANA-timezone support builds on them.
  // ---------------------------------------------------------------------------

  /**
   * A fixed offset from UTC, in seconds east of Greenwich.
   *
   * Valid range is -86400..86400 (i.e. -24h..+24h), which covers every
   * real-world timezone offset.
   */
  type Offset = Offset(int32)

  /**
   * Errors that can occur when constructing an `Offset`.
   */
  type OffsetError
    = InvalidOffset(int32)

  /**
   * Construct an `Offset` from a number of seconds east of UTC, or
   * `Err(InvalidOffset(s))` if `s` is outside -86400..86400.
   *
   * **Type**: `offset_seconds : int32 -> Result<Offset, OffsetError>`
   */
  fun offset_seconds(s : int32) : Result<Offset, OffsetError> =
    if (s >= -86400 && s <= 86400)
      then Ok(Offset(s))
      else Err(InvalidOffset(s))

  /**
   * Construct an `Offset` from a number of whole hours east of UTC, or
   * `Err(InvalidOffset(h))` if `h` is outside -24..24.
   *
   * **Type**: `offset_hours : int32 -> Result<Offset, OffsetError>`
   */
  fun offset_hours(h : int32) : Result<Offset, OffsetError> =
    if (h >= -24 && h <= 24)
      then Ok(Offset(h * 3600))
      else Err(InvalidOffset(h))

  /**
   * The number of seconds east of UTC for an `Offset`.
   *
   * **Type**: `offset_seconds_value : Offset -> int32`
   */
  fun offset_seconds_value(o : Offset) : int32 =
    match(o) { | Offset(s) => s }

  /**
   * Render an instant as a naive `DateTime` in the given offset.
   *
   * This is `from_instant_utc` applied to the instant shifted east by the
   * offset. For a UTC+1 instant of `1970-01-01T00:00:00Z`, the result is
   * `1970-01-01T01:00:00`.
   *
   * **Type**: `to_date_time : Instant -> Offset -> DateTime`
   */
  fun to_date_time(instant : Instant, offset : Offset) : DateTime =
    let
      offset_nanos : int64 =
        int32_to_int64(offset_seconds_value(offset)) * _NANOS_PER_SECOND;
      shifted = match(instant) { | Instant(t) => Instant(t + offset_nanos) }
    in
    from_instant_utc(shifted)

  /**
   * Interpret a naive `DateTime` as a reading of the clock at the given
   * offset and return the corresponding absolute instant.
   *
   * This is `to_instant_utc` of the instant shifted west by the offset.
   * For `1970-01-01T01:00:00` at UTC+1, the result is the epoch.
   *
   * **Type**: `to_instant : DateTime -> Offset -> Instant`
   */
  fun to_instant(dt : DateTime, offset : Offset) : Instant =
    let
      offset_nanos : int64 =
        int32_to_int64(offset_seconds_value(offset)) * _NANOS_PER_SECOND;
      utc_nanos = match(to_instant_utc(dt)) { | Instant(t) => t }
    in
    Instant(utc_nanos - offset_nanos)

  // ---------------------------------------------------------------------------
  // Comparison
  // ---------------------------------------------------------------------------

  instance Comparable<Instant> {
    fun `==`(lhs, rhs) =
      match((lhs, rhs)) {
        | (Instant(x), Instant(y)) => x == y
      }
  }

  instance Ordered<Instant> {
    fun compare(lhs, rhs) =
      match((lhs, rhs)) {
        | (Instant(x), Instant(y)) =>
            if (x < y) then LessThan
            else if (x == y) then EqualTo
            else GreaterThan
      }
  }

  fun is_before(a : Instant, b : Instant) : bool = a < b

  fun is_after(a : Instant, b : Instant) : bool = a > b

  fun min_instant(a : Instant, b : Instant) : Instant =
    if (a < b) then a else b

  fun max_instant(a : Instant, b : Instant) : Instant =
    if (a > b) then a else b

  // ---------------------------------------------------------------------------
  // Pretty-printing
  // ---------------------------------------------------------------------------

  fun pad2(n : int32) : string =
    if (n < 10)
      then "0" <> int32_to_string(n)
      else int32_to_string(n)

  fun pad9(n : int32) : string =
    if (n < 10)             then "00000000" <> int32_to_string(n)
    else if (n < 100)       then "0000000"  <> int32_to_string(n)
    else if (n < 1000)      then "000000"   <> int32_to_string(n)
    else if (n < 10000)     then "00000"    <> int32_to_string(n)
    else if (n < 100000)    then "0000"     <> int32_to_string(n)
    else if (n < 1000000)   then "000"      <> int32_to_string(n)
    else if (n < 10000000)  then "00"       <> int32_to_string(n)
    else if (n < 100000000) then "0"        <> int32_to_string(n)
    else int32_to_string(n)

  instance Pretty<Time> {
    fun pretty(Time(r)) =
      pad2(r.hour) <> ":"
        <> pad2(r.minute) <> ":"
        <> pad2(r.second) <> "."
        <> pad9(r.nanosecond)
  }

  instance Pretty<Date> {
    fun pretty(Date(r)) =
      int32_to_string(r.year) <> "-"
        <> pad2(month_to_int(r.month)) <> "-"
        <> pad2(r.day)
  }

  instance Pretty<DateTime> {
    fun pretty(DateTime(r)) =
      pretty(r.date) <> "T" <> pretty(r.time)
  }

  instance Pretty<Instant> {
    fun pretty(instant) =
      match(from_instant_utc(instant)) {
        | DateTime(r) => pretty(r.date) <> "T" <> pretty(r.time) <> "Z"
      }
  }

  instance Pretty<DayOfWeek> {
    fun pretty
      | Monday    => "Monday"
      | Tuesday   => "Tuesday"
      | Wednesday => "Wednesday"
      | Thursday  => "Thursday"
      | Friday    => "Friday"
      | Saturday  => "Saturday"
      | Sunday    => "Sunday"
  }

  instance Pretty<MonthOfYear> {
    fun pretty
      | January   => "January"
      | February  => "February"
      | March     => "March"
      | April     => "April"
      | May       => "May"
      | June      => "June"
      | July      => "July"
      | August    => "August"
      | September => "September"
      | October   => "October"
      | November  => "November"
      | December  => "December"
  }

  instance Pretty<Offset> {
    fun pretty(offset) =
      let
        s = offset_seconds_value(offset);
        sign = if (s < 0) then "-" else "+";
        abs_s = if (s < 0) then 0 - s else s;
        h = int64_to_int32(int64_div(int32_to_int64(abs_s), 3600));
        m = int64_to_int32(int64_div(int32_to_int64(abs_s) - int32_to_int64(h) * 3600, 60))
      in
      sign <> pad2(h) <> ":" <> pad2(m)
  }

  instance Pretty<Duration> {
    fun pretty(d : Duration) : string =
      let
        total_ns = duration_nanoseconds(d);
        sign = if (total_ns < 0) then "-" else "";
        ns = if (total_ns < 0) then 0 - total_ns else total_ns;
        days_val = int64_div(ns, _NANOS_PER_DAY);
        rem1 = ns - days_val * _NANOS_PER_DAY;
        hours_val = int64_div(rem1, _NANOS_PER_HOUR);
        rem2 = rem1 - hours_val * _NANOS_PER_HOUR;
        mins_val = int64_div(rem2, _NANOS_PER_MINUTE);
        rem3 = rem2 - mins_val * _NANOS_PER_MINUTE;
        secs_val = int64_div(rem3, _NANOS_PER_SECOND);
        nanos_val = rem3 - secs_val * _NANOS_PER_SECOND
      in
      if (days_val > 0)
        then
          let
            h = if (hours_val > 0) then " " <> int64_to_string(hours_val) <> "h" else "";
            m = if (mins_val > 0) then " " <> int64_to_string(mins_val) <> "m" else "";
            s = if (secs_val > 0) then " " <> int64_to_string(secs_val) <> "s" else ""
          in
          sign <> int64_to_string(days_val) <> "d" <> h <> m <> s
      else if (hours_val > 0)
        then
          let
            m = if (mins_val > 0) then " " <> int64_to_string(mins_val) <> "m" else "";
            s = if (secs_val > 0) then " " <> int64_to_string(secs_val) <> "s" else ""
          in
          sign <> int64_to_string(hours_val) <> "h" <> m <> s
      else if (mins_val > 0)
        then
          let
            s = if (secs_val > 0) then " " <> int64_to_string(secs_val) <> "s" else ""
          in
          sign <> int64_to_string(mins_val) <> "m" <> s
      else if (secs_val > 0)
        then sign <> int64_to_string(secs_val) <> "s"
      else sign <> int64_to_string(nanos_val) <> "ns"
  }

}
