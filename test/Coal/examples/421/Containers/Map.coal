/**
 * An efficient key-value store implemented as a self-balancing AVL tree, 
 * ensuring O(log n) performance for insertions, deletions, and lookups.
 */
module Containers.Map {

  import Number(max)
  import List(reduce)

  type alias MapFields<key, val> =
    { key    : key
    , value  : val
    , height : int32
    , left   : Map<key, val>
    , right  : Map<key, val> 
    }

  /**
   * An AVL tree-based associative map, keyed by a comparable and ordered key type
   */
  type Map<key, val> 
    = Empty 
    | Map(MapFields<key, val>)

  instance Comparable<Map<key, val>> {
    fun `==`(m1, m2) = to_sorted_list(m1) == to_sorted_list(m2)
  }

  // Helpers

  /**
   * Get the height of a map
   */
  fun height 
    | Empty => 0
    | Map({ height = h | _ }) => h

  /**
   * Count the number of entries in the map
   */
  fold size : Map<key, val> -> int32
    | Empty =>
        0
    | Map({ left = size(@left), right = size(@right) | _ }) =>
        1 + left + right

  /**
   * Create a map node from a key, value, and left and right subtrees
   */
  fun make_node(key, val, left, right) =
    let 
      fields =
        { key    = key
        , value  = val
        , height = 1 + max(height(left), height(right))
        , left   = left
        , right  = right
        }
    in 
      Map(fields)

  /**
   * Compute the balance factor of a node
   */
  fun balance_factor
    | Empty  => 0
    | Map(m) => height(m.left) - height(m.right)
 
    /**
     * Convert a map into a list of its key-value pairs
     */
    fun to_list(map) =
      fold(map) {
        | Empty =>
            []

        | Map({ key, value, left = @left, right = @right | _ }) =>
            (key, value) :: left <> right
      }

    /**
     * Convert a map into a list of its key-value pairs in ascending key order.
     *
     * Unlike `to_list`, which yields a pre-order traversal that depends on the
     * shape of the tree, the result of this function is canonical: two maps
     * with the same entries always produce the same list. This makes it
     * suitable for comparing maps for equality.
     */
    fun to_sorted_list(map) =
      fold(map) {
        | Empty =>
            []

        | Map({ key, value, left = @left, right = @right | _ }) =>
            left <> ((key, value) :: right)
      }

  // Constructors

  /**
   * The empty map
   */
  let empty = Empty

  /**
   * Create a map with a single key-value pair
   */
  fun singleton(key, val) = 
    make_node(key, val, Empty, Empty)

  /**
   * Create a map from a list of key-value pairs
   */
  fun from_list(pairs) =
    reduce(fn((k, v), map) => insert(k, v, map), empty, pairs)

  // Rotations

  //
  //       y              x
  //      / \            / \
  //     x   t3   ==>   t1  y
  //    / \                / \
  //   t1 t2              t2 t3
  //

  /**
   * Rotate a subtree to the right
   */
  fun rotate_right
    | Map({ key = yk, value = yv, left = Map(x), right = t3 | _ }) =>
        let t1 = x.left;
            t2 = x.right
        in
        make_node(x.key, x.value, t1, make_node(yk, yv, t2, t3))
    | map =>
        map

  //
  //     x                 y
  //    / \               / \
  //   t1  y     ==>     x  t3
  //      / \           / \
  //     t2 t3         t1 t2
  //

  /**
   * Rotate a subtree to the left
   */
  fun rotate_left
    | Map({ key = xk, value = xv, left = t1, right = Map(y) | _ }) =>
        let t2 = y.left;
            t3 = y.right
        in
        make_node(y.key, y.value, make_node(xk, xv, t1, t2), t3)
    | map =>
        map

  // Rebalancing

  /**
   * Rebalance a map node to restore the AVL balance invariant
   */
  fun rebalance
    | Empty =>
        Empty

    | Map(m) as map =>
        let bf = balance_factor(map) in
        if (bf > 1) then
          if (balance_factor(m.left) < 0) then
            rotate_right(
              make_node(m.key, m.value,
                rotate_left(m.left),
                m.right
              )
            )
          else
            rotate_right(map)

        else if (bf < -1) then
          if (balance_factor(m.right) > 0) then
            rotate_left(
              make_node(m.key, m.value,
                m.left,
                rotate_right(m.right)
              )
            )
          else
            rotate_left(map)

        else
          map

  // Lookup

  /**
   * Check if the map is empty
   */
  fun is_empty
    | Empty => true
    | _ => false

  /**
   * Find the value associated with a key, if it exists
   */
  fun lookup(query_key, map) =
    fold(map) {
      | Empty =>
          None

      | Map({ key, value, left = @left, right = @right | _ }) =>
          if (query_key == key) then
            Some(value)
          else 
            if (query_key < key) then
              left
            else
              right
    }

  // Insertion

  /**
   * Insert or update a key-value pair in the map
   */
  fun insert(key, val, map) =
    fold(map) {
      | Empty =>
          singleton(key, val)
 
      | Map({ left = @left, right = @right | _ } as m) =>
          if (key == m.key) then
            make_node(key, val, m.left, m.right)
  
          else if (key < m.key) then
            rebalance(make_node(m.key, m.value, left, m.right))
  
          else
            rebalance(make_node(m.key, m.value, m.left, right))
    }
 
  // Deletion

  /**
   * Delete the leftmost node, returning its key, value, and the resulting tree
   */
  fold delete_min_node 
    | Empty =>
        (None, None, Empty)

    | Map({ left = Empty | _ } as m) =>
        (Some(m.key), Some(m.value), m.right)

    | Map({ left = delete_min_node(@left) | _ } as m) =>
        let (k, v, new_left) = left 
        in
        (k, v, rebalance(make_node(m.key, m.value, new_left, m.right)))

  /**
   * Remove a key from the map
   */
  fun delete(key, map) =
    fold(map) {
      | Empty =>
          Empty

      | Map({ left = @left, right = @right | _ } as m) =>
          if (key < m.key) then
            rebalance(make_node(m.key, m.value, left, m.right))

          else if (key > m.key) then
            rebalance(make_node(m.key, m.value, m.left, right))

          else
            match(delete_min_node(m.right)) {
              | (Some(k), Some(v), new_right) =>
                  rebalance(make_node(k, v, m.left, new_right))
              | _ =>
                  m.left
            }
    }

}
