/**
 * A general-purpose tree structure where each node can have an arbitrary number 
 * of children (also known as a rose tree or multi-way tree).
 */ 
module Containers.Tree {

  import Number(max)

  type alias TreeFields<a> =
    { value    : a
    , children : List<Tree<a>>
    }

  /**
   * A general-purpose tree (rose tree) where each node may hold any number of children
   */
  type Tree<a> = Node(TreeFields<a>)

  /**
   * Create a leaf node (a node with no children)
   */
  fun leaf(value) =
    Node({ value = value, children = [] })

  /**
   * Create a node with a value and a list of children
   */
  fun node(value, children) =
    Node({ value = value, children = children })

  /**
   * Count the number of nodes in a list of trees
   */
  fold tree_list_size 
    | size(@tree) :: tree_list_size(@trees) => tree + trees
    | [] => 0

  /**
   * Count the total number of nodes in a tree
   */
  fold size 
    | Node({ children = tree_list_size(@children) | _ }) => 1 + children

  /**
   * Compute the maximum height of a list of trees
   */
  fold tree_list_height 
    | [] => 0
    | height(@h) :: tree_list_height(@g) => max(h, g)

  /**
   * Compute the height of a tree
   */
  fold height 
    | Node({ children = tree_list_height(@h) | _ }) => 1 + h

  /**
   * Apply a function to the values of a list of trees
   */
  fold tree_list_map 
    | [] =>
        fn(_) => []
    | Node({ value, children = tree_list_map(@children) }) :: tree_list_map(@trees) =>
        fn(f) => Node({ value = f(value), children = children(f) }) :: trees(f)

  /**
   * Apply a function to all node values of a tree, preserving its structure
   */
  fun tree_map(f : a -> b, Node({ value, children }) : Tree<a>) : Tree<b> =
    Node({ value = f(value), children = tree_list_map(children, f) })

}
