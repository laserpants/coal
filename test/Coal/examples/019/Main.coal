module Main {

  import IO(println_int32, println_bool, println_string)

  type User = User({ uid : int32, name : string })

  let a_user_named_bob = 
    User
      ({ name = "Bob"
       , uid = 1
       })

  fun main() =
    match(a_user_named_bob) {
      | User(r) =>
          println_string(r.name)
    }
}
