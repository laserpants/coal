module Main {

  import Containers.Set(type Set)
  import List(map, reduce)
  import namespace Containers.Set
  import IO(println_string)

  fun main() =
    println_string("!")

  type Shape 
    = ShapeI
    | ShapeO
    | ShapeT
    | ShapeS
    | ShapeZ
    | ShapeJ
    | ShapeL

  type Rotation
    = Rot0
    | Rot90
    | Rot180
    | Rot270

  type Board = Board(Set<(int32, int32)>)

  fun set_square(x : int32, y : int32, Board(set) : Board) : Board =
    Board(set |. Containers.Set.insert((x, y)))

  fun shape_squares(shape : Shape, rotation : Rotation) : Set<(int32, int32)> =
    Containers.Set.from_list 
      .| match(shape) {
           | ShapeO =>
               //          
               //   - - - -
               //   - # # -
               //   - # # -
               //   - - - -
               [ (1, 1)
               , (2, 1)
               , (1, 2)
               , (2, 2)
               ]
           | ShapeI =>
               match(rotation) {
                 | Rot0 =>
                     //   - # - -
                     //   - # - -
                     //   - # - -
                     //   - # - -
                     [ (1, 0)
                     , (1, 1)
                     , (1, 2)
                     , (1, 3)
                     ]
                 | Rot90 =>
                     //   - - - -
                     //   # # # #
                     //   - - - -
                     //   - - - -
                     [ (0, 1)
                     , (1, 1)
                     , (2, 1)
                     , (3, 1)
                     ]
                 | Rot180 =>
                     //   - - # -
                     //   - - # -
                     //   - - # -
                     //   - - # -
                     [ (2, 0)
                     , (2, 1)
                     , (2, 2)
                     , (2, 3)
                     ]
                 | Rot270 =>
                     //   - - - -
                     //   - - - -
                     //   # # # #
                     //   - - - -
                     [ (0, 2)
                     , (1, 2)
                     , (2, 2)
                     , (3, 2)
                     ]
               }
           | ShapeT =>
               match(rotation) {
                 | Rot0 =>
                     //   - # - -
                     //   # # # -
                     //   - - - -
                     //   - - - -
                     [ (1, 0)
                     , (0, 1)
                     , (1, 1)
                     , (2, 1)
                     ]
                 | Rot90 =>
                     //   - - # -
                     //   - - # #
                     //   - - # -
                     //   - - - -
                     [ (2, 0)
                     , (2, 1)
                     , (3, 1)
                     , (2, 2)
                     ]
                 | Rot180 =>
                     //   - - - -
                     //   - - - -
                     //   - # # #
                     //   - - # -
                     [ (1, 2)
                     , (2, 2)
                     , (3, 2)
                     , (2, 3)
                     ]
                 | Rot270 =>
                     //   - - - -
                     //   - # - -
                     //   # # - -
                     //   - # - -
                     [ (1, 1)
                     , (0, 2)
                     , (1, 2)
                     , (1, 3)
                     ]
               }
           | ShapeS =>
               match(rotation) {
                 | Rot0 =>
                     //   # - - -
                     //   # # - -
                     //   - # - -
                     //   - - - -
                     [ (0, 0)
                     , (0, 1)
                     , (1, 1)
                     , (1, 2)
                     ]
                 | Rot90 =>
                     //   - - # #
                     //   - # # -
                     //   - - - -
                     //   - - - -
                     [ (2, 0)
                     , (3, 0)
                     , (1, 1)
                     , (2, 1)
                     ]
                 | Rot180 =>
                     //   - - - -
                     //   - - # -
                     //   - - # #
                     //   - - - #
                     [ (2, 1)
                     , (2, 2)
                     , (3, 2)
                     , (3, 3)
                     ]
                 | Rot270 =>
                     //   - - - -
                     //   - - - -
                     //   - # # -
                     //   # # - -
                     [ (1, 2)
                     , (2, 2)
                     , (0, 3)
                     , (1, 3)
                     ]
               }
           | ShapeZ =>
               match(rotation) {
                 | Rot0 =>
                     //   - # - -
                     //   # # - -
                     //   # - - -
                     //   - - - -
                     [ (1, 0)
                     , (0, 1)
                     , (1, 1)
                     , (0, 2)
                     ]
                 | Rot90 =>
                     //   - # # -
                     //   - - # #
                     //   - - - -
                     //   - - - -
                     [ (1, 0)
                     , (2, 0)
                     , (2, 1)
                     , (3, 1)
                     ]
                 | Rot180 =>
                     //   - - - -
                     //   - - - #
                     //   - - # #
                     //   - - # -
                     [ (3, 1)
                     , (2, 2)
                     , (3, 2)
                     , (2, 3)
                     ]
                 | Rot270 =>
                     //   - - - -
                     //   - - - -
                     //   # # - -
                     //   - # # -
                     [ (0, 2)
                     , (1, 2)
                     , (1, 3)
                     , (2, 3)
                     ]
               }
           | ShapeJ =>
               match(rotation) {
                 | Rot0 =>
                     //   - # # -
                     //   - # - -
                     //   - # - -
                     //   - - - -
                     [ (1, 0)
                     , (2, 0)
                     , (1, 1)
                     , (1, 2)
                     ]
                 | Rot90 =>
                     //   - - - -
                     //   - # # #
                     //   - - - #
                     //   - - - -
                     [ (1, 1)
                     , (2, 1)
                     , (3, 1)
                     , (3, 2)
                     ]
                 | Rot180 =>
                     //   - - - -
                     //   - - # -
                     //   - - # -
                     //   - # # -
                     [ (2, 1)
                     , (2, 2)
                     , (1, 3)
                     , (2, 3)
                     ]
                 | Rot270 =>
                     //   - - - -
                     //   # - - -
                     //   # # # -
                     //   - - - -
                     [ (0, 1)
                     , (0, 2)
                     , (1, 2)
                     , (2, 2)
                     ]
               }
           | ShapeL =>
               match(rotation) {
                 | Rot0 =>
                     //   # # - -
                     //   - # - -
                     //   - # - -
                     //   - - - -
                     [ (0, 0)
                     , (1, 0)
                     , (1, 1)
                     , (1, 2)
                     ]
                 | Rot90 =>
                     //   - - - #
                     //   - # # #
                     //   - - - -
                     //   - - - -
                     [ (3, 0)
                     , (1, 1)
                     , (2, 1)
                     , (3, 1)
                     ]
                 | Rot180 =>
                     //   - - - -
                     //   - - # -
                     //   - - # -
                     //   - - # #
                     [ (2, 1)
                     , (2, 2)
                     , (2, 3)
                     , (3, 3)
                     ]
                 | Rot270 =>
                     //   - - - -
                     //   - - - -
                     //   # # # -
                     //   # - - -
                     [ (0, 2)
                     , (1, 2)
                     , (2, 2)
                     , (0, 3)
                     ]
               }
      }

  fun offset_squares(x_offset : int32, y_offset : int32, squares : Set<(int32, int32)>) : Set<(int32, int32)> =
    squares 
      |. Containers.Set.map(fn((x, y)) => (x + x_offset, y + y_offset))

  type alias BlockState =
    { shape : Shape
    , rotation : Rotation
    , pos_x : int32
    , pos_y : int32
    }

  type alias GameState = 
    { board : Board
    , current_block : BlockState
    }

  fun move_block(x : int32, y : int32, { shape, rotation, pos_x, pos_y }) : BlockState =
    { shape = shape
    , rotation = rotation
    , pos_x = pos_x + x
    , pos_y = pos_y + y
    }

  fun move_current_block(x : int32, y : int32, { board, current_block }) : GameState =
    { board = board
    , current_block = move_block(x, y, current_block)
    }

  fun can_move_current_block(x : int32, y : int32, { board = Board(board_squares), current_block } : GameState) : bool =
    offset_squares(
      current_block.pos_x + x,
      current_block.pos_y + y,
      shape_squares(current_block.shape, current_block.rotation)
    ) 
      |. Containers.Set.is_empty

  fun incorporate_block({ board = Board(board_squares), current_block } : GameState) : GameState =
    let shape = shape_squares(current_block.shape, current_block.rotation) in 
    let new_board = Containers.Set.union(shape, board_squares)
    in
      { board = Board(new_board), current_block = current_block } 

  fun tick({ board, current_block } as game) : GameState =
    if (game |. can_move_current_block(0, 1)) 
      then
        game |. move_current_block(0, 1)
      else
        game |. incorporate_block

}

