module Main {

  fun digit_to_int32(ch) : Option(int32) =
    match(ch) {
      | '0' => Some(0)
      | '1' => Some(1)
      | '2' => Some(2)
      | '3' => Some(3)
      | '4' => Some(4)
      | '5' => Some(5)
      | '6' => Some(6)
      | '7' => Some(7)
      | '8' => Some(8)
      | '9' => Some(9)
      | _ => None
    };

  fun parse_unsigned(str : string) : Option(int32) =
    let 
      chars = 
        string_to_list(str)
      in
        fold(chars) {
          | ch :: chs =>
              ?
          | [] =>
              ?
        };

  trait JsonSerializable(a) {
    to_json : a -> string;
    from_json : string -> Option(a)
  }

  instance JsonSerializable(int32) {
    to_json = int32_to_string;
    from_json = fn(_) => Some(1);
  }

  fun main() =
    trace_string(to_json(1234 : int32));
}
