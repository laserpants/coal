module Main {

  type List(a) 
    = Nil 
    | Cons(a, List(a))

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    };

  cotype Stream = { Head : int32, Tail : Stream }

  fun take_head(s) = 
    s.Head;

  let nats =
    let 
      go =
        unfold @f(n) { 
          , Head = n
          , Tail = f(n + 1) 
        }
//        unfold(@f as n, 0) { Head = n, Tail = f(n + 1) }
      in
        go(0);

  fun main() = 
    trace_int32(nats.Head);

}
