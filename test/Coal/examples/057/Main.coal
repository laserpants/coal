module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  fun get_name2(p) = 
    match(p) {
      | ((name, _, _)) =>
          name
    }

  fun get_name((name, _, _)) : string = 
    name 

  fun main() =
    println_string(get_name(("Lorenzo", 42 : int32, false)))

}
