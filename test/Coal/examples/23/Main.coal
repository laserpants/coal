module Main {

  trait JsonSerializable(a) {
    to_json : a -> string;
    from_json : string -> Option(a)
  }

  a_user_named_lazarus = 
    { name = "Lazarus"
    , uid = 2 : int32
    };

  instance JsonSerializable({ name : string, uid : int32 }) {
    to_json =
      fn(s) => "";
    from_json =
      fn(d) => 
        Some({ name = "TODO", uid = 1 });
  }

  fun main() =
    trace_string(a_user_named_lazarus.name);
}
