module Main {

  import IO(println_string, println_int32, println_bool)

  type MyList<a> 
    = Nil 
    | Cons(a, MyList<a>)

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      // TODO: This should fail
      | @next => next + 1
    }

  fun main() = 
    println_int32(len(Cons("a", Nil)))

}
