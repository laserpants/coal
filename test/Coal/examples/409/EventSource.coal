/**
 * Event source abstraction for composable, blocking event sources.
 *
 * An `EventSource<a>` represents a source of values of type `a` that delivers
 * a value only when data is actually available (unlike `Stream<a>`, which
 * produces a value on every step).
 *
 * The key primitive is `select`, which blocks the current thread until at
 * least one of the given sources has data, then returns a pair `(index, value)`
 * identifying which source fired and its value.
 *
 * Blocking contract: `select` blocks until an event is *genuinely* ready. The
 * underlying C primitive (`coal_event_source_select`) must never return on a
 * bare timeout; it must block until a file descriptor is readable or a timer
 * deadline has passed. The `Runtime.blocking_poll` primitive handles
 * the co-recursive event loop so that `select` does not need explicit
 * recursion.
 *
 * Usage:
 *
 * ```
 * import EventSource (EventSource)
 *
 * let kbd_src =
 *   EventSource.from_raw(
 *     fn(_) => #{event_loop_poll_kbd : unit -> int32}(()),
 *     parse_kbd_event,
 *     0
 *   )
 *
 * let tick_src =
 *   EventSource.interval(300, fn(_) => TickEvent)
 *
 * let sources = [kbd_src, tick_src]
 * match(EventSource.select(sources)) {
 *   | (0, event) => handle(event, state)
 *   | (1, event) => handle(event, state)
 * }
 * ```
 */
module EventSource {

  import List(range, map)
  import Runtime(blocking_poll)

  /**
   * An event source of values of type `a`.
   *
   * - `poll`     : A function `unit -> Option<a>` that checks for data
   * - `fd`       : A file descriptor for OS-level select(), or -1
   * - `timer_id` : A registered timer id for interval sources, or -1
   */
  type alias Source<a> =
    { poll : unit -> Option<a>
    , fd : int32
    , timer_id : int32
    }

  /**
   * Create an event source from a raw poll function that returns 0 or a value.
   *
   * Parameters:
   *   raw_poll : unit -> int32 (returns 0 for "no data", non-zero for data)
   *   unwrap   : int32 -> a (converts the raw value)
   *   fd       : File descriptor for select(), or -1
   */
  fun from_raw(raw_poll : unit -> int32, unwrap : int32 -> a, fd : int32) : Source<a> =
    { poll =
        fn(_) =>
          let raw = raw_poll()
          in if (raw != 0) then Some(unwrap(raw)) else None
    , fd = fd
    , timer_id = -1
    }

  /**
   * Create an event source from a polling function.
   *
   * Parameters:
   *   poll_fn : unit -> Option<a>
   *   fd      : File descriptor for select(), or -1
   */
  fun make(poll_fn : unit -> Option<a>, fd : int32) : Source<a> =
    { poll = poll_fn
    , fd = fd
    , timer_id = -1
    }

  /**
   * Create an interval event source that fires every `ms` milliseconds.
   *
   * The timer is registered in the C runtime; `unwrap` converts the raw timer
   * signal (1) into a value of type `a`.
   */
  fun interval(ms : int32, unwrap : int32 -> a) : Source<a> =
    let timer_id = #{coal_event_source_register_timer : int32 -> int32}(ms)(fn(x) => x)
    in
    { poll =
        fn(_) =>
          let fired = #{coal_event_source_poll_timer : int32 -> int32}(timer_id)(fn(x) => x)
          in if (fired != 0) then Some(unwrap(fired)) else None
    , fd = -1
    , timer_id = timer_id
    }

  /**
   * Transform the values produced by an event source.
   */
  fun transform(f : a -> b, source : Source<a>) : Source<b> =
    { poll = fn(_) =>
        match(source.poll()) {
          | Some(v) => Some(f(v))
          | None => None
        }
    , fd = source.fd
    , timer_id = source.timer_id
    }

  /**
   * Filter event source values: only yield values where the predicate is true.
   */
  fun filter(pred : a -> bool, source : Source<a>) : Source<a> =
    { poll = fn(_) =>
        match((source.poll)()) {
          | Some(v) => if (pred(v)) then Some(v) else None
          | None => None
        }
    , fd = source.fd
    , timer_id = source.timer_id
    }

  /**
   * Try each source in order. If any has data, return (index, value).
   */
  fun try_poll(sources : List<Source<a>>) : Option<(int32, a)> =
    fold(sources) {
      | [] => None
      | source :: @rest =>
          match(source.poll()) {
            | Some(v) => Some((0, v))
            | None =>
                match(rest) {
                  | Some((i, v)) => Some((i + 1, v))
                  | None => None
                }
          }
    }

  /**
   * Block until at least one event source has data.
   *
   * First tries polling all sources. If none has data, calls the C-level
   * blocking select() on the file descriptors and timers, then polls again.
   *
   * Returns (index, value) where index is the 0-based position in the
   * sources list.
   *
   * Delegates to the `Runtime.blocking_poll` primitive which handles
   * the co-recursive event loop (try-poll → block → retry) without explicit
   * recursion in the Coal source.
   */
  fun select(sources : List<Source<a>>) : (int32, a) =
    blocking_poll(
      sources,
      try_poll,
      fn(s) =>
        #{coal_event_source_select : List<int32> -> List<int32> -> int32}
          (map(fn(x) => x.fd, s), map(fn(x) => x.timer_id, s))
          (fn(_) => ())
    )

}
