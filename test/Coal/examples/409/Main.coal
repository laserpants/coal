  // Library ----------------------------
  
  type Event
    = Key(int32)
    | Tick
  
  let keyboard_source : Source<Event> =
    from_raw(
      fn(_) => #{event_loop_poll_kbd : unit -> int32}(())(identity),
      Key,
      0  // fd = stdin
    )
    
  fun tick_source(ms : int32) : Source<Event> =
    interval(ms, fn(_) => Tick)

  type alias Handler<s> = 
    s -> Event -> IO<Option<s>>

  type alias System<s> =
    { sources : List<(Source<Event>, Handler<s>)> }
  
  fun register_keyboard_source(target_handler : s -> int32 -> IO<Option<s>>, system : System<s>) : System<s> =
    let
      handler(state, event) =
        match(event) {
          | Key(key) => target_handler(state, key)
          | _ => return(None)
        }
    in
    register_source(keyboard_source, handler, system)

  fun register_tick_source(ms : int32, target_handler : s -> IO<Option<s>>, system : System<s>) : System<s> =
    let
      handler(state, event) =
        match(event) {
          | Tick => target_handler(state)
          | _ => return(None)
        }
    in
    register_source(tick_source(ms), handler, system)

  fun register_source(source : Source<Event>, handler : s -> Event -> IO<Option<s>>, system : System<s>) : System<s> =
    { sources = system.sources <> [(source, handler)]
    }

  fun run_system(init : s, system : System<s>) =
    let
      (sources, handlers) = List.unzip(system.sources)
    in
    #{event_loop_init : unit -> IO<unit>}()(
      fn(_) => event_loop_io(
        init, 
        fn(state) =>
          let (index, event) = select(sources) 
          in
          match(List.element_at(pack(index), handlers)) {
            | Some(handler) =>
                handler(state, event)
            | None =>
                return(None)
          }
      )
    )

}
