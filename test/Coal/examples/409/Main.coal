module Main {

  import EventSource(Source, from_raw, make, interval, select)
  import Coal.Combinators(identity)
  import IO(return, print_string, println_string, println_int32)
  import Coal.Functor (map)
  import Coal.Combinators (fst, snd)
  import Runtime(event_loop_io)
  import Pretty(println)
  import Nat(pack, unpack)
  
  import namespace List
  
  // Example ----------------------------

  type alias State = int32
  
  let initial_state = 0
    
  fun tick_event_handler(counter : State) : IO<Option<State>> =
    let _ = println_int32(counter) 
    in 
    return(Some(counter + 1))

  fun keyboard_event_handler(key_code : int32, counter : State) : IO<Option<State>> = do {
    _ <- println_string("------------");
    _ <- print_string("key pressed: ");
    _ <- println_int32(key_code);
    _ <- println_string("------------");
    return(Some(counter));
  }

  fun main() =
    
    let system = { sources = [] }
    in
    let s2 = register_keyboard_source(keyboard_event_handler, register_tick_source(300, tick_event_handler, system))
    in
    run_system(initial_state, s2)

