module Main {

  import IO(println_string, println_int32, println_bool)
  import Nat(pack, unpack)
  import Stream(type Stream, head, tail, enum_from)

  fun drop(n : int32, s) =
    fold(pack(n), s) {
      | Zero =>
          fn(t) => t
      | Succ(@next) =>
          fn(t) => next(t |.tail)
    }

  let nats = enum_from(0)

  fun main() = 
    println_int32(drop(100, nats) |.head)

}
