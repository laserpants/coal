module Main {

  type List(a) 
    = Nil 
    | Cons(a, List(a))

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    };

  cotype Stream(a) = { Head : a, Tail : Nats(a) }

  fun enum_from(n : int32) =
    unfold(@f, n) fn(x) => { Head = x, Tail = f(x + 1) };

