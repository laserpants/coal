module Main {

  type List<a> 
    = Nil 
    | Cons(a, List<a>)

  fun len(lst) =
    fold(lst) {
      | Nil => 0
      | Cons(_, @next) => next + 1
    }

  cotype Stream = { Head : int32, Tail : Stream }

  fun take_head(s) = 
    s.Head

  fun drop(n : int32, s) =
    fold(pack_nat(n), s) {
      | Zero =>
          fn(t) => t
      | Succ(@next) =>
          fn(t) => next(t.Tail)
    }

  unfold enum_from(n : int32) : Stream<int32> { 
    , Head = n
    , Tail = enum_from(n + 1)
  }

  let nats = enum_from(0)

  fun main() = 
    trace_int32(drop(100, nats).Head)
}
