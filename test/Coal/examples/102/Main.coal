module Main {

  import IO(println_string, println_int32, println_bool)

  trait Foo<a> {
    foo: a -> int32
  }

  instance Foo<string> {
    let foo = fn(x) => 3 : int32
  }

  instance Foo<int32> {
    let foo = fn(x) => 3 : int32
  }

  instance Foo<List<a>> with (Foo<a>) {
    let foo = 
      fn(xs) => 
        match(xs) {
          | [] => 1
          | x :: _ => 
              foo(x)
        }
  }

  fun main() =
    let
       zs = foo([5, 5, 5 : int32])
     in
       println_int32(zs : int32)

}
