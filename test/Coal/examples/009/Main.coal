module Main {

  import IO(println_string)

  fun main() =
    let 
      r = 
        { a = "hello", b = { msg = "wat" } }
      in
        match(r) {
          | { b = b, a = _ } =>
            match(b) {
              | { msg = msg } =>
                println_string(msg)
            }
        }
}
