module Main {

  fun fib(p : nat) =
    let (res, _) =
      fold(p - 1) {
        | Zero => 
            (1 : nat, 1)
        | Succ(@x) => 
            let 
              (m, n) = x
            in 
              (n, m + n)
      }
    in
      res

  fun main() =
    trace_int32(unpack_nat(fib(6)))

}
