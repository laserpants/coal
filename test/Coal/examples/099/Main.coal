module Main {

  import IO(println_string, println_int64, println_bool)

  import Nat(pack, unpack)

  fun fib(p : nat) =
    let (res, _) =
      fold(p - 1) {
        | Zero => 
            (1 : nat, 1)
        | Succ(@x) => 
            let 
              (m, n) = x
            in 
              (n, m + n)
      }
    in
      res

  fun main() =
    println_int64(unpack(fib(6)))

}
