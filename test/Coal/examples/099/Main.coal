module Main {

  import IO(println_nat)

  import Nat(unpack, pred)

  fun fib(p : nat) =
    let (res, _) =
      fold(pred(p)) {
        | Zero => 
            (1 : nat, 1)
        | Succ(@x) => 
            let 
              (m, n) = x
            in 
              (n, m + n)
      }
    in
      res

  fun main() =
    println_nat(fib(6))

}
