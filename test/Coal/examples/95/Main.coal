module Main {

  type JsonValue
    = JsonNull
    | JsonBool(bool)
    | JsonNumber(double)
    | JsonString(string)
    | JsonArray(List<JsonValue>)
    | JsonObject(List<(string, JsonValue)>)

  fun enclosed(lhs, rhs, str) =
    lhs +++ str +++ rhs

  fun field_pair(lhs, rhs) =
    enclosed("\"", "\"", lhs) +++ ":" +++ rhs

  fun reduce(f : a -> b -> b, init : b, list : List<a>) : b =
    fold(list, init) {
      | [] => 
          fn(r) => r
      | q :: @go =>
          fn(r) => go(f(q, r))
    }

  fun to_comma_separated_str(strs : List<string>) : string =
    match(strs) {
      | [] => ""
      | head :: tail => head +++ reduce(fn(t, s) => s +++ "," +++ t, "", tail)
    }

  fun encode(value : JsonValue) : string =
    fold(value) {
      | JsonNull => "null"
      | JsonBool(false) => "false"
      | JsonBool(true) => "true"
      | JsonNumber(d) => double_to_string(d)
      | JsonString(str) => enclosed("\"", "\"", str)

      | JsonArray([]) => ""
      | JsonArray(@v :: vs) => v

//      | JsonObject(fields) =>
//          enclosed(
//            "{", "}", 
//            to_comma_separated_str(
//              fold encode_fields(fields) {
//                | [] => []
//                | (key, encode_value(@value)) :: encode_fields(@rest) => 
//                    field_pair(key, value) :: rest 
//              })
//            )
    }

  let test_obj = 
    JsonObject(
      [ ("abc", JsonArray([JsonString("a"), JsonString("b"), JsonString("c")]))
      , ("pi", JsonNumber(3.14159))
      ])

  fun main() =
    trace_string(encode(test_obj))

}

