module Main {

  fun reduce(op : a -> b -> b, init : b, list : List<a>) : b =
    fold(list, init) {
      | [] => fn(r) => r
      | q :: @go => fn(r) => go(op(q, r))
    }

  fun uncons(list : List<a>) : Option<(a, List<a>)> =
    match(list) {
      | x :: xs => Some((x, xs))
      | [] => None
    }

  type JsonValue
    = JsonNull
    | JsonBool(bool)
    | JsonNumber(double)
    | JsonString(string)
    | JsonArray(List<JsonValue>)
    | JsonObject(List<(string, JsonValue)>)

  fun encode(value : JsonValue) : string =
    fold encode_value(value) {
      | JsonNull => "null"
      | JsonBool(false) => "false"
      | JsonBool(true) => "true"
      | JsonNumber(d) => double_to_string(d)
      | JsonString(str) => enclosed("\"", "\"", str)
      | JsonArray(values) =>
          enclosed(
            "[", "]", 
            to_comma_separated_str(
              fold encode_array(values) {
                | [] => []
                | encode_value(@x) :: encode_array(@xs) => x :: xs
              })
            )
      | JsonObject(fields) =>
          enclosed(
            "{", "}", 
            to_comma_separated_str(
              fold encode_fields(fields) {
                | [] => []
                | (key, encode_value(@value)) :: encode_fields(@rest) => 
                    field_pair(key, value) :: rest 
              })
            )
    }
  where
    fun enclosed(lhs, rhs, str) =
      lhs +++ str +++ rhs

    fun field_pair(lhs, rhs) =
      enclosed("\"", "\"", lhs) +++ ":" +++ rhs

    fun to_comma_separated_str(strs : List<string>) : string =
      match(uncons(strs)) {
        | None => ""
        | Some((head, tail)) => head +++ reduce(fn(t, s) => enclosed(s, t, ","), "", tail)
      }

  let test_obj = 
    JsonObject(
      [ ("abc", JsonArray([JsonString("a"), JsonString("b"), JsonString("c")]))
      , ("pi", JsonNumber(3.14159))
      ])

  fun main() =
    trace_string(encode(test_obj))

}
