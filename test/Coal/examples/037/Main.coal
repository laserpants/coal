module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  trait X<a> {
    x : bool -> a
  }

  instance X<bool> {
    let x = fn(z) => true
  }

  fun foo(z) = 
    let 
      a =
        x(false)
      in
        println_bool(a)

  fun main() = 
    foo(2 : int32)
}
