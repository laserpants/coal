module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  fun parse_unsigned(a : bool) : Option<int32> =
    fold([], Some(5)) {
      | ch :: _ =>
          fn(t) => Some(3)
      | [] =>
          fn(t) => t
    }

  fun main() =
    match(parse_unsigned(false)) {
      | Some(a) =>
          println_int32(a)
      | None =>
          println_string("b")
    }

}
