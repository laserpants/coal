module Main {

  import IO(println_int32, println_bool, println_string, println_char)

  fun remove_name(r : { name : string | t }) : { | t } =
    match(r) {
      | { name = x | q } =>
          q
    }

  fun main() =
    let
      q =
        remove_name({ name = "Tron", is_admin = true })
      in
        println_bool(q.name)

}
