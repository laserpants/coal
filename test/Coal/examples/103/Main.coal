module Main {

  cotype Stream = { Head : int32, Tail : Stream }

  fun repeat_times(n : int32, f : a -> a) =
    fold(pack_nat(n)) {
      | Zero =>
          fn(t) => t
      | Succ(@next) =>
          fn(t) => next(f(t))
    }

  unfold enum_from(n : int32) : Stream<int32> { 
    , Head = n
    , Tail = enum_from(n + 1)
  }

  let nats = enum_from(0)

  fun drop_one(s) = s.Tail

  fun main() = 
    let
      go =
        repeat_times(1000, drop_one)
      in
        trace_int32(go(nats).Head)
}
