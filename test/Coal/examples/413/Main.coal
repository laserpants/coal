module Main {

  import namespace IO

  // No return annotation: `5` is inferred as `a with Numeric<a>`, so the
  // `let x = f(())` in `main` must NOT be generalized over that constraint —
  // otherwise `x` becomes a dictionary lambda that is re-applied (and `f`
  // re-evaluated) at each use, printing "f called" twice.
  fun f(() : unit) =
    let
      // `f` is pure (`unit -> int32`), so this trace cannot be sequenced with
      // `do`-notation. Force it explicitly instead; `unsafe_perform` is
      // `unsafePerformIO`, and is acceptable here only because this is a
      // debug trace in a pure function.
      _ = IO.unsafe_perform(IO.println_string("f called"))
    in
    5

  fun main() =
    let
      x = f(() : unit)
    in
    IO.println_int32(x + x)

}