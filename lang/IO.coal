module IO {

  import Nat(unpack)

  fun println_string(s : string) : IO<unit> =
    io$_println_string(s)

  fun print_string(s : string) : IO<unit> =
    io$_print_string(s)

  fun println_int32(n : int32) : IO<unit> =
    io$_println_int32(n)

  fun print_int32(n : int32) : IO<unit> =
    io$_print_int32(n)

  fun println_int64(n : int64) : IO<unit> =
    io$_println_int64(n)

  fun print_int64(n : int64) : IO<unit> =
    io$_print_int64(n)

  fun println_bignum(b : bignum) : IO<unit> =
    io$_println_bignum(b)

  fun print_bignum(b : bignum) : IO<unit> =
    io$_print_bignum(b)

  fun println_bool(b : bool) : IO<unit> =
    io$_println_bool(b)

  fun print_bool(b : bool) : IO<unit> =
    io$_print_bool(b)

  fun println_char(c : char) : IO<unit> =
    io$_println_char(c)

  fun print_char(c : char) : IO<unit> =
    io$_print_char(c)

  fun println_float(f : float) : IO<unit> =
    io$_println_float(f)

  fun print_float(f : float) : IO<unit> =
    io$_print_float(f)

  fun println_double(d : double) : IO<unit> =
    io$_println_double(d)

  fun print_double(d : double) : IO<unit> =
    io$_print_double(d)

  fun println_nat(n : nat) : IO<unit> =
    io$_println_int32(unpack(n))

  fun print_nat(n : nat) : IO<unit> =
    io$_print_int32(unpack(n))

  fun __eval_io(io_val : IO<v>) : v =
    io$_eval(io_val)

  fun __return_io(val : v) : IO<v> =
    io$_return(val)

  let return = __return_io

  type FileIOResult

  type FileIOError 
    = FileNotFound
    | InvalidInput
    | IOError
    | OutOfMemory
    | UnknownError

  fun read_file(path : string) : IO<Result<string, FileIOError>> =
    let
      decode_file_result(r : FileIOResult) =
        #{coal_result_status : FileIOResult -> int32}(r)(
          fn(status) => 
            match(status) {
              | 0 => #{coal_result_value : FileIOResult -> string}(r)(Ok)
              | 1 => Err(FileNotFound)
              | 2 => Err(IOError)
              | 3 => Err(OutOfMemory)
              | _ => Err(UnknownError)
            })
    in
    #{coal_read_file : string -> FileIOResult}(path)(
      fn(res) => __return_io(decode_file_result(res)))

  fun write_file(path : string, data : string) : IO<Option<FileIOError>> =
    let
      decode_write_result(r : FileIOResult) =
        #{coal_result_status : FileIOResult -> int32}(r)(
          fn(status) => 
            match(status) {
              | 0 => None
              | 1 => Some(InvalidInput)
              | 2 => Some(IOError)
              | _ => Some(UnknownError)
            })
    in
    #{coal_write_file : string -> string -> FileIOResult}(path, data)(
      fn(res) => __return_io(decode_write_result(res)))

  fun readln(_ : unit) : IO<string> =
    #{coal_readln : unit -> string}(())(fn(str) => __return_io(str))

  fun random(_ : unit) : IO<double> =
    #{coal_double_random : unit -> double}(())(fn(d) => __return_io(d))

}
