  fun ap_free(f : Free<f, a -> b>, fa : Free<f, a>) : Free<f, b> =
    // must be implemented at the Kernel level, due to recursion
  
  fun bind_free(ma : Free<f, a>, f : a -> Free<f, b>) : Free<f, b> =
    // must be implemented at the Kernel level, due to recursion
  
  instance Functor<Free<f>> with (Functor<f>) {
    let map = map_free
  }

  instance Applicative<Free<f>> with (Functor<Free<f>>) {
    let ap = ap_free
    let pure = pure_free
  }

  instance Monad<Free<f>> with (Applicative<Free<f>>) {
    let bind = bind_free
  }
    
}