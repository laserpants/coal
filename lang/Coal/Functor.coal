module Functor {

  import namespace List

  trait Functor<f : * -> *> {
    map : (a -> b) -> f<a> -> f<b>
  }

  instance Functor<List> {
    let map = List.map
  }

  instance Functor<Option> {
    fun map(f, opt) = 
      match(opt) {
        | None => 
            None
        | Some(val) =>
            Some(f(val))
      }
  }

}
