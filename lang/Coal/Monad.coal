/**
 * Monads extend applicative functors with sequential composition, allowing 
 * effectful computations to be chained where each step depends on the result 
 * of the previous one.
 */
module Coal.Monad {

  import Coal.Combinators(flip, always, identity)
  import Coal.Applicative(Applicative)
  import IO(__defer, __eval_io)
  import namespace List

  /**
   * Trait that extends `Applicative` with `bind` (also known as flat-map), 
   * enabling sequential composition of effectful computations.
   *
   * - `bind : m<a> -> (a -> m<b>) -> m<b>`
   */
  trait Monad<m> with (Applicative<m>) {
    bind : m<a> -> (a -> m<b>) -> m<b>
  }

  instance Monad<List> {
    // bind : List<a> -> (a -> List<b>) -> List<b>
    fun bind(xs, f) = List.concat_map(f, xs)
  }

  instance Monad<Option> {
    // bind : Option<a> -> (a -> Option<b>) -> Option<b>
    fun bind
      | None, _    => None
      | Some(x), f => f(x) 
  }

  instance Monad<IO> {
    // Defer the whole chain: forcing the resulting action runs `v`, then `f`
    // on its result, and finally the action `f` produces.
    fun bind(v, f) = __defer(fn(_) => __eval_io(f(__eval_io(v))))
  }

  /**
   * `then_do` sequences two monadic actions, discarding the result of the
   * first and returning the second.
   *
   * **Type**: `then_do : m<a> -> m<b> -> m<b> with (Monad<m>)`
   */
  fun then_do(a : m<a>, b : m<b>) : m<b> with (Monad<m>) =
    bind(a, always(b))

  /**
   * `and_then` is `bind` with its arguments flipped: the continuation comes
   * first, making it read like "and then do this with the result".
   *
   * **Type**: `and_then : (a -> m<b>) -> m<a> -> m<b> with (Monad<m>)`
   */
  let and_then : (a -> m<b>) -> m<a> -> m<b> with (Monad<m>) =
    flip(bind)

  /**
   * `and_always` is `then_do` with its arguments flipped: the second action is
   * evaluated first, and the first is returned.
   *
   * **Type**: `and_always : m<b> -> m<a> -> m<a> with (Monad<m>)`
   */
  let and_always = flip(then_do)

  /**
   * `and_return` is `and_always` composed with `pure`: it runs the given monadic
   * action, discarding its result, and returns the given pure value.
   *
   * **Type**: `and_return : a -> m<b> -> m<a> with (Monad<m>)`
   */
  let and_return = and_always << pure

  /**
   * `join` flattens a nested monadic value by one level, transforming
   * `m<m<a>>` into `m<a>`. It is equivalent to `bind` with the identity
   * function.
   *
   * **Type**: `join : m<m<a>> -> m<a> with (Monad<m>)`
   */
  let join = flip(bind, identity)

  /**
   * `only_when` conditionally executes an applicative action: it returns the given
   * action when the predicate is `true`, and an action that produces `()` (and
   * so has no effect) otherwise.
   *
   * **Type**: `only_when : bool -> f<unit> -> f<unit> with (Applicative<f>)`
   */
  fun only_when(pred : bool, s : f<unit>) : f<unit> with (Applicative<f>) =
    if (pred) then s else pure()

  /**
   * `unless` is the negation of `only_when`: it runs the given applicative
   * action only when the predicate is `false`, and does nothing otherwise.
   *
   * **Type**: `unless : bool -> f<unit> -> f<unit> with (Applicative<f>)`
   */
  fun unless(pred : bool, s : f<unit>) : f<unit> with (Applicative<f>) =
    only_when(! pred, s)

}
