module Coal.Monad {

  import Coal.Combinators(flip, always)
  import Coal.Applicative(Applicative)
  import IO(__eval_io)
  import namespace List

  trait Monad<m> with (Applicative<m>) {
    bind : m<a> -> (a -> m<b>) -> m<b>
  }

  instance Monad<List> {
    // bind : List<a> -> (a -> List<b>) -> List<b>
    fun bind(xs, f) = List.concat_map(f, xs)
  }

  instance Monad<Option> {
    // bind : Option<a> -> (a -> Option<b>) -> Option<b>
    fun bind
      | None, _    => None
      | Some(x), f => f(x) 
  }

  instance Monad<IO> {
    fun bind(v, f) = f(__eval_io(v))
  }

  fun then_do(a : m<a>, b : m<b>) : m<b> with (Monad<m>) =
    bind(a, always(b))

  let and_then : (a -> m<b>) -> m<a> -> m<b> with (Monad<m>) =
    flip(bind)

  let and_eval = flip(then_do)

}
