module Coal.Monad {

  import Coal.Combinators(flip, always)
  import Coal.Applicative(trait Applicative)
  import IO(__eval_io)

  trait Monad<m> with Applicative<m> {
    bind : m<a> -> (a -> m<b>) -> m<b>
  }

  instance Monad<IO> {
    fun bind(v, f) = f(__eval_io(v))
  }

  fun then_do(a : m<a>, b : m<b>) : m<b> =
    bind(a, always(b))

  let and_then : (a -> m<b>) -> m<a> -> m<b> =
    flip(bind)

  let and_eval = flip(then_do)

}
