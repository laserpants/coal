/** 
 * Numeric utilities and conversions.
 */
module Number {

  /**
   * Maximum value representable by a 32-bit signed integer.
   */
  let _INT32_MAX : int32 = 2147483647

  /**
   * Maximum value representable by a 64-bit signed integer.
   */
  let _INT64_MAX : int64 = 9223372036854775807

  /**
   * Minimum value representable by a 32-bit signed integer.
   */
  let _INT32_MIN : int32 = -2147483648

  /**
   * Minimum value representable by a 64-bit signed integer.
   */
  let _INT64_MIN : int64 = -9223372036854775808

  /**
   * Convert a 32-bit integer to a float.
   *
   * **Type**: `int32_to_float : int32 -> float`
   */
  fun int32_to_float(n : int32) : float =
    #{coal_int32_to_float : int32 -> float}(n)(fn(f) => f)

  /**
   * Convert a 32-bit integer to a double.
   *
   * **Type**: `int32_to_double : int32 -> double`
   */
  fun int32_to_double(n : int32) : double =
    #{coal_int32_to_double : int32 -> double}(n)(fn(d) => d)

  /**
   * Convert a 64-bit integer to a float.
   *
   * **Type**: `int64_to_float : int64 -> float`
   */
  fun int64_to_float(n : int64) : float =
    #{coal_int64_to_float : int64 -> float}(n)(fn(f) => f)

  /**
   * Convert a 64-bit integer to a double.
   *
   * **Type**: `int64_to_double : int64 -> double`
   */
  fun int64_to_double(n : int64) : double =
    #{coal_int64_to_double : int64 -> double}(n)(fn(d) => d)

  /**
   * Convert a float to a 32-bit integer.
   *
   * **Type**: `float_to_int32 : float -> int32`
   */
  fun float_to_int32(f : float) : int32 =
    #{coal_float_to_int32 : float -> int32}(f)(fn(n) => n)

  /**
   * Convert a double to a 32-bit integer.
   *
   * **Type**: `double_to_int32 : double -> int32`
   */
  fun double_to_int32(d : double) : int32 =
    #{coal_double_to_int32 : double -> int32}(d)(fn(n) => n)

  /**
   * Convert a float to a 64-bit integer.
   *
   * **Type**: `float_to_int64 : float -> int64`
   */
  fun float_to_int64(f : float) : int64 =
    #{coal_float_to_int64 : float -> int64}(f)(fn(n) => n)

  /**
   * Convert a double to a 64-bit integer.
   *
   * **Type**: `double_to_int64 : double -> int64`
   */
  fun double_to_int64(d : double) : int64 =
    #{coal_double_to_int64 : double -> int64}(d)(fn(n) => n)

  /**
   * Parse a decimal string into a bignum.
   *
   * Returns `None` if parsing fails, otherwise `Some(bignum)`.
   *
   * **Type**: `parse_bignum : string -> Option<bignum>`
   */
  fun parse_bignum(input : string) : Option<bignum> =
    #{coal_bignum_init : string -> bignum}(input)(fn(res) => 
      #{rt_is_null : bignum -> bool}(res)(fn(is_null) => 
        if (is_null) then None else Some(res)))

  /**
   * Convert a bignum to a float.
   *
   * **Type**: `bignum_to_float : bignum -> float`
   */
  fun bignum_to_float(n : bignum) : float =
    #{coal_bignum_to_float : bignum -> float}(n)(fn(f) => f)

  /**
   * Convert a bignum to a double.
   *
   * **Type**: `bignum_to_double : bignum -> double`
   */
  fun bignum_to_double(n : bignum) : double =
    #{coal_bignum_to_double : bignum -> double}(n)(fn(d) => d)

  /**
   * Convert a bignum to its string representation.
   *
   * **Type**: `bignum_to_string : bignum -> string`
   */
  fun bignum_to_string(n : bignum) : string =
    #{coal_bignum_to_string : bignum -> string}(n)(fn(s) => s)

  /**
   * Return the greater of two comparable values.
   *
   * **Type**: `max : a -> a -> a with (Ordered<a>)`
   */
  fun max(a, b) = if (a > b) then a else b

  /**
   * Compute the maximum element of a list.
   *
   * Returns `None` for an empty list.
   *
   * **Type**: `maximum : List<a> -> Option<a> with (Ordered<a>)`
   */
  fun maximum(elems : List<a>) : Option<a> with (Ordered<a>) =
    fold(elems) {
      | [] => None
      | a :: @rest =>
          match(rest) {
            | None => Some(a)
            | Some(b) => Some(max(a, b))
          }
    }

  /**
   * Test whether a number is even.
   *
   * **Type**: `is_even : a -> bool with (Modulo<a>)`
   */
  fun is_even(n) = 
    n % 2 == 0

  /**
   * Test whether a number is odd.
   *
   * **Type**: `is_odd : a -> bool with (Modulo<a>)`
   */
  fun is_odd(n) = 
    n % 2 == 1

}