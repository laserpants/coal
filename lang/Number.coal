module Number {

  let _INT32_MAX = 2147483647

  let _INT64_MAX = 9223372036854775807

  fun int32_to_float(n : int32) : float =
    #{int32_to_float : int32 -> float}(n)(fn(f) => f)

  fun int32_to_double(n : int32) : double =
    #{int32_to_double : int32 -> double}(n)(fn(d) => d)

  fun int64_to_float(n : int64) : float =
    #{int64_to_float : int64 -> float}(n)(fn(f) => f)

  fun int64_to_double(n : int64) : double =
    #{int64_to_double : int64 -> double}(n)(fn(d) => d)

  fun float_to_int32(f : float) : int32 =
    #{float_to_int32 : float -> int32}(f)(fn(n) => n)

  fun double_to_int32(d : double) : int32 =
    #{double_to_int32 : double -> int32}(d)(fn(n) => n)

  fun float_to_int64(f : float) : int64 =
    #{float_to_int64 : float -> int64}(f)(fn(n) => n)

  fun double_to_int64(d : double) : int64 =
    #{double_to_int64 : double -> int64}(d)(fn(n) => n)

  fun parse_bignum(input : string) : Option<bignum> =
    #{bignum_init : string -> bignum}(input)(fn(res) => 
      #{is_null : bignum -> bool}(res)(fn(yes) => 
        if (yes) then None else Some(res)))

  fun max(a, b) = if (a > b) then a else b

  fun maximum(elems : List<a>) : Option<a> =
    fold(elems) {
      | [] => None
      | a :: @rest =>
          match(rest) {
            | None => Some(a)
            | Some(b) => Some(max(a, b))
          }
    }

  fun is_even(n) = 
    n % 2 == 0

  fun is_odd(n) = 
    n % 2 == 1

}
