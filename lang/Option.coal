module Option {

  /**
   * Extract a value of type `a` from an `Option<a>` by providing a default 
   * value for the case when the input is `None`.
   */ 
  fun with_default
    | _, Some(value) = value
    | value, _       = value

  fun is_some 
    | Some(_) = true
    | None    = false
    
  fun is_none
    | None    = true
    | Some(_) = false

  fun option(fallback : b, f : a -> b, value : Option<a>) : b =
    match(value) {
      | Some(x) => f(x)
      | None => fallback
    }

}
