/**
 * Utilities for working with the built-in `Option` type, which represents 
 * optional values — values that may or may not be present.
 */
module Option {

  instance Comparable<Option<a>> {
    fun `==`(lhs, rhs) =
      match((lhs, rhs)) {
        | (Some(x), Some(y)) => x == y
        | (None, None) => true
        | (_, _) => false
      }
  }

  /**
   * Extract a value of type `a` from an `Option<a>` by providing a default 
   * value for the case when the input is `None`.
   *
   * **Type**: `with_default : a -> Option<a> -> a`
   */ 
  fun with_default
    | _, Some(value) => value
    | value, _       => value

  /**
   * Return `true` if the given value is constructed with `Some`, and `false` 
   * otherwise.
   *
   * **Type**: `is_some : Option<a> -> bool`
   */
  fun is_some 
    | Some(_) => true
    | None    => false

  /**
   * Return `true` if the given value is `None`, and `false` otherwise.
   *
   * **Type**: `is_none : Option<a> -> bool`
   */
  fun is_none
    | None    => true
    | Some(_) => false

  /**
   * From a default value of type `b`, a function of type `a -> b`, and an 
   * `Option<a>` value, apply the function to the value inside the `Some` 
   * constructor and return the result, or if the value is `None`, return
   * the default value.
   *
   * **Type**: `option : b -> (a -> b) -> Option<a> -> b`
   */
  fun option(default : b, f : a -> b, value : Option<a>) : b =
    match(value) {
      | Some(x) => f(x)
      | None => default
    }

  /**
   * Collect all values contained in `Some` constructors from a list of
   * `Option<a>` values, discarding occurrences of `None`.
   *
   * **Type**: `cat_options : List<Option<a>> -> List<a>`
   */
  fun cat_options(options : List<Option<a>>) : List<a> =
    fold(options) {
      | [] => []
      | Some(value) :: @rest => value :: rest
      | _ :: @rest => rest
    }

  /**
   * Convert a list to an `Option<a>` by returning `Some` applied to the first
   * element of the list, or `None` if the list is empty.
   *
   * **Type**: `list_to_option : List<a> -> Option<a>`
   */
  fun list_to_option(list : List<a>) : Option<a> =
    match(list) {
      | [] => None
      | head :: _ => Some(head)
    }

  /**
   * Convert an `Option<a>` value to a list by returning a singleton list
   * containing the value if it is `Some`, or the empty list if it is `None`.
   *
   * **Type**: `option_to_list : Option<a> -> List<a>`
   */
  fun option_to_list(option: Option<a>) : List<a> =
    match(option) {
      | Some(value) => [value]
      | None => []
    }

}
