module List {

  import Coal.Combinators(always, identity)

  /**
   * Return the first element of the list wrapped in `Some`, or `None` if the
   * list is empty.
   */
  fun head : List<a> -> Option<a> 
    | [] = None
    | x :: _ = Some(x)

  /**
   * Return the list without its first element, or `None` if the list is empty.
   */
  fun tail : List<a> -> Option<List<a>>
    | [] = None
    | _ :: xs = Some(xs)

  /**
   * Return a pair (head, tail) wrapped in `Some`, or `None` if the list is 
   * empty.
   */
  fun uncons(list : List<a>) : Option<(a, List<a>)> =
    match(list) {
      | [] => None
      | x :: xs => Some((x, xs))
    }

  /**
   * Return the length of the list as a natural number.
   */
  fun length(list : List<a>) : nat =
    fold(list) {
      | [] => Zero
      | _ :: @xs => Succ(xs)
    }

  /**
   * Right-associative fold.
   * 
   * Apply the function to each element and an accumulator, starting from the
   * end of the list.
   */
  fun reduce(f : a -> b -> b, init : b, list : List<a>) : b =
    fold(list, init) {
      | [] => identity
      | x :: @go => go << f(x)
    }

  /**
   * Left-associative fold.
   */
  fun reduce_left(f : b -> a -> b, init : b, list : List<a>) : b =
    let
      step(x, g, a) = g(f(a, x))
    in
      reduce(step, identity, list, init)

  /**
   * Return a list containing exactly one element.
   */
  fun singleton(elem : a) : List<a> = 
    [elem]

  /**
   * Return `true` if the list is empty, or `false` otherwise.
   */
  fun is_empty(list : List<a>) : bool =
    match(list) {
      | [] => true
      | _ => false
    }

  /**
   * Return `true` if the list contains any elements, or `false` otherwise.
   */
  fun is_nonempty(list : List<a>) : bool =
    ! is_empty(list)

  /**
   * Return `true` if the list contains precisely one element, or `false` 
   * otherwise.
   */
  fun is_singleton(list : List<a>) : bool =
    match(list) {
      | [_] => true
      | _   => false
    }

  /**
   * Flatten a list of lists into a single list.
   */
  fun concat(list : List<List<a>>) : List<a> =
    fold(list) {
      | [] => []
      | xs :: @xss => xs ++ xss
    }

  /**
   * Return the first `n` elements of the list.
   * 
   * If the list is shorter than `n`, return the whole list.
   */
  fun take(n : nat, list : List<a>) : List<a> =
    fold(n, list) {
      | Zero => 
          always([])
      | Succ(@m) => 
          fn(xs) =>
            match(xs) {
              | [] => []
              | head :: tail => head :: m(tail)
            }
    }

  /**
   * Remove the first `n` elements from the list.
   *
   * If the list is shorter than `n`, return an empty list.
   */
  fun drop(n : nat, list : List<a>) : List<a> =
    fold(n, list) {
      | Zero => 
          identity
      | Succ(@m) => 
          fn(xs) => 
            match(xs) {
              | [] => m([])
              | _ :: tail => m(tail)
            }
    }

  /**
   * Extract a range of elements from the list.
   *
   * slice(m, n, xs) = xs |. drop(m) |. take(n - m)
   */
  fun slice(m : nat, n : nat, list : List<a>) : List<a> =
    list |. drop(m) |. take(n - m)

  /**
   * Return the element at index `n`, or `None` if out of bounds.
   */
  fun element_at(n : nat, list : List<a>) : Option<a> =
    head(drop(n, list)) 

  /**
   * Transform each element of a list using the given function.
   */
  fun map(f : a -> b, list : List<a>) : List<b> =
    fold(list) {
      | [] => []
      | x :: @xs => f(x) :: xs
    }

  /**
   * Apply a function to every element of a list, where that function must 
   * return a list, and then concatenate the resulting lists into a single, 
   * flattened list. 
   */
  fun concat_map(f : a -> List<b>) : List<a> -> List<b> =
    concat << map(f)

  /**
   * Keep only the elements for which the predicate returns `true`.
   */
  fun filter(p : a -> bool, list : List<a>) : List<a> =
    fold(list) {
      | [] => []
      | x :: @xs => if p(x) then x :: xs else xs
    }

  /**
   * Return a new list with the elements in reverse order.
   */
  fun reverse(list : List<a>) : List<a> =
    match(list) {
      | [] => []
      | x :: xs => reduce(fn(head, tail) => head :: tail, [x], xs)
    }

  /**
   * Convert a list of pairs into a pair of lists, in the natural way.
   *
   * E.g., unzip([(1, "one"), (2, "two")]) returns:
   * ([1, 2], ["one", "two"])
   */
  fun unzip(list : List<(a, b)>) : (List<a>, List<b>) =
    fold(list, ([], [])) {
      | [] => 
          identity
      | (x, y) :: @f =>
          fn((xs, ys)) =>
            f((x :: xs, y :: ys))
    }

  /**
   * Convert two lists into a list of pairs, in the natural way.
   *
   * E.g., zip([1, 2], ["one", "two"]) returns:
   * [(1, "one"), (2, "two")]
   */
  fun zip(xs : List<a>, ys : List<b>) : List<(a, b)> =
    let step(x, f) =
      match {
        | [] => []
        | y :: ys_ => (x, y) :: f(ys_)
      }
    in
    reduce(step, always([]), xs, ys)

  fun any(p : a -> bool, list : List<a>) : bool =
    fold(list) {
      | [] => false
      | x :: @xs => if (p(x)) then true else xs
    }

  fun all(p : a -> bool, list : List<a>) : bool =
    fold(list) {
      | [] => true
      | x :: @xs => if(! p(x)) then false else xs
    }

  fun find(p : a -> bool, list : List<a>) : Option<a> =
    fold(list) {
      | [] => None
      | x :: @xs => if (p(x)) then Some(x) else xs
    }

}
