/**
 * Network.HTTP - a small, synchronous/buffered HTTP client for Coal.
 *
 * HTTP requests and responses are ordinary immutable data; all network
 * communication happens explicitly through `IO`. Creating a `Request` never
 * touches the network.
 *
 * The first version supports HTTP/1.0 and HTTP/1.1 (HTTP/1.1 by default),
 * `GET`/`POST`/`PUT`/`PATCH`/`DELETE`/`HEAD`/`OPTIONS`, custom headers and
 * buffered response bodies. One request uses one connection (`Connection:
 * close`); there is no pooling, redirects, cookies, TLS or streaming.
 *
 * An HTTP status like 404 is returned as `Ok(Response(...))`; only failures
 * to communicate with the server or malformed protocol data produce `Err`.
 */
module Network.HTTP(
  Method,
  Version,
  URL,
  Headers,
  Request,
  Response,
  ResponseHead,
  Bytes,
  Client,
  Error,
  method_to_string,
  version_to_string,
  parse_url,
  url_to_string,
  empty_headers,
  get_header,
  set_header,
  remove_header,
  has_header,
  request,
  get_request,
  post_request,
  put_request,
  delete_request,
  response_version,
  response_status,
  response_headers,
  response_body,
  is_success,
  is_redirect,
  is_client_error,
  is_server_error,
  bytes_empty,
  bytes_from_string,
  bytes_to_string,
  bytes_length,
  create,
  send,
  get,
  post,
  put,
  delete,
  parse_response_head,
  serialize_request_head,
  error_to_string
) {

  import IO(__return_io)
  import namespace String
  import namespace List
  import namespace Option
  import namespace Char

  // --------------------------------------------------------------------------
  // Core types
  // --------------------------------------------------------------------------

  /** HTTP request methods. */
  type Method
    = GET
    | POST
    | PUT
    | PATCH
    | DELETE
    | HEAD
    | OPTIONS

  /** HTTP protocol version. */
  type Version
    = HTTP10
    | HTTP11

  /** Opaque byte buffer used for request/response bodies. */
  type Bytes

  /** Errors produced by the HTTP client. */
  type Error
    = InvalidURL(string)
    | UnsupportedScheme(string)
    | UnsupportedHTTPS
    | ConnectionError(string)
    | Timeout
    | InvalidRequest(string)
    | InvalidResponse(string)
    | IOError(string)
    | InternalError(string)

  /**
   * An abstract URL. Build one with `parse_url`; the representation is not
   * part of the public API.
   */
  type URL = URL({
    scheme : string,
    host : string,
    port : int32,
    path : string,
    query : Option<string>
  })

  /**
   * An ordered collection of HTTP header fields. Names are treated
   * case-insensitively; the original spelling is preserved. Duplicate names
   * are kept internally and `get_header` returns the first match.
   */
  type Headers = Headers(List<(string, string)>)

  /** A request in flight. Construction is pure; no IO happens here. */
  type Request = Request({
    method : Method,
    url : URL,
    headers : Headers,
    body : Bytes
  })

  /** A parsed response. The complete body is buffered in memory. */
  type Response = Response({
    version : Version,
    status : int32,
    headers : Headers,
    body : Bytes
  })

  /** The result of parsing a response head (status line + headers). */
  type ResponseHead = ResponseHead({
    version : Version,
    status : int32,
    headers : Headers
  })

  /**
   * A client is an opaque handle for issuing requests. It holds no socket
   * state; every request opens and closes its own connection. Construct one
   * with `create`.
   */
  type Client = Client

  // --------------------------------------------------------------------------
  // Small string/char/list helpers
  // --------------------------------------------------------------------------

  fun parse_parts(c : char, s : string) : List<string> =
    fold(String.to_list(s)) {
      | [] => [""]
      | x :: @xs =>
          if (x == c)
            then "" :: xs
            else prepend_to_first_line(x, xs)
    }

  fun prepend_to_first_line(c : char, lines : List<string>) : List<string> =
    match(lines) {
      | [] => [String.char_to_string(c)]
      | l :: ls => (String.char_to_string(c) +++ l) :: ls
    }

  fun contains_char(c : char, s : string) : bool =
    List.any(fn(x) => x == c, String.to_list(s))

  fun lowercase_char(c : char) : char =
    let
      o = Char.ord(c)
    in
      if (o >= Char.ord('A') && o <= Char.ord('Z'))
        then Char.chr(o + 32)
        else c

  fun lowercase(s : string) : string =
    String.from_list(List.map(lowercase_char, String.to_list(s)))

  // Count trailing spaces/tabs (SP and HTAB = HTTP optional whitespace).
  fun count_trailing_ows(chars : List<char>) : nat =
    fold(chars) {
      | [] => Zero
      | c :: @xs =>
          if (c == ' ' || c == '\t') then Succ(xs) else Zero
    }

  // Strip leading HTTP optional whitespace from a string.
  fun trim_ows(s : string) : string =
    String.from_list(
      List.drop(count_trailing_ows(List.reverse(String.to_list(s))),
                String.to_list(s)))

  fun strip_trailing_cr(s : string) : string =
    if (String.is_prefix_of("\r", String.reverse(s)))
      then String.reverse(String.drop(1, String.reverse(s)))
      else s

  fun digit_value(c : char) : Option<int32> =
    Char.digit_to_int32(c)

  // Parse a non-negative decimal integer. Returns None on any non-digit.
  fun parse_int32(s : string) : Option<int32> =
    if (String.is_empty(s))
      then None
      else
        match(digits_to_int(String.to_list(s))) {
          | (n, _) when (n >= 0) => Some(n)
          | _ => None
        }

  fun digits_to_int(chars : List<char>) : (int32, int32) =
    fold(chars) {
      | [] => (0, 1)
      | x :: @xs =>
          match(xs) {
            | (v, w) when (v == -1) => (-1, 0)
            | (v, w) =>
                match(digit_value(x)) {
                  | Some(d) => (d * w + v, w * 10)
                  | None => (-1, 0)
                }
          }
    }

  // --------------------------------------------------------------------------
  // Methods and versions
  // --------------------------------------------------------------------------

  fun method_to_string(m : Method) : string =
    match(m) {
      | GET => "GET"
      | POST => "POST"
      | PUT => "PUT"
      | PATCH => "PATCH"
      | DELETE => "DELETE"
      | HEAD => "HEAD"
      | OPTIONS => "OPTIONS"
    }

  fun parse_version_string(v : string) : Option<Version> =
    match(v) {
      | "HTTP/1.1" => Some(HTTP11)
      | "HTTP/1.0" => Some(HTTP10)
      | _ => None
    }

  fun version_to_string(v : Version) : string =
    match(v) {
      | HTTP11 => "HTTP/1.1"
      | HTTP10 => "HTTP/1.0"
    }

  // --------------------------------------------------------------------------
  // URL parsing (pure)
  // --------------------------------------------------------------------------

  fun has_scheme(s : string) : Option<string> =
    match(parse_parts(':', s)) {
      | first :: rest =>
          match(rest) {
            | second :: _ when (String.is_prefix_of("//", second)) => Some(first)
            | _ => None
          }
      | [] => None
    }

  // Split `s` at the first '?' into (before, query).
  fun split_first_question(s : string) : (string, Option<string>) =
    match(parse_parts('?', s)) {
      | first :: [] => (first, None)
      | first :: rest => (first, Some(String.intercalate("?", rest)))
      | [] => ("", None)
    }

  fun parse_http_url(rest : string) : Result<URL, Error> =
    let
      (pre, query) = split_first_question(rest)
    in
      match(parse_parts('/', pre)) {
        | [] => Err(InvalidURL(rest))
        | auth :: path_parts =>
            if (String.is_empty(auth) || contains_char('@', auth))
              then Err(InvalidURL(rest))
              else
                let
                  path =
                    "/" +++ String.intercalate("/", path_parts)
                                in
                  match(parse_parts(':', auth)) {
                    | host :: [] =>
                      Ok(URL({
                        scheme = "http",
                        host = host,
                        port = 80,
                        path = path,
                        query = query
                      }))
                    | host :: port_part :: [] =>
                      match(parse_int32(port_part)) {
                        | Some(p) when (p >= 1 && p <= 65535) =>
                          Ok(URL({
                            scheme = "http",
                            host = host,
                            port = p,
                            path = path,
                            query = query
                          }))
                        | _ => Err(InvalidURL(rest))
                      }
                    | _ => Err(InvalidURL(rest))
                  }
      }

  /**
   * Parse a URL string. Only `http://host/path...` URLs are supported;
   * `https://` is rejected explicitly because TLS is not available yet.
   */
  fun parse_url(s : string) : Result<URL, Error> =
    if (String.is_prefix_of("http://", s))
      then parse_http_url(String.drop(7, s))
      else if (String.is_prefix_of("https://", s))
        then Err(UnsupportedHTTPS)
        else
          match(has_scheme(s)) {
            | Some(scheme) => Err(UnsupportedScheme(scheme))
            | None => Err(InvalidURL(s))
          }

  /** Render a URL back to its string form. */
  fun url_to_string(u : URL) : string =
    match(u) {
      | URL({scheme = sc, host = h, port = p, path = pt, query = q}) =>
                    let
            port_part =
              if (p == 80) then "" else ":" +++ String.int32_to_string(p);
            query_part =
              match(q) {
                | Some(s) => "?" +++ s
                | None => ""
              }
          in
            sc +++ "://" +++ h +++ port_part +++ pt +++ query_part
    }

  // Internal URL accessors (not exported; the URL representation is hidden).

  fun url_host(u : URL) : string =
    match(u) {
      | URL({scheme = _, host = h, port = _, path = _, query = _}) => h
    }

  fun url_port(u : URL) : int32 =
    match(u) {
      | URL({scheme = _, host = _, port = p, path = _, query = _}) => p
    }

  fun url_path_query(u : URL) : string =
    match(u) {
      | URL({scheme = _, host = _, port = _, path = pt, query = q}) =>
          match(q) {
            | Some(s) => pt +++ "?" +++ s
            | None => pt
          }
    }

  fun url_host_header(u : URL) : string =
    match(u) {
      | URL({scheme = _, host = h, port = p, path = _, query = _}) =>
          if (p == 80)
            then h
            else h +++ ":" +++ String.int32_to_string(p)
    }

  // --------------------------------------------------------------------------
  // Headers (pure)
  // --------------------------------------------------------------------------

  fun hdr_name(e : (string, string)) : string =
    match(e) {
      | (n, _) => n
    }

  fun hdr_value(e : (string, string)) : string =
    match(e) {
      | (_, v) => v
    }

  fun header_line_str(e : (string, string)) : string =
    hdr_name(e) +++ ": " +++ hdr_value(e)

  fun header_names_equal(a : string, b : string) : bool =
    lowercase(a) == lowercase(b)

  /** An empty header collection. */
  fun empty_headers() : Headers =
    Headers([])

  /** Retrieve the first value stored under a header name. */
  fun get_header(name : string, hs : Headers) : Option<string> =
    match(hs) {
      | Headers(entries) =>
          match(List.find(fn(e) => header_names_equal(hdr_name(e), name),
                          entries)) {
            | Some(e) => Some(hdr_value(e))
            | None => None
          }
    }

  /** Return `true` when the header collection contains the given name. */
  fun has_header(name : string, hs : Headers) : bool =
    Option.is_some(get_header(name, hs))

  /**
   * Replace every occurrence of `name` with a single new entry. The new
   * entry is stored first; the remaining headers keep their order.
   */
  fun set_header(name : string, value : string, hs : Headers) : Headers =
    match(hs) {
      | Headers(entries) =>
          Headers(
            (name, value) ::
              List.filter(fn(e) => !header_names_equal(hdr_name(e), name),
                          entries))
    }

  /** Remove every occurrence of `name` from the collection. */
  fun remove_header(name : string, hs : Headers) : Headers =
    match(hs) {
      | Headers(entries) =>
          Headers(
            List.filter(fn(e) => !header_names_equal(hdr_name(e), name),
                        entries))
    }

  // --------------------------------------------------------------------------
  // Request construction (pure)
  // --------------------------------------------------------------------------

  /** Build a request. Pure: no network activity happens here. */
  fun request(method : Method, url : URL, headers : Headers, body : Bytes)
      : Request =
    Request({method = method, url = url, headers = headers, body = body})

  /** A GET request with an empty body and no headers. */
  fun get_request(url : URL) : Request =
    request(GET, url, empty_headers(), bytes_empty)

  /** A POST request with the given body and no headers. */
  fun post_request(url : URL, body : Bytes) : Request =
    request(POST, url, empty_headers(), body)

  /** A PUT request with the given body and no headers. */
  fun put_request(url : URL, body : Bytes) : Request =
    request(PUT, url, empty_headers(), body)

  /** A DELETE request with an empty body and no headers. */
  fun delete_request(url : URL) : Request =
    request(DELETE, url, empty_headers(), bytes_empty)

  // --------------------------------------------------------------------------
  // Serialization (pure)
  // --------------------------------------------------------------------------

  /**
   * Serialize the head of a request (request line + headers). The second
   * argument is the byte length of the body; it becomes `Content-Length`.
   * `Host`, `Connection: close` and `Content-Length` are generated when not
   * already present (a user-supplied `Host` is kept).
   */
  fun serialize_request_head(req : Request, body_length : int32) : string =
    match(req) {
      | Request({method = m, url = u, headers = hs, body = _}) =>
          let
            hs_host =
              if (has_header("Host", hs))
                then hs
                else set_header("Host", url_host_header(u), hs)
          in
          let
            hs_conn =
              set_header("Connection", "close",
                set_header("Content-Length",
                  String.int32_to_string(body_length), hs_host))
          in
          let
            request_line =
              method_to_string(m) +++ " " +++ url_path_query(u) +++
              " HTTP/1.1\r\n";
            header_section = serialize_headers(hs_conn)
          in
            request_line +++ header_section +++ "\r\n"
    }

  fun serialize_headers(hs : Headers) : string =
    match(hs) {
      | Headers(entries) =>
          if (List.is_empty(entries))
            then ""
            else
              String.intercalate("\r\n",
                                 List.map(header_line_str, entries)) +++ "\r\n"
    }

  // --------------------------------------------------------------------------
  // Response parsing (pure)
  // --------------------------------------------------------------------------

  fun parse_status_line(line : string)
      : Result<{version : Version, status : int32}, Error> =
    match(List.filter(fn(s) => !String.is_empty(s), parse_parts(' ', line))) {
      | [] => Err(InvalidResponse("malformed status line"))
      | v :: rest =>
          match(rest) {
            | [] => Err(InvalidResponse("malformed status line"))
            | code :: _ =>
                match(parse_version_string(v)) {
                  | None => Err(InvalidResponse("unsupported HTTP version"))
                  | Some(ver) =>
                      match(parse_int32(code)) {
                        | Some(n) when (n >= 100 && n <= 599) =>
                            Ok({version = ver, status = n})
                        | _ => Err(InvalidResponse("invalid status code"))
                      }
          }
        }
  }

  fun parse_one_header(line : string) : Result<(string, string), Error> =
    match(parse_parts(':', line)) {
      | [] => Err(InvalidResponse("malformed header line"))
      | name :: [] => Err(InvalidResponse("malformed header line"))
      | name :: rest =>
          if (String.is_empty(name))
            then Err(InvalidResponse("malformed header line"))
            else Ok((name, trim_ows(String.intercalate(":", rest))))
    }

  // Parse header lines until the first empty line (the blank line that ends
  // the head). Everything after that blank line is ignored.
  fun parse_header_lines(lines : List<string>) : Result<Headers, Error> =
    fold(lines) {
      | [] => Ok(empty_headers())
      | line :: @rest =>
          if (String.is_empty(line))
            then Ok(empty_headers())
            else
              match(parse_one_header(line)) {
                | Err(e) => Err(e)
                | Ok(entry) =>
                    match(rest) {
                      | Err(e) => Err(e)
                      | Ok(hs) =>
                          Ok(set_header(hdr_name(entry), hdr_value(entry), hs))
                    }
              }
    }

  /**
   * Parse a response head: the status line plus header fields, terminated by
   * a blank line. The body is framed by the transport and is not part of the
   * head.
   */
  fun parse_response_head(head : string) : Result<ResponseHead, Error> =
    match(List.map(strip_trailing_cr, parse_parts('\n', head))) {
      | [] => Err(InvalidResponse("empty response"))
      | status_line :: rest =>
          match(parse_status_line(status_line)) {
            | Err(e) => Err(e)
            | Ok(sl) =>
                match(sl) {
                  | {version = v, status = st} =>
                      match(parse_header_lines(rest)) {
                        | Err(e) => Err(e)
                        | Ok(hs) =>
                            Ok(ResponseHead({
                              version = v,
                              status = st,
                                                          headers = hs
                            }))
                      }
                }
          }
    }

  // --------------------------------------------------------------------------
  // Byte buffers (the only IO-facing data operations)
  // --------------------------------------------------------------------------

  /** The empty byte buffer. */
  let bytes_empty : Bytes =
    #{coal_http_bytes_empty : unit -> Bytes}(())(fn(b) => b)

  /** Copy a string into a byte buffer. */
  fun bytes_from_string(s : string) : IO<Bytes> =
    #{coal_http_bytes_from_string : string -> Bytes}(s)(
      fn(b) => __return_io(b))

  /**
   * Interpret a byte buffer as UTF-8 text. Binary data that is not valid
   * UTF-8 (or contains NUL bytes) may not survive this round trip.
   */
  fun bytes_to_string(b : Bytes) : IO<string> =
    #{coal_http_bytes_to_string : Bytes -> string}(b)(
      fn(s) => __return_io(s))

  /** The length of a byte buffer, in bytes. */
  fun bytes_length(b : Bytes) : IO<int32> =
    #{coal_http_bytes_length : Bytes -> int32}(b)(fn(n) => __return_io(n))

  // --------------------------------------------------------------------------
  // Client and transport (IO)
  // --------------------------------------------------------------------------

  /** Create a client handle. No sockets are opened. */
  fun create() : IO<Client> =
    __return_io(Client)

  // Map a transport failure code from the C layer onto the Error type.
  fun transport_error(code : int32, message : string) : Error =
    match(code) {
      | 1 => ConnectionError(message)
      | 2 => Timeout
      | 3 => IOError(message)
      | 4 => InvalidResponse(message)
      | _ => InternalError(message)
    }

  // Turn the transport result into a Response. A 404 is still a successful
  // HTTP exchange; only transport/protocol failures produce Err.
  fun assemble_response(
      r : {code : int32, status : int32, head : string, body : Bytes,
           error : string}) : Result<Response, Error> =
    match(r) {
      | {code = c, status = _, head = hd, body = bd, error = er} =>
          if (c == 0)
            then
              match(parse_response_head(hd)) {
                | Err(e) => Err(e)
                | Ok(h) =>
                    match(h) {
                                          | ResponseHead({version = v, status = st, headers = hs}) =>
                        Ok(Response({
                            version = v,
                            status = st,
                            headers = hs,
                            body = bd
                          }))
                    }
              }
            else Err(transport_error(c, er))
    }

  /**
   * Send a request and wait for the response. This is the central operation
   * of the library and the only one that touches the network: it serializes
   * the request, opens a connection, reads the response, and closes the
   * connection.
   */
  fun send(_ : Client, req : Request) : IO<Result<Response, Error>> =
    match(req) {
      | Request({method = _, url = u, headers = _, body = b}) =>
          let
            host = url_host(u)
          in
          let
            port = url_port(u)
          in
          let
            forward(body_length) =
              let
                head = serialize_request_head(req, body_length)
              in
                do {
                  r <- #{coal_http_execute : string -> int32 -> string -> Bytes -> {code : int32, status : int32, head : string, body : Bytes, error : string}}(host, port, head, b)(fn(res) => __return_io(res));
                  __return_io(assemble_response(r));
                }
          in
          do {
            len <- bytes_length(b);
            forward(len);
          }
    }

  // --------------------------------------------------------------------------
  // Convenience wrappers (construct data, then perform IO)
  // --------------------------------------------------------------------------

  /** `GET url` with no headers and an empty body. */
  fun get(client : Client, url : URL) : IO<Result<Response, Error>> =
    send(client, get_request(url))

  /** `POST url body` with no headers. */
  fun post(client : Client, url : URL, body : Bytes)
      : IO<Result<Response, Error>> =
    send(client, post_request(url, body))

  /** `PUT url body` with no headers. */
  fun put(client : Client, url : URL, body : Bytes)
      : IO<Result<Response, Error>> =
    send(client, put_request(url, body))

  /** `DELETE url` with no headers and an empty body. */
  fun delete(client : Client, url : URL) : IO<Result<Response, Error>> =
    send(client, delete_request(url))

  // --------------------------------------------------------------------------
  // Response accessors and status helpers (pure)
  // --------------------------------------------------------------------------

  fun response_version(r : Response) : Version =
    match(r) {
      | Response({version = v, status = _, headers = _, body = _}) => v
    }

  fun response_status(r : Response) : int32 =
    match(r) {
      | Response({version = _, status = s, headers = _, body = _}) => s
    }

  fun response_headers(r : Response) : Headers =
    match(r) {
      | Response({version = _, status = _, headers = hs, body = _}) => hs
    }

  fun response_body(r : Response) : Bytes =
    match(r) {
      | Response({version = _, status = _, headers = _, body = b}) => b
    }

  /** `true` for 2xx responses. */
  fun is_success(r : Response) : bool =
    let s = response_status(r) in s >= 200 && s < 300

  /** `true` for 3xx responses. Redirects are not followed automatically. */
  fun is_redirect(r : Response) : bool =
    let s = response_status(r) in s >= 300 && s < 400

  /** `true` for 4xx responses. */
  fun is_client_error(r : Response) : bool =
    let s = response_status(r) in s >= 400 && s < 500

  /** `true` for 5xx responses. */
  fun is_server_error(r : Response) : bool =
    let s = response_status(r) in s >= 500 && s < 600

  // --------------------------------------------------------------------------
  // Error rendering
  // --------------------------------------------------------------------------

  /** A human-readable description of an error. */
  fun error_to_string(e : Error) : string =
    match(e) {
      | InvalidURL(s) => "invalid URL: " +++ s
      | UnsupportedScheme(s) => "unsupported URL scheme: " +++ s
      | UnsupportedHTTPS => "HTTPS is not supported yet (no TLS in the runtime)"
      | ConnectionError(s) => "connection error: " +++ s
      | Timeout => "the operation timed out"
      | InvalidRequest(s) => "invalid request: " +++ s
      | InvalidResponse(s) => "invalid response: " +++ s
      | IOError(s) => "I/O error: " +++ s
      | InternalError(s) => "internal error: " +++ s
    }

}
